@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="chat-widget">
    <div class="chat-header">
        <div class="header-info">
            <div class="avatar-circle">
                @if (selectedProvider == "groq")
                {
                    <i class="fas fa-bolt"></i>
                }
                else
                {
                    <i class="fas fa-robot"></i>
                }
            </div>
            <div class="header-text">
                <h3>AI Assistant</h3>
                <div class="model-selector">
                    <select @bind="selectedProvider" class="provider-select">
                        <option value="gemini">Gemini</option>
                        <option value="groq">Groq</option>
                    </select>
                    <span class="divider">/</span>
                    <select @bind="selectedModel" class="model-select">
                        @if (selectedProvider == "gemini")
                        {
                            <option value="gemini-3-flash">Gemini 3 Flash</option>
                        }
                        else
                        {
                            <option value="llama3-70b-8192">Llama 3 70B</option>
                            <option value="mixtral-8x7b-32768">Mixtral 8x7B</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="chat-body" id="chat-body">
        @foreach (var message in history)
        {
            <div class="message-wrapper @(message.Role == "user" ? "user" : "ai")">
                @if (message.Role != "user")
                {
                    <div class="message-avatar">
                        @if (selectedProvider == "groq")
                        {
                            <i class="fas fa-bolt"></i>
                        }
                        else
                        {
                            <i class="fas fa-robot"></i>
                        }
                    </div>
                }
                <div class="message-content">
                    @if (message.Role == "user")
                    {
                        @message.Content
                    }
                    else
                    {
                        @((MarkupString)Markdig.Markdown.ToHtml(message.Content))
                    }
                </div>
            </div>
        }

        @if (isTyping)
        {
            <div class="message-wrapper ai">
                <div class="message-avatar">
                    @if (selectedProvider == "groq")
                    {
                        <i class="fas fa-bolt"></i>
                    }
                    else
                    {
                        <i class="fas fa-robot"></i>
                    }
                </div>
                <div class="message-content typing">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
            </div>
        }
    </div>

    <div class="chat-footer">
        @if (history.Count < 2)
        {
            <div class="suggestion-chips">
                <button @onclick='() => SendSuggestion("What are your skills?")'>What are your skills?</button>
                <button @onclick='() => SendSuggestion("Show me Python projects")'>Show me Python projects</button>
                <button @onclick='() => SendSuggestion("How can I contact Muhammad?")'>Contact info</button>
            </div>
        }
        
        <div class="input-area">
            <input @ref="inputElement" 
                   type="text" 
                   placeholder="Ask me anything about the portfolio..." 
                   @bind="currentInput" 
                   @bind:event="oninput" 
                   @onkeydown="HandleKeyDown" />
            <button class="send-btn" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(currentInput) || isTyping)">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

<style>
    /* Modern Chat Widget Styles */
    .chat-widget {
        display: flex;
        flex-direction: column;
        height: 600px;
        max-height: 80vh;
        width: 100%;
        max-width: 100%;
        background: rgba(30, 41, 59, 0.7); /* Slate-800 with opacity */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Header */
    .chat-header {
        padding: 1rem;
        background: rgba(15, 23, 42, 0.8); /* Slate-900 */
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #06b6d4, #3b82f6); /* Cyan to Blue */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .header-text h3 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        font-weight: 600;
        color: #f8fafc;
    }

    /* Model Selector Styles */
    .model-selector {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .provider-select, .model-select {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 0.75rem;
        cursor: pointer;
        outline: none;
        padding: 0;
        font-family: inherit;
    }

    .provider-select:hover, .model-select:hover {
        color: #cbd5e1;
    }

    .provider-select option, .model-select option {
        background: #1e293b;
        color: #f8fafc;
    }

    .divider {
        color: #64748b;
    }

    /* Body */
    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        scroll-behavior: smooth;
    }

    .message-wrapper {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        max-width: 85%;
        animation: fadeIn 0.3s ease;
    }

    .message-wrapper.user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #06b6d4;
        flex-shrink: 0;
        font-size: 0.9rem;
    }

    .message-content {
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 0.95rem;
        line-height: 1.5;
        color: #e2e8f0;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .message-wrapper.user .message-content {
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        color: white;
        border: none;
        box-shadow: 0 2px 10px rgba(6, 182, 212, 0.2);
    }

    /* Markdown Styles in Chat */
    ::deep .message-content p { margin-bottom: 0.5em; }
    ::deep .message-content p:last-child { margin-bottom: 0; }
    ::deep .message-content ul { padding-left: 1.2rem; margin-bottom: 0.5rem; }
    ::deep .message-content a { color: #38bdf8; text-decoration: underline; }
    ::deep .message-content code { 
        background: rgba(0, 0, 0, 0.3); 
        padding: 2px 6px; 
        border-radius: 4px; 
        font-family: 'Fira Code', monospace;
        font-size: 0.85em;
    }

    /* Typing Indicator */
    .message-content.typing {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 12px 16px;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        background: #94a3b8;
        border-radius: 50%;
        animation: typingBounce 1.4s infinite ease-in-out both;
    }

    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }

    /* Footer */
    .chat-footer {
        padding: 1rem;
        background: rgba(15, 23, 42, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .suggestion-chips {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 12px;
        scrollbar-width: none; /* Hide scrollbar */
    }

    .suggestion-chips button {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .suggestion-chips button:hover {
        background: rgba(6, 182, 212, 0.1);
        border-color: #06b6d4;
        color: #06b6d4;
    }

    .input-area {
        display: flex;
        gap: 8px;
        background: rgba(0, 0, 0, 0.2);
        padding: 6px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .input-area:focus-within {
        border-color: #06b6d4;
        box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
    }

    input {
        flex: 1;
        background: transparent;
        border: none;
        padding: 8px 16px;
        color: white;
        font-size: 0.95rem;
        outline: none;
    }

    input::placeholder {
        color: #64748b;
    }

    .send-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .send-btn:hover:not(:disabled) {
        transform: scale(1.05);
    }

    .send-btn:disabled {
        background: #334155;
        cursor: not-allowed;
        opacity: 0.7;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes typingBounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }
</style>

@code {
    private ElementReference inputElement;
    private string currentInput = "";
    private bool isTyping = false;
    private List<MessageItem> history = new();
    
    // Model Selection State
    private string selectedProvider = "gemini";
    private string selectedModel = "gemini-3-flash";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Modern Welcome Message
            history.Add(new MessageItem { Role = "model", Content = "Hi there! 👋 I'm **Mkkai's AI Assistant**. \n\nI can help you explore his projects, technical skills, or experience. What would you like to know?" });
            StateHasChanged();
        }
        await ScrollToBottom();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("messageUtils.scrollToBottom", "chat-body");
        }
        catch { /* Ignore JS errors */ }
    }

    private async Task SendSuggestion(string text)
    {
        currentInput = text;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || isTyping) return;

        var userMsg = currentInput;
        currentInput = "";
        
        history.Add(new MessageItem { Role = "user", Content = userMsg });
        isTyping = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var chatHistory = history
                .Where(x => x.Role != "error")
                .Select(x => new { role = x.Role, content = x.Content })
                .ToList();

            var payload = new 
            { 
                message = userMsg, 
                history = chatHistory,
                provider = selectedProvider,
                model = selectedModel
            };

            var response = await Http.PostAsJsonAsync("api/chat", payload);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatResponseModel>();
                history.Add(new MessageItem { Role = "model", Content = result?.Response ?? "I didn't get a response." });
            }
            else
            {
                history.Add(new MessageItem { Role = "model", Content = "😔 I'm having trouble connecting to the server. Please try again later." });
            }
        }
        catch (Exception ex)
        {
            history.Add(new MessageItem { Role = "model", Content = "⚠️ Connection error. Is the backend running?" });
            Console.WriteLine(ex);
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
            await ScrollToBottom();
            await inputElement.FocusAsync();
        }
    }

    public class MessageItem
    {
        public string Role { get; set; } = "user";
        public string Content { get; set; } = "";
    }

    public class ChatResponseModel
    {
        public string Response { get; set; } = "";
    }
}
