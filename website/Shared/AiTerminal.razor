@using System.Text.Json
@using Markdig
@inject HttpClient Http
@inject IJSRuntime JS

<div class="chat-widget">
    <div class="chat-header">
        <div class="header-info">
            <div class="avatar-circle">
                @if (selectedProvider == "groq")
                {
                    <i class="fas fa-bolt"></i>
                }
                else
                {
                    <i class="fas fa-robot"></i>
                }
            </div>
            <div class="header-text">
                <h3>AI Assistant</h3>
                <div class="model-selector">
                    <select @onchange="OnProviderChanged" class="provider-select">
                        <option value="gemini" selected="@(selectedProvider == "gemini")">Gemini</option>
                        <option value="groq" selected="@(selectedProvider == "groq")">Groq</option>
                        <option value="ollama" selected="@(selectedProvider == "ollama")">Ollama (Local)</option>
                    </select>
                    <span class="divider">/</span>
                    <select @bind="selectedModel" class="model-select">
                        @if (selectedProvider == "gemini")
                        {
                            <option value="gemini-3-flash">Gemini 3 Flash</option>
                        }
                        else if (selectedProvider == "ollama")
                        {
                            if (isLoadingModels)
                            {
                                <option>Loading models...</option>
                            }
                            else if (ollamaModels.Any())
                            {
                                foreach (var model in ollamaModels)
                                {
                                    <option value="@model">@model</option>
                                }
                            }
                            else
                            {
                                <option disabled>No models found</option>
                            }
                        }
                        else
                        {
                            <option value="llama-3.3-70b-versatile">Llama 3.3 70B</option>
                            <option value="llama-3.1-8b-instant">Llama 3.1 8B</option>
                            <option value="meta-llama/llama-4-scout-17b-16e-instruct">Llama 4 Scout 17B</option>
                            <option value="meta-llama/llama-4-maverick-17b-128e-instruct">Llama 4 Maverick 17B</option>
                            <option value="qwen/qwen3-32b">Qwen 3 32B</option>
                            <option value="openai/gpt-oss-120b">GPT-OSS 120B</option>
                            <option value="openai/gpt-oss-20b">GPT-OSS 20B</option>
                            <option value="moonshotai/kimi-k2-instruct">Kimi K2 Instruct</option>
                            <option value="groq/compound">Groq Compound</option>
                            <option value="allam-2-7b">Allam 2 7B</option>
                        }
                    </select>
                </div>
            </div>
            <button class="info-btn" @onclick="StartNewChat" title="Start New Chat" style="margin-left: auto; margin-right: 8px;">
                <i class="fas fa-plus"></i>
            </button>
            <button class="info-btn" @onclick="ToggleInfo" title="About this assistant">
                <i class="fas fa-info-circle"></i>
            </button>
        </div>
    </div>

    <div class="chat-body" id="chat-body">
        @if (showInfo)
        {
            <div class="info-panel">
                <h4>About this Assistant</h4>
                <p>This AI is powered by advanced LLMs (Gemini, Llama, Qwen) to help you explore my portfolio.</p>
                
                <h5>Capabilities:</h5>
                <ul>
                    <li>Search projects by skill or detailed query (RAG).</li>
                    <li>Answer questions about my experience & skills.</li>
                    <li>Connect you to local models running on my home PC (Ollama).</li>
                </ul>

                <h5>Limitations:</h5>
                <ul>
                    <li><strong>Context Limit:</strong> Standard token limits apply.</li>
                    <li><strong>Accuracy:</strong> May occasionally hallucinate details. Verify important info.</li>
                    <li><strong>Rate Limits:</strong> Public API tiers are used for cloud models.</li>
                </ul>
                
                <button class="close-info-btn" @onclick="ToggleInfo">Got it</button>
            </div>
        }
        else if (isWaitingForApproval)
        {
            <div class="access-success">
                <div class="loading-spinner"></div>
                <h3>Waiting for Approval...</h3>
                <p>Muhammad has been notified. Please wait while he reviews your request.</p>
                <p class="status-note"><i class="fas fa-sync fa-spin"></i> Checking status...</p>
                <button class="back-btn" @onclick='() => { selectedProvider = "gemini"; isWaitingForApproval = false; statusTimer?.Dispose(); StateHasChanged(); }'>
                    Cancel & Return to Gemini
                </button>
            </div>
        }
        else if (accessRequestSent)
        {
            <div class="access-success">
                <div class="success-icon"><i class="fas fa-check-circle"></i></div>
                <h3>Request Sent!</h3>
                <p>Muhammad has been notified via Discord. He will review your request to access the local Ollama service.</p>
                <button class="back-btn" @onclick='() => { selectedProvider = "gemini"; accessRequestSent = false; StateHasChanged(); }'>
                    Back to Gemini
                </button>
            </div>
        }
        else if (showAccessForm)
        {
            <div class="access-form">
                <h3><i class="fas fa-server"></i> Request Ollama Access</h3>
                <p class="form-desc">This service runs locally on Muhammad's PC. Please request access to use it.</p>
                
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="accessRequest.Name" placeholder="Your Name" />
                </div>
                
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="accessRequest.Email" placeholder="your@email.com" />
                </div>

                <div class="form-group">
                    <label>Reason (Optional)</label>
                    <textarea @bind="accessRequest.Reason" placeholder="Why do you need local access?"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i> @errorMessage
                    </div>
                }

                <button class="submit-btn" @disabled="isSendingRequest" @onclick="SubmitAccessRequest">
                    @if (isSendingRequest)
                    {
                        <span><i class="fas fa-spinner fa-spin"></i> Sending...</span>
                    }
                    else
                    {
                        <span><i class="fas fa-paper-plane"></i> Request Access</span>
                    }
                </button>
            </div>
        }
        else
        {
            @foreach (var message in history)
            {
                <div class="message-wrapper @(message.Role == "user" ? "user" : "ai")">
                @if (message.Role != "user")
                {
                    <div class="message-avatar">
                        @if (selectedProvider == "groq")
                        {
                            <i class="fas fa-bolt"></i>
                        }
                        else
                        {
                            <i class="fas fa-robot"></i>
                        }
                    </div>
                }
                <div class="message-content">
                    @if (message.Role == "user")
                    {
                        @message.Content
                    }
                    else
                    {
                        @((MarkupString)Markdig.Markdown.ToHtml(message.Content, pipeline))
                    }
                </div>
            </div>
        }

        @if (isTyping)
        {
            <div class="message-wrapper ai">
                <div class="message-avatar">
                    @if (selectedProvider == "groq")
                    {
                        <i class="fas fa-bolt"></i>
                    }
                    else
                    {
                        <i class="fas fa-robot"></i>
                    }
                </div>
                <div class="message-content typing">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
            </div>
        }
    }
    </div>

    <div class="chat-footer">
        @if (history.Count < 2)
        {
            <div class="suggestion-chips">
                <button @onclick='() => SendSuggestion("What are your skills?")'>What are your skills?</button>
                <button @onclick='() => SendSuggestion("Show me Python projects")'>Show me Python projects</button>
                <button @onclick='() => SendSuggestion("How can I contact Muhammad?")'>Contact info</button>
            </div>
        }
        
        <div class="input-area @(selectedProvider == "ollama" && !hasAccess ? "disabled" : "")">
            <input @ref="inputElement" 
                   type="text" 
                   placeholder="@(selectedProvider == "ollama" && !hasAccess ? "Request access to use Ollama..." : "Ask me anything about the portfolio...")" 
                   @bind="currentInput" 
                   @bind:event="oninput" 
                   @onkeydown="HandleKeyDown"
                   disabled="@(selectedProvider == "ollama" && !hasAccess)" />
            <button class="send-btn" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(currentInput) || isTyping || (selectedProvider == "ollama" && !hasAccess))">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>

<style>
    /* Modern Chat Widget Styles */
    .chat-widget {
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: 100%;
        width: 100%;
        max-width: 100%;
        background: transparent; /* Background handled by panel */
        border: none;
        border-radius: 0;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Header */
    .chat-header {
        padding: 1rem;
        background: rgba(15, 23, 42, 0.8); /* Slate-900 */
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #06b6d4, #3b82f6); /* Cyan to Blue */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .header-text h3 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        font-weight: 600;
        color: #f8fafc;
    }

    /* Model Selector Styles */
    .model-selector {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .provider-select, .model-select {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 0.75rem;
        cursor: pointer;
        outline: none;
        padding: 0;
        font-family: inherit;
    }

    .provider-select:hover, .model-select:hover {
        color: #cbd5e1;
    }

    .provider-select option, .model-select option {
        background: #1e293b;
        color: #f8fafc;
    }

    .divider {
        color: #64748b;
    }

    /* Body */
    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        scroll-behavior: smooth;
    }

    .message-wrapper {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        max-width: 85%;
        animation: fadeIn 0.3s ease;
    }

    .message-wrapper.user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #06b6d4;
        flex-shrink: 0;
        font-size: 0.9rem;
    }

    .message-content {
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 0.95rem;
        line-height: 1.5;
        color: #e2e8f0;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .message-wrapper.user .message-content {
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        color: white;
        border: none;
        box-shadow: 0 2px 10px rgba(6, 182, 212, 0.2);
    }

    /* Markdown Styles in Chat */
    ::deep .message-content p { margin-bottom: 0.8em; }
    ::deep .message-content p:last-child { margin-bottom: 0; }
    ::deep .message-content ul, ::deep .message-content ol { padding-left: 1.5rem; margin-bottom: 1rem; }
    ::deep .message-content li { margin-bottom: 0.4rem; }
    ::deep .message-content a { color: #38bdf8; text-decoration: underline; font-weight: 500; }
    
    /* Tables */
    ::deep .message-content table { 
        width: 100%; 
        border-collapse: collapse; 
        margin: 1rem 0; 
        font-size: 0.85rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        overflow: hidden;
    }
    ::deep .message-content th, ::deep .message-content td { 
        padding: 10px 12px; 
        text-align: left; 
        border: 1px solid rgba(255, 255, 255, 0.1); 
    }
    ::deep .message-content th { 
        background: rgba(6, 182, 212, 0.2); 
        color: #38bdf8; 
        font-weight: 600; 
    }
    ::deep .message-content tr:nth-child(even) { background: rgba(255, 255, 255, 0.05); }

    /* Code Blocks */
    ::deep .message-content pre {
        background: #0d1117;
        padding: 1rem;
        border-radius: 8px;
        margin: 1rem 0;
        overflow-x: auto;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    ::deep .message-content code { 
        font-family: 'Fira Code', 'Roboto Mono', monospace;
        font-size: 0.85em;
        background: rgba(0, 0, 0, 0.3);
        padding: 2px 4px;
        border-radius: 4px;
        color: #e2e8f0;
    }
    ::deep .message-content pre code { 
        background: transparent; 
        padding: 0; 
        display: block; 
    }

    /* Blockquotes */
    ::deep .message-content blockquote {
        border-left: 4px solid #3b82f6;
        padding-left: 1rem;
        margin: 1rem 0;
        color: #94a3b8;
        font-style: italic;
    }

    /* Math (KaTeX) */
    ::deep .katex-display { margin: 1rem 0; overflow-x: auto; overflow-y: hidden; }

    /* Typing Indicator */
    .message-content.typing {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 12px 16px;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        background: #94a3b8;
        border-radius: 50%;
        animation: typingBounce 1.4s infinite ease-in-out both;
    }

    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }

    /* Footer */
    .chat-footer {
        padding: 1.5rem;
        padding-bottom: 2rem;
        background: rgba(15, 23, 42, 0.6);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
    }

    .suggestion-chips {
        display: flex;
        flex-wrap: wrap; /* Allow wrapping to prevent cutoff */
        gap: 8px;
        padding-bottom: 12px;
    }

    .suggestion-chips button {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .suggestion-chips button:hover {
        background: rgba(6, 182, 212, 0.1);
        border-color: #06b6d4;
        color: #06b6d4;
    }

    .input-area {
        display: flex;
        gap: 8px;
        background: rgba(0, 0, 0, 0.2);
        padding: 8px; /* Detailed padding */
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        align-items: center;
    }

    .input-area:focus-within {
        border-color: #06b6d4;
        box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
    }

    .input-area.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: rgba(0, 0, 0, 0.4);
    }
    
    .input-area.disabled input {
        cursor: not-allowed;
    }

    input {
        flex: 1;
        background: transparent;
        border: none;
        padding: 8px 16px;
        color: white;
        font-size: 0.95rem;
        outline: none;
    }

    input::placeholder {
        color: #64748b;
    }

    .send-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #06b6d4, #2563eb);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .send-btn:hover:not(:disabled) {
        transform: scale(1.05);
    }

    .send-btn:disabled {
        background: #334155;
        cursor: not-allowed;
        opacity: 0.7;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes typingBounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    /* Loading Spinner */
    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        border-top: 4px solid #06b6d4;
        animation: spin 1s linear infinite;
        margin-bottom: 1.5rem;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .status-note {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: center;
    }

    /* Access Form Styles */
    .access-form, .access-success {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #f8fafc;
        padding: 2rem;
        text-align: center;
        animation: fadeIn 0.4s ease;
    }

    .access-form h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: #38bdf8; display: flex; align-items: center; gap: 8px; }
    .form-desc { color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.5rem; }

    .form-group { width: 100%; max-width: 100%; margin-bottom: 1.5rem; text-align: left; }
    .form-group label { display: block; font-size: 0.9rem; color: #cbd5e1; margin-bottom: 8px; font-weight: 500; }
    .form-group input, .form-group textarea {
        width: 100%;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 12px;
        font-size: 1rem;
        color: white;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
    }
    .form-group textarea { height: 80px; resize: none; }
    .form-group input:focus, .form-group textarea:focus { border-color: #38bdf8; }

    .submit-btn, .back-btn {
        background: linear-gradient(135deg, #06b6d4, #3b82f6);
        border: none;
        color: white;
        padding: 10px 24px;
        border-radius: 20px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, opacity 0.2s;
        margin-top: 0.5rem;
    }
    .submit-btn:hover, .back-btn:hover { transform: scale(1.05); }
    .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; }

    /* Success State */
    .success-icon { font-size: 3rem; color: #22c55e; margin-bottom: 1rem; }
    .access-success h3 { font-size: 1.5rem; color: #f8fafc; margin: 0 0 0.5rem 0; }
    .access-success p { color: #94a3b8; max-width: 300px; margin-bottom: 1.5rem; line-height: 1.5; }
    .back-btn { background: #334155; }
    .back-btn:hover { background: #475569; }

    .error-message {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        max-width: 320px;
    }
    }

    /* Info Panel Styles */
    .info-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        transition: color 0.2s;
        margin-left: auto;
    }
    .info-btn:hover { color: #38bdf8; }

    .info-panel {
        background: rgba(30, 41, 59, 0.95);
        padding: 1.5rem;
        border-radius: 12px;
        color: #e2e8f0;
        animation: fadeIn 0.3s ease;
        position: absolute;
        top: 60px;
        left: 20px;
        right: 20px;
        z-index: 10;
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
    }
    .info-panel h4 { color: #38bdf8; margin-bottom: 1rem; font-size: 1.1rem; }
    .info-panel h5 { color: #f8fafc; margin: 1rem 0 0.5rem 0; font-size: 0.95rem; }
    .info-panel ul { padding-left: 1.2rem; margin-bottom: 1rem; font-size: 0.9rem; color: #cbd5e1; }
    .info-panel li { margin-bottom: 4px; }
    .close-info-btn {
        background: #334155;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        width: 100%;
        margin-top: 1rem;
        transition: background 0.2s;
    }
    .close-info-btn:hover { background: #475569; }
</style>

@code {
    private bool showInfo = false;
    private void ToggleInfo() => showInfo = !showInfo;

    private ElementReference inputElement;
    private string currentInput = "";
    private bool isTyping = false;
    private List<MessageItem> history = new();
    
    private static Markdig.MarkdownPipeline pipeline = new Markdig.MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    
    // Model Selection State
    private string selectedProvider = "gemini";
    private string selectedModel = "gemini-3-flash";
    private List<string> ollamaModels = new();
    private bool isLoadingModels = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Try to restore session and history
            try 
            {
                var savedProvider = await JS.InvokeAsync<string>("localStorage.getItem", "aiProvider");
                if (!string.IsNullOrEmpty(savedProvider)) selectedProvider = savedProvider;

                var savedModel = await JS.InvokeAsync<string>("localStorage.getItem", "aiModel");
                if (!string.IsNullOrEmpty(savedModel)) selectedModel = savedModel;

                var savedHistory = await JS.InvokeAsync<string>("localStorage.getItem", "aiChatHistory");
                if (!string.IsNullOrEmpty(savedHistory))
                {
                    history = JsonSerializer.Deserialize<List<MessageItem>>(savedHistory) ?? new();
                }

                var savedId = await JS.InvokeAsync<string>("localStorage.getItem", "ollamaAccessRequestId");
                if (!string.IsNullOrEmpty(savedId))
                {
                    currentRequestId = savedId;
                    await CheckStatus(true);
                }
            }
            catch (Exception ex) { Console.WriteLine("localStorage error: " + ex.Message); }

            // Modern Welcome Message
            if (!history.Any())
            {
                history.Add(new MessageItem { Role = "model", Content = "Hi there! 👋 I'm **MKKAI's AI Assistant**. \n\nI can help you explore his projects, technical skills, or experience. What would you like to know?" });
                await SaveStateAsync();
            }
            StateHasChanged();
        }
        await ScrollToBottom();
        await JS.InvokeVoidAsync("messageUtils.highlightAll");
        await JS.InvokeVoidAsync("messageUtils.renderMath", "chat-body");
    }

    private async Task SaveStateAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "aiChatHistory", JsonSerializer.Serialize(history));
            await JS.InvokeVoidAsync("localStorage.setItem", "aiProvider", selectedProvider);
            await JS.InvokeVoidAsync("localStorage.setItem", "aiModel", selectedModel);
        }
        catch (Exception ex) { Console.WriteLine("Save state error: " + ex.Message); }
    }

    private async Task StartNewChat()
    {
        history.Clear();
        history.Add(new MessageItem { Role = "model", Content = "New chat started! How can I help you explore Muhammad's portfolio today?" });
        await SaveStateAsync();
        StateHasChanged();
    }

    // Access Request State
    private bool showAccessForm = false;
    private bool accessRequestSent = false;
    private bool isWaitingForApproval = false;
    private bool hasAccess = false; // Persistent flag for the session
    private string? currentRequestId = null;
    private AccessRequestModel accessRequest = new();
    private bool isSendingRequest = false;
    private string? errorMessage = null;
    private System.Threading.Timer? statusTimer;

    private class AccessRequestModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Reason { get; set; } = "";
    }

    private async Task OnProviderChanged(ChangeEventArgs e)
    {
        selectedProvider = e.Value?.ToString() ?? "gemini";
        errorMessage = null;
        
        if (selectedProvider == "ollama")
        {
            if (hasAccess)
            {
                showAccessForm = false;
                accessRequestSent = false;
                isWaitingForApproval = false;
            }
            else if (isWaitingForApproval)
            {
                showAccessForm = false;
                accessRequestSent = true;
                // isWaitingForApproval remains true
            }
            else
            {
                showAccessForm = true;
                accessRequestSent = false;
                isWaitingForApproval = false;
            }
            
            // Fetch models dynamically
            isLoadingModels = true;
            StateHasChanged();
            try 
            {
                var response = await Http.GetFromJsonAsync<JsonElement>("api/chat/models?provider=ollama");
                if (response.TryGetProperty("models", out var modelsElement) && modelsElement.ValueKind == JsonValueKind.Array)
                {
                    ollamaModels = modelsElement.EnumerateArray()
                        .Select(m => m.GetString())
                        .Where(s => !string.IsNullOrEmpty(s))
                        .ToList()!;
                        
                    if (ollamaModels.Any())
                    {
                        selectedModel = ollamaModels.First();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load models: {ex.Message}");
            }
            finally
            {
                isLoadingModels = false;
                StateHasChanged();
            }
        }
        else if (selectedProvider == "groq")
        {
            showAccessForm = false;
            selectedModel = "llama-3.3-70b-versatile";
        }
        else
        {
            showAccessForm = false;
            selectedModel = "gemini-3-flash";
        }
        await SaveStateAsync();
        StateHasChanged();
    }

    private async Task SubmitAccessRequest()
    {
        if (string.IsNullOrWhiteSpace(accessRequest.Name) || string.IsNullOrWhiteSpace(accessRequest.Email)) return;

        errorMessage = null;
        isSendingRequest = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/chat/request-access", accessRequest);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (result.TryGetProperty("requestId", out var requestIdElement))
                {
                    currentRequestId = requestIdElement.GetString();
                    accessRequestSent = true;
                    showAccessForm = false;
                    isWaitingForApproval = true;
                    StartPolling();
                }
                else 
                {
                    errorMessage = "Server returned success but no Request ID.";
                }
            }
            else
            {
                errorMessage = $"Request failed. Status: {response.StatusCode}";
                Console.WriteLine("Failed to send request");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection Error: {ex.Message}";
            Console.WriteLine(ex);
        }
        finally
        {
            isSendingRequest = false;
            StateHasChanged();
        }
    }

    private void StartPolling()
    {
        if (statusTimer != null) return;
        statusTimer = new System.Threading.Timer(async _ => await CheckStatus(false), null, 0, 3000);
    }

    private async Task CheckStatus(bool silent = false)
    {
        if (string.IsNullOrEmpty(currentRequestId)) return;

        try
        {
            var response = await Http.GetFromJsonAsync<JsonElement>($"api/chat/status/{currentRequestId}");
            if (response.TryGetProperty("status", out var statusElement))
            {
                var status = statusElement.GetString();
                if (status == "Ready")
                {
                    await InvokeAsync(async () =>
                    {
                        statusTimer?.Dispose();
                        statusTimer = null;
                        isWaitingForApproval = false;
                        accessRequestSent = false;
                        showAccessForm = false; 
                        hasAccess = true;
                        
                        // Persist to localStorage
                        try { await JS.InvokeVoidAsync("localStorage.setItem", "ollamaAccessRequestId", currentRequestId); } catch {}

                        if (!silent)
                        {
                            history.Add(new MessageItem { Role = "model", Content = "🎉 Access Restored! You are connected to the local Ollama instance. Your session will remain active for 30 minutes of inactivity." });
                        }
                        StateHasChanged();
                    });
                }
                else if (status == "Pending" || status == "Approved")
                {
                    if (silent) StartPolling();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Polling error: {ex.Message}");
        }
    }

    public void Dispose()
    {
        statusTimer?.Dispose();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("messageUtils.scrollToBottom", "chat-body");
        }
        catch { /* Ignore JS errors */ }
    }

    private async Task SendSuggestion(string text)
    {
        currentInput = text;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || isTyping) return;

        var userMsg = currentInput;
        currentInput = "";
        
        history.Add(new MessageItem { Role = "user", Content = userMsg });
        await SaveStateAsync();
        isTyping = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var chatHistory = history
                .Where(x => x.Role != "error")
                .Select(x => new { role = x.Role, content = x.Content })
                .ToList();

            var payload = new 
            { 
                message = userMsg, 
                history = chatHistory,
                provider = selectedProvider,
                model = selectedModel
            };

            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "api/chat");
            httpRequest.Content = JsonContent.Create(payload);
            
            if (selectedProvider == "ollama" && !string.IsNullOrEmpty(currentRequestId))
            {
                httpRequest.Headers.Add("X-Access-RequestId", currentRequestId);
            }

            var response = await Http.SendAsync(httpRequest);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatResponseModel>();
                history.Add(new MessageItem { Role = "model", Content = result?.Response ?? "I didn't get a response." });
                await SaveStateAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized && selectedProvider == "ollama")
            {
                hasAccess = false;
                showAccessForm = true;
                errorMessage = "Your session has expired. Please request access again.";
                history.Add(new MessageItem { Role = "model", Content = "🔒 **Session Expired.** Please re-request access to continue using Ollama." });
                try { await JS.InvokeVoidAsync("localStorage.removeItem", "ollamaAccessRequestId"); } catch {}
            }
            else
            {
                history.Add(new MessageItem { Role = "model", Content = "😔 I'm having trouble connecting to the server. Please try again later." });
            }
        }
        catch (Exception ex)
        {
            history.Add(new MessageItem { Role = "model", Content = "⚠️ Connection error. Is the backend running?" });
            Console.WriteLine(ex);
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
            await ScrollToBottom();
            await inputElement.FocusAsync();
        }
    }

    public class MessageItem
    {
        public string Role { get; set; } = "user";
        public string Content { get; set; } = "";
    }

    public class ChatResponseModel
    {
        public string Response { get; set; } = "";
    }
}
