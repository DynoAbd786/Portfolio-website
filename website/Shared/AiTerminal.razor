@using System.Text.Json
@using Markdig
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS

@* The assistant, in the chat panel's frame. The panel's header (MainLayout) is its only header: its
   past-chats and new-chat buttons arrive here as Command calls (mkChatFrame in site.js). *@
<div class="chat-widget">
    @if (historySidebarOpen)
    {
        <div class="history-sidebar-overlay" @onclick="() => historySidebarOpen = false"></div>
        <div class="history-sidebar">
            <div class="sidebar-header">
                <h4>Past chats</h4>
                <button type="button" aria-label="Close past chats" @onclick="() => historySidebarOpen = false"><i class="fas fa-xmark"></i></button>
            </div>
            <div class="sidebar-content">
                @if (!sessions.Any())
                {
                    <div class="empty-history">No past chats yet.</div>
                }
                else
                {
                    @foreach (var session in sessions)
                    {
                        <div class="history-item @(session.Id == currentSessionId ? "active" : "")" @onclick="() => LoadSession(session.Id)">
                            <div class="item-info">
                                <div class="item-title">@session.Title</div>
                                <div class="item-meta">@session.LastUpdated.ToString("d MMM, HH:mm")</div>
                            </div>
                            <button type="button" class="delete-session-btn" aria-label="Delete this chat" @onclick:stopPropagation="true" @onclick="() => DeleteSession(session.Id)">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="sidebar-footer">
                <button type="button" class="new-chat-sidebar-btn" @onclick="StartNewChat">
                    <i class="fas fa-plus"></i> New chat
                </button>
            </div>
        </div>
    }

    <div class="chat-body" id="chat-body">
        @foreach (var message in history)
        {
            <div class="message-wrapper @(message.Role == "user" ? "user" : "ai")">
                <div class="message-content">
                    @if (message.Role == "user")
                    {
                        @message.Content
                    }
                    else
                    {
                        @((MarkupString)ChatMarkdown.ToHtml(message.Content))
                    }
                </div>
            </div>
        }

        @if (isTyping)
        {
            <div class="message-wrapper ai">
                <div class="message-content typing" aria-label="Thinking">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
            </div>
        }
    </div>

    <div class="chat-footer">
        @if (history.Count < 2)
        {
            <div class="suggestion-chips">
                <button type="button" @onclick='() => SendSuggestion("What is he building right now?")'>What is he building?</button>
                <button type="button" @onclick='() => SendSuggestion("Show me his AI projects")'>His AI projects</button>
                <button type="button" @onclick='() => SendSuggestion("How can I contact Muhammad?")'>How do I contact him?</button>
            </div>
        }

        <div class="input-area">
            <input @ref="inputElement"
                   type="text"
                   aria-label="Your question"
                   placeholder="Ask about his work..."
                   @bind="currentInput"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
            <button type="button" class="send-btn" aria-label="Send" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(currentInput) || isTyping)">
                <i class="fas fa-arrow-up"></i>
            </button>
        </div>
        <p class="chat-note">Answers come from this site and can be wrong.</p>
    </div>
</div>

<style>
    /* The site's look (tailwind.config.js tokens): ink #0b1020, ink-2 #111a2e, line #1f2a44, cy #22d3ee */
    .chat-widget {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        overflow: hidden;
        background: #0b1020;
        color: #e2e8f0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --chat-gutter: max(16px, calc((100% - 760px) / 2)); /* full screen: a readable column */
    }

    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px var(--chat-gutter);
        display: flex;
        flex-direction: column;
        gap: 12px;
        scroll-behavior: smooth;
    }

    .message-wrapper { display: flex; }
    .message-wrapper.user { justify-content: flex-end; }

    .message-content {
        max-width: 88%;
        padding: 11px 14px;
        border-radius: 14px;
        border: 1px solid #1f2a44;
        background: #111a2e;
        font-size: 14.5px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }
    .message-wrapper.ai .message-content { border-bottom-left-radius: 4px; }
    .message-wrapper.user .message-content {
        border-color: rgba(34, 211, 238, .35);
        background: rgba(34, 211, 238, .1);
        color: #f1f5f9;
        border-bottom-right-radius: 4px;
        white-space: pre-wrap;
    }

    .message-content p { margin: 0 0 .6em; }
    .message-content p:last-child { margin-bottom: 0; }
    .message-content a { color: #22d3ee; text-decoration: underline; text-underline-offset: 2px; }
    .message-content strong { color: #fff; font-weight: 600; }
    .message-content ul, .message-content ol { margin: .4em 0 .6em; padding-left: 1.25em; }
    .message-content ul { list-style: disc; }
    .message-content ol { list-style: decimal; }
    .message-content li { margin: .2em 0; }
    .message-content h1, .message-content h2, .message-content h3, .message-content h4 {
        margin: .8em 0 .35em; font-size: 1em; font-weight: 700; color: #fff;
    }
    .message-content code {
        font-family: "JetBrains Mono", monospace; font-size: .85em;
        background: rgba(255, 255, 255, .06); padding: .1em .35em; border-radius: 4px;
    }
    .message-content pre {
        margin: .6em 0; padding: 10px 12px; overflow-x: auto;
        background: #0b1020; border: 1px solid #1f2a44; border-radius: 10px;
    }
    .message-content pre code { background: none; padding: 0; }
    .message-content blockquote { margin: .6em 0; padding-left: 10px; border-left: 2px solid #22d3ee; color: #cbd5e1; }
    .message-content table { border-collapse: collapse; margin: .6em 0; font-size: .92em; }
    .message-content th, .message-content td { border: 1px solid #1f2a44; padding: 4px 8px; text-align: left; }

    .message-content.typing { display: flex; align-items: center; gap: 5px; padding: 14px 16px; }
    .typing-dot { width: 6px; height: 6px; border-radius: 50%; background: #22d3ee; animation: typing-pulse 1.2s infinite ease-in-out both; }
    .typing-dot:nth-child(2) { animation-delay: .15s; }
    .typing-dot:nth-child(3) { animation-delay: .3s; }
    @@keyframes typing-pulse { 0%, 80%, 100% { opacity: .25; transform: scale(.8); } 40% { opacity: 1; transform: scale(1); } }

    .chat-footer { padding: 12px var(--chat-gutter) 12px; border-top: 1px solid #1f2a44; background: #0b1020; }

    .suggestion-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
    .suggestion-chips button {
        font: 12px "JetBrains Mono", monospace; color: #cbd5e1; cursor: pointer;
        background: rgba(255, 255, 255, .03); border: 1px solid #1f2a44; border-radius: 999px; padding: 6px 12px;
        transition: border-color .2s, color .2s;
    }
    .suggestion-chips button:hover { border-color: rgba(34, 211, 238, .5); color: #22d3ee; }

    .input-area {
        display: flex; align-items: center; gap: 8px;
        padding: 5px 5px 5px 14px; border: 1px solid #1f2a44; border-radius: 12px; background: #111a2e;
        transition: border-color .2s, box-shadow .2s;
    }
    .input-area:focus-within { border-color: rgba(34, 211, 238, .6); box-shadow: 0 0 0 3px rgba(34, 211, 238, .12); }
    .input-area input {
        flex: 1; min-width: 0; padding: 7px 0;
        background: transparent; border: 0; outline: 0; color: #f1f5f9; font-size: 14.5px;
    }
    .input-area input::placeholder { color: #64748b; }
    .send-btn {
        display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
        border: 0; border-radius: 9px; background: #22d3ee; color: #03141b; cursor: pointer;
        transition: opacity .2s, transform .2s;
    }
    .send-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .send-btn:disabled { opacity: .35; cursor: not-allowed; }
    .chat-note { margin: 8px 0 0; font-size: 11.5px; color: #64748b; text-align: center; }

    /* past chats: a drawer over the conversation */
    .history-sidebar-overlay { position: absolute; inset: 0; z-index: 10; background: rgba(3, 6, 14, .6); }
    .history-sidebar {
        position: absolute; top: 0; bottom: 0; left: 0; z-index: 11; width: min(300px, 86%);
        display: flex; flex-direction: column; background: #111a2e; border-right: 1px solid #1f2a44;
        animation: drawer-in .25s cubic-bezier(.2, .7, .2, 1);
    }
    @@keyframes drawer-in { from { transform: translateX(-16px); opacity: 0; } }
    .sidebar-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #1f2a44; }
    .sidebar-header h4 { margin: 0; font-size: 14px; font-weight: 600; color: #fff; }
    .sidebar-header button { background: none; border: 0; color: #94a3b8; cursor: pointer; padding: 4px; }
    .sidebar-header button:hover { color: #fff; }
    .sidebar-content { flex: 1; overflow-y: auto; padding: 8px; }
    .history-item {
        display: flex; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 4px;
        border: 1px solid transparent; border-radius: 10px; cursor: pointer; transition: background .15s;
    }
    .history-item:hover { background: rgba(255, 255, 255, .04); }
    .history-item.active { background: rgba(34, 211, 238, .08); border-color: rgba(34, 211, 238, .3); }
    .item-info { flex: 1; min-width: 0; }
    .item-title { font-size: 13.5px; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .item-meta { margin-top: 2px; font: 11px "JetBrains Mono", monospace; color: #64748b; }
    .delete-session-btn { background: none; border: 0; color: #64748b; cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; padding: 4px; }
    .history-item:hover .delete-session-btn, .delete-session-btn:focus-visible { opacity: 1; }
    .delete-session-btn:hover { color: #f87171; }
    .empty-history { margin-top: 2rem; text-align: center; font-size: 13px; color: #64748b; }
    .sidebar-footer { padding: 12px; border-top: 1px solid #1f2a44; }
    .new-chat-sidebar-btn {
        width: 100%; padding: 9px; display: flex; align-items: center; justify-content: center; gap: 8px;
        background: transparent; border: 1px solid #1f2a44; border-radius: 10px; color: #cbd5e1; font-size: 13.5px; cursor: pointer;
        transition: border-color .2s, color .2s;
    }
    .new-chat-sidebar-btn:hover { border-color: #22d3ee; color: #22d3ee; }
</style>

@code {
    private const string Greeting = "Hi, I'm the assistant on Muhammad's site. Ask me about his projects, his experience or what he works with, or I can pass a message on to him.";
    // the old greeting may still be in a visitor's saved chats
    private const string OldGreetingStart = "Hi there! 👋";

    private DotNetObjectReference<AiTerminal>? self;

    // from the panel's header, outside the frame (mkChat.command → mkChatFrame.run)
    [JSInvokable]
    public async Task Command(string name)
    {
        if (name == "history") historySidebarOpen = !historySidebarOpen;
        else if (name == "new") await StartNewChat();
        StateHasChanged();
    }

    public void Dispose() => self?.Dispose();

    private ElementReference inputElement;
    private string currentInput = "";
    private bool isTyping = false;
    private List<MessageItem> history = new();
    
    
    
    // Multi-session History
    private List<ChatSession> sessions = new();
    private string currentSessionId = Guid.NewGuid().ToString();
    private string currentSessionTitle = "New Chat";
    private bool historySidebarOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Try to restore session and history
            try 
            {
                var savedHistory = await JS.InvokeAsync<string>("localStorage.getItem", "aiChatHistory");
                if (!string.IsNullOrEmpty(savedHistory))
                {
                    history = JsonSerializer.Deserialize<List<MessageItem>>(savedHistory) ?? new();
                }

                // Load Sessions
                var savedSessions = await JS.InvokeAsync<string>("localStorage.getItem", "aiSessions");
                if (!string.IsNullOrEmpty(savedSessions))
                {
                    sessions = JsonSerializer.Deserialize<List<ChatSession>>(savedSessions) ?? new();
                }

                var activeId = await JS.InvokeAsync<string>("localStorage.getItem", "currentSessionId");
                if (!string.IsNullOrEmpty(activeId))
                {
                    var activeSession = sessions.FirstOrDefault(s => s.Id == activeId);
                    if (activeSession != null)
                    {
                        currentSessionId = activeSession.Id;
                        currentSessionTitle = activeSession.Title;
                        history = activeSession.Messages;
                    }
                }
            }
            catch (Exception ex) { Console.WriteLine("localStorage error: " + ex.Message); }

            if (!history.Any())
            {
                history.Add(new MessageItem { Role = "model", Content = Greeting });
                await SaveStateAsync();
            }
            else if (history[0].Role == "model" && history[0].Content.StartsWith(OldGreetingStart))
                history[0].Content = Greeting;

            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mkChatFrame.register", self);
            StateHasChanged();
        }
        await ScrollToBottom();
        await JS.InvokeVoidAsync("messageUtils.highlightAll");
        await JS.InvokeVoidAsync("messageUtils.renderMath", "chat-body");
    }

    private async Task SaveStateAsync()
    {
        try
        {
            // Sync current state to active session
            var currentSession = sessions.FirstOrDefault(s => s.Id == currentSessionId);
            if (currentSession == null)
            {
                currentSession = new ChatSession { Id = currentSessionId };
                sessions.Insert(0, currentSession);
            }

            currentSession.Title = currentSessionTitle;
            currentSession.Messages = history;
            currentSession.LastUpdated = DateTime.Now;

            // Limit to last 50 sessions for performance
            if (sessions.Count > 50) sessions = sessions.Take(50).ToList();

            await JS.InvokeVoidAsync("localStorage.setItem", "aiSessions", JsonSerializer.Serialize(sessions));
            await JS.InvokeVoidAsync("localStorage.setItem", "currentSessionId", currentSessionId);

        }
        catch (Exception ex) { Console.WriteLine("Save state error: " + ex.Message); }
    }

    private async Task LoadSession(string sessionId)
    {
        var session = sessions.FirstOrDefault(s => s.Id == sessionId);
        if (session == null) return;

        currentSessionId = session.Id;
        currentSessionTitle = session.Title;
        history = session.Messages;
        
        historySidebarOpen = false;
        StateHasChanged();
        await ScrollToBottom();
        await SaveStateAsync();

    }

    private async Task DeleteSession(string sessionId)
    {
        sessions.RemoveAll(s => s.Id == sessionId);
        if (currentSessionId == sessionId)
        {
            await StartNewChat();
        }
        else
        {
            await SaveStateAsync();
        }
    }

    private async Task StartNewChat()
    {
        currentSessionId = Guid.NewGuid().ToString();
        currentSessionTitle = "New Chat";
        history.Clear();
        history.Add(new MessageItem { Role = "model", Content = Greeting });
        
        historySidebarOpen = false;
        await SaveStateAsync();
        StateHasChanged();
    }

    // Access Request State
    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("messageUtils.scrollToBottom", "chat-body");
        }
        catch { /* Ignore JS errors */ }
    }

    private async Task SendSuggestion(string text)
    {
        currentInput = text;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || isTyping) return;

        var userMsg = currentInput;
        currentInput = "";
        
        bool isFirstMessage = !history.Any(m => m.Role == "user");

        history.Add(new MessageItem { Role = "user", Content = userMsg });
        // analytics: the question itself (the footer says questions are recorded), via the page around the frame
        _ = JS.InvokeVoidAsync("mkChatFrame.track", "ask-ai-question", new { question = userMsg.Length > 200 ? userMsg[..200] : userMsg }).AsTask();
        await SaveStateAsync();
        isTyping = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var chatHistory = history
                .Where(x => x.Role != "error")
                .Select(x => new { role = x.Role, content = x.Content })
                .ToList();

            var payload = new 
            { 
                message = userMsg, 
                history = chatHistory
            };

            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, "api/chat");
            httpRequest.Content = JsonContent.Create(payload);


            var response = await Http.SendAsync(httpRequest);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatResponseModel>();
                history.Add(new MessageItem { 
                    Role = "model", 
                    Content = result?.Response ?? "I didn't get a response.",
                    ToolsDisabled = result?.ToolsDisabled ?? false
                });

                if (isFirstMessage)
                {
                    GenerateAutoTitle(userMsg);
                }

                await SaveStateAsync();
            }
            else
            {
                history.Add(new MessageItem { Role = "model", Content = "I can't reach the server right now. Please try again in a moment." });
            }
        }
        catch (Exception ex)
        {
            history.Add(new MessageItem { Role = "model", Content = "I can't reach the server right now. Please try again in a moment." });
            Console.WriteLine(ex);
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
            await ScrollToBottom();
            await inputElement.FocusAsync();
        }
    }

    private void GenerateAutoTitle(string firstMessage)
    {
        if (string.IsNullOrEmpty(firstMessage)) return;
        
        // Take first 5-7 words or 40 characters
        var words = firstMessage.Split(' ');
        var title = string.Join(" ", words.Take(6));
        if (title.Length > 40) title = title.Substring(0, 37) + "...";
        
        currentSessionTitle = title;
    }

    public class MessageItem
    {
        public string Role { get; set; } = "user";
        public string Content { get; set; } = "";
        public bool ToolsDisabled { get; set; }
    }

    public class ChatSession
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Title { get; set; } = "New Chat";
        public List<MessageItem> Messages { get; set; } = new();
        public string Provider { get; set; } = "gemini";
        public string Model { get; set; } = "gemini-3-flash";
        public DateTime LastUpdated { get; set; } = DateTime.Now;
    }

    public class ChatResponseModel
    {
        public string Response { get; set; } = "";
        public bool ToolsDisabled { get; set; }
    }
}
