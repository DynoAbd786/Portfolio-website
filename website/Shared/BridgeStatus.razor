@rendermode InteractiveWebAssembly
@using System.Text.Json
@inject HttpClient Http
@implements IDisposable

@* Whether the home lab's bridge is connected right now; polls the API every 3 s in the browser *@
<div class="bridge-status bg-black rounded-lg p-6 border border-line flex items-center justify-between">
     <div class="flex items-center gap-4">
        <div class="relative flex h-4 w-4">
          @if (IsOnline)
          {
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-4 w-4 bg-green-500"></span>
          }
          else
          {
              <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500"></span>
          }
        </div>
        <div>
            <div class="text-white font-bold text-lg">@(IsOnline ? "ONLINE" : "OFFLINE")</div>
            <div class="text-slate-400 text-sm">Bridge Connection</div>
        </div>
     </div>
</div>

 <div class="mt-4 p-4 bg-white/[.02] rounded-lg border-l-4 border-cy/60">
    <p class="text-slate-300 text-sm leading-relaxed">
        <strong class="text-white">Live Monitoring:</strong> This indicator polls the backend API (Server-Sent Events Bridge) to verify if the local home lab agent is currently reachable for AI inference tasks.
    </p>
</div>

@code {
    private bool IsOnline = false;
    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        // Only poll once running in the browser, not while prerendering on the server
        if (!firstRender || !RendererInfo.IsInteractive) return;

        _timer = new System.Threading.Timer(async _ =>
        {
            await CheckStatus();
            await InvokeAsync(StateHasChanged);
        }, null, 0, 3000);
    }

    private async Task CheckStatus()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<JsonElement>("api/mcp/status/bridge");
            if (response.TryGetProperty("isConnected", out var connected))
            {
                IsOnline = connected.GetBoolean();
            }
        }
        catch
        {
            IsOnline = false;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
