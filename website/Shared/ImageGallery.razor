@rendermode InteractiveWebAssembly
@using website.Data

@* A carousel of images with captions; runs in the browser (prerendered with the first slide) *@
@if (Items.Count > 0)
{
    var item = Items[current];
    <div class="relative overflow-hidden rounded-lg border border-line bg-ink">
        <button type="button" @onclick="() => Show(current - 1)" aria-label="Previous image" disabled="@(!RendererInfo.IsInteractive)"
                class="gallery-prev absolute left-4 top-1/2 z-10 -translate-y-1/2 rounded-full border border-white/10 bg-black/50 p-3 text-white backdrop-blur-sm transition hover:bg-black/70">
            <i class="fas fa-chevron-left text-xl" aria-hidden="true"></i>
        </button>
        <button type="button" @onclick="() => Show(current + 1)" aria-label="Next image" disabled="@(!RendererInfo.IsInteractive)"
                class="gallery-next absolute right-4 top-1/2 z-10 -translate-y-1/2 rounded-full border border-white/10 bg-black/50 p-3 text-white backdrop-blur-sm transition hover:bg-black/70">
            <i class="fas fa-chevron-right text-xl" aria-hidden="true"></i>
        </button>

        <div class="relative aspect-video w-full">
            <img src="@item.ImagePath" alt="@item.Title" class="h-full w-full object-contain" />
        </div>

        <div class="border-t border-line p-6">
            <h3 class="mb-2 text-xl font-bold text-white">
                <span class="mr-2 font-mono text-cy">@(current + 1)/@Items.Count</span>
                @item.Title
            </h3>
            <p class="h-24 overflow-y-auto border-l-4 border-cy/60 pl-4 leading-relaxed text-slate-300">@((MarkupString)(item.Description ?? ""))</p>
            <div class="mt-4 flex justify-center gap-2">
                @for (int i = 0; i < Items.Count; i++)
                {
                    var index = i;
                    <button type="button" @onclick="() => Show(index)" aria-label="@($"Image {index + 1}")"
                            class="h-2.5 rounded-full transition-all duration-300 @(index == current ? "w-6 bg-cy" : "w-2.5 bg-slate-600 hover:bg-slate-500")"></button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<GalleryItem> Items { get; set; } = new();

    private int current;

    private void Show(int index) => current = (index % Items.Count + Items.Count) % Items.Count;
}
