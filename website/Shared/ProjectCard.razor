@using website.Data

@* One project in the Projects grid: field, title, result and tags; the whole card links to the page *@
<article class="project-card surface group relative flex h-full flex-col p-6 transition duration-300 hover:-translate-y-1 hover:border-cy/50">
    <div class="mb-3 flex items-start justify-between gap-3">
        <p class="mono-label">// @FieldLabel</p>
        @if (Project.IsInDevelopment)
        {
            <span class="chip shrink-0 border-lamp/40 text-lamp">in development</span>
        }
        else if (Project.IsFeatured)
        {
            <span class="chip shrink-0 border-cy/40 text-cy">featured</span>
        }
    </div>
    <h3 class="mb-3 text-lg font-bold leading-snug text-white">@Project.Title</h3>
    <p class="mb-5 flex-1 text-sm leading-relaxed text-slate-400">@Project.Result</p>
    <div class="mb-5 flex flex-wrap gap-2">
        @foreach (var tag in Project.Tags.Take(4))
        {
            <span class="chip">@tag</span>
        }
    </div>
    <a href="@Project.ProjectUrl" class="text-sm font-semibold text-cy after:absolute after:inset-0 group-hover:underline">Read more →</a>
</article>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = new();

    // The field the grid is filtered by, shown in place of the project's first field
    [Parameter] public ProjectField? Field { get; set; }

    private string FieldLabel =>
        Field is { } f && Project.Fields.Contains(f) ? ProjectFields.Label(f)
        : Project.Fields.Length > 0 ? ProjectFields.Label(Project.Fields[0])
        : Project.Category.ToString();
}
