@using website.Data

@if (Project != null)
{
    <div class="project-card-container">
        <div class="project-card bg-gray-800 rounded-lg overflow-hidden shadow-xl transition-all duration-500 border border-transparent hover:border-cyan-500/50">
            @if (!string.IsNullOrEmpty(Project.ImageUrl))
            {
                <img src="@Project.ImageUrl" alt="@(Project.Title ?? "Project")" class="w-full h-48 object-cover">
            }
            else
            {
                <div class="w-full h-48 bg-gray-700 flex items-center justify-center">
                    <i class="fas fa-code text-gray-500 text-4xl"></i>
                </div>
            }
            <div class="p-6">
                <h3 class="text-2xl font-bold text-white mb-2">@(Project.Title ?? "Untitled Project")</h3>
                <p class="text-gray-400 mb-4">@(Project.Description ?? "No description available")</p>
                @if (Project.Tags != null && Project.Tags.Any())
                {
                    <div class="flex flex-wrap gap-2 mb-4">
                        @foreach(var tag in Project.Tags)
                        {
                            @if (!string.IsNullOrEmpty(tag))
                            {
                                <span class="bg-gray-700 text-cyan-400 text-xs font-semibold px-2.5 py-1 rounded-full">@tag</span>
                            }
                        }
                    </div>
                }
                <div class="flex gap-3 mt-2">
                    @if (!string.IsNullOrEmpty(Project.ProjectUrl))
                    {
                        <a href="@Project.ProjectUrl" class="inline-block font-bold text-cyan-400 hover:text-white transition-colors duration-300">
                            View Project &rarr;
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Project.GitHubUrl))
                    {
                        <a href="@Project.GitHubUrl" target="_blank" class="inline-block font-bold text-gray-400 hover:text-white transition-colors duration-300">
                            <i class="fab fa-github mr-1"></i>GitHub
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="bg-gray-800 rounded-lg p-6 border border-red-500/50">
        <p class="text-red-400">Error: Project data not available</p>
    </div>
}

@code {
    [Parameter]
    public Project Project { get; set; } = new();
}