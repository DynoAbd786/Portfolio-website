@using website.Data
@inject IContactSender Sender

@* A plain server-side form (no WebAssembly): it posts, the server validates and emails it, and
   enhanced navigation swaps in the result without a full page load *@

<section id="contact" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="mono-label mb-3">// contact</p>
        <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Let's talk</h2>
        <p class="mb-12 max-w-2xl text-lg text-slate-400">
            Interested in collaborating or discussing opportunities? I'd love to hear from you.
            Fill out the form below and I'll get back to you as soon as possible.
        </p>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
            <!-- Contact Information -->
            <div class="surface p-8 lg:col-span-2">
                <h3 class="mb-6 text-xl font-bold text-white">Let's Connect</h3>

                <ul class="space-y-5">
                    <li class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-cy/10 text-cy"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                        <div>
                            <p class="text-sm text-slate-400">Email</p>
                            <a href="mailto:Abdua786@outlook.com" class="text-slate-100 transition-colors hover:text-cy">Abdua786@outlook.com</a>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-cy/10 text-cy"><i class="fab fa-linkedin" aria-hidden="true"></i></span>
                        <div>
                            <p class="text-sm text-slate-400">LinkedIn</p>
                            <a href="https://linkedin.com/in/dynoabd786" target="_blank" rel="noopener" class="text-slate-100 transition-colors hover:text-cy">linkedin.com/in/dynoabd786</a>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-cy/10 text-cy"><i class="fab fa-github" aria-hidden="true"></i></span>
                        <div>
                            <p class="text-sm text-slate-400">GitHub</p>
                            <a href="https://github.com/DynoAbd786" target="_blank" rel="noopener" class="text-slate-100 transition-colors hover:text-cy">github.com/DynoAbd786</a>
                        </div>
                    </li>
                    <li class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-cy/10 text-cy"><i class="fas fa-file-pdf" aria-hidden="true"></i></span>
                        <div>
                            <p class="text-sm text-slate-400">CV</p>
                            <a href="/docs/Muhammad-Kashif-Khan-CV.pdf?v=2026-07" target="_blank" class="text-slate-100 transition-colors hover:text-cy">Download PDF</a>
                        </div>
                    </li>
                </ul>

                <div class="mt-8 rounded-lg border border-line bg-white/[.02] p-5">
                    <h4 class="mono-label mb-2">Response time</h4>
                    <p class="text-sm text-slate-400">I typically respond to inquiries within 24-48 hours. For urgent matters, please mention it in your message.</p>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="surface p-8 lg:col-span-3">
                    <EditForm Model="Model" FormName="contact" OnValidSubmit="HandleSubmit" Enhance>
                        <DataAnnotationsValidator />
                        <fieldset class="space-y-6">

                        <div>
                            <label for="name" class="mb-2 block text-sm font-semibold text-slate-200">Full Name *</label>
                            <InputText @bind-Value="Model!.Name" id="name"
                                      class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 placeholder-slate-500 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25"
                                      placeholder="Your full name" />
                            <ValidationMessage For="@(() => Model!.Name)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="email" class="mb-2 block text-sm font-semibold text-slate-200">Email Address *</label>
                            <InputText @bind-Value="Model!.Email" id="email" type="email"
                                      class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 placeholder-slate-500 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25"
                                      placeholder="your.email@example.com" />
                            <ValidationMessage For="@(() => Model!.Email)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="company" class="mb-2 block text-sm font-semibold text-slate-200">Company/Organization</label>
                            <InputText @bind-Value="Model!.Company" id="company"
                                      class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 placeholder-slate-500 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25"
                                      placeholder="Your company or organization" />
                        </div>

                        <div>
                            <label for="role" class="mb-2 block text-sm font-semibold text-slate-200">Your Role/Position</label>
                            <InputText @bind-Value="Model!.Role" id="role"
                                      class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 placeholder-slate-500 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25"
                                      placeholder="e.g., Software Engineer, Recruiter, CTO" />
                        </div>

                        <div>
                            <label for="subject" class="mb-2 block text-sm font-semibold text-slate-200">Subject *</label>
                            <InputSelect @bind-Value="Model!.Subject" id="subject"
                                        class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25">
                                <option value="">Select a subject</option>
                                <option value="Job Opportunity">Job Opportunity</option>
                                <option value="Freelance Project">Freelance Project</option>
                                <option value="Collaboration">Collaboration</option>
                                <option value="Consulting">Consulting</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Model!.Subject)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="message" class="mb-2 block text-sm font-semibold text-slate-200">Message *</label>
                            <InputTextArea @bind-Value="Model!.Message" id="message" rows="5"
                                          class="w-full rounded-lg border border-line bg-ink px-4 py-3 text-slate-100 placeholder-slate-500 transition-colors focus:border-cy focus:outline-none focus:ring-2 focus:ring-cy/25 resize-none"
                                          placeholder="Tell me about your project, opportunity, or how I can help..." />
                            <ValidationMessage For="@(() => Model!.Message)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="Model!.AgreeToContact" id="agree" class="mr-3 rounded" />
                            <label for="agree" class="text-sm text-slate-400">
                                I agree to be contacted regarding this inquiry *
                            </label>
                        </div>
                        <ValidationMessage For="@(() => Model!.AgreeToContact)" class="text-red-400 text-sm" />

                        <button type="submit" class="btn-primary w-full justify-center">
                            <i class="fas fa-paper-plane mr-2" aria-hidden="true"></i>
                            <span>Send Message</span>
                        </button>

                        @if (!string.IsNullOrEmpty(submitMessage))
                        {
                            <div class="p-4 rounded-lg @(submitSuccess ? "bg-green-500/20 border border-green-500 text-green-400" : "bg-red-500/20 border border-red-500 text-red-400")">
                                <i class="@(submitSuccess ? "fas fa-check-circle" : "fas fa-exclamation-circle") mr-2"></i>
                                @submitMessage
                            </div>
                        }
                        </fieldset>
                    </EditForm>
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactFormModel? Model { get; set; }

    private string submitMessage = "";
    private bool submitSuccess = false;

    protected override void OnInitialized() => Model ??= new();

    private async Task HandleSubmit()
    {
        var m = Model!;
        submitSuccess = await Sender.SendAsync(new ContactMessage(m.Name, m.Email, m.Company, m.Role, m.Subject, m.Message));
        if (submitSuccess)
        {
            submitMessage = "Thank you! Your message has been sent. I'll get back to you soon.";
            Model = new();
        }
        else
        {
            submitMessage = "Sorry, there was an error sending your message. Please try again or email me directly at Abdua786@outlook.com.";
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";

        public string? Company { get; set; }
        public string? Role { get; set; }

        [Required(ErrorMessage = "Please select a subject")]
        public string Subject { get; set; } = "";

        [Required(ErrorMessage = "Message is required")]
        [MinLength(10, ErrorMessage = "Message must be at least 10 characters")]
        public string Message { get; set; } = "";

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must agree to be contacted")]
        public bool AgreeToContact { get; set; }
    }
}