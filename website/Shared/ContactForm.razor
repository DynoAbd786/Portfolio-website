@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<section id="contact" class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Get In Touch
            </div>
            <h2 class="text-5xl font-bold text-white mb-6">Contact Me</h2>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
                Interested in collaborating or discussing opportunities? I'd love to hear from you.
                Fill out the form below and I'll get back to you as soon as possible.
            </p>
        </div>

        <div class="max-w-4xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <!-- Contact Information -->
                <div class="bg-gray-800 rounded-lg p-8 border border-gray-700">
                    <h3 class="text-2xl font-bold text-white mb-6">Let's Connect</h3>

                    <div class="space-y-6">
                        <div class="flex items-center">
                            <div class="bg-cyan-500 rounded-full p-3 mr-4">
                                <i class="fas fa-envelope text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Email</h4>
                                <p class="text-gray-300">Abdua786@outlook.com</p>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="bg-cyan-500 rounded-full p-3 mr-4">
                                <i class="fab fa-linkedin text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">LinkedIn</h4>
                                <a href="https://linkedin.com/in/dynoabd786" class="text-cyan-400 hover:text-cyan-300 transition-colors">linkedin.com/in/dynoabd786</a>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="bg-cyan-500 rounded-full p-3 mr-4">
                                <i class="fab fa-github text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">GitHub</h4>
                                <a href="https://github.com/DynoAbd786" class="text-cyan-400 hover:text-cyan-300 transition-colors">github.com/DynoAbd786</a>
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="bg-cyan-500 rounded-full p-3 mr-4">
                                <i class="fas fa-globe text-white text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-white font-semibold">Portfolio</h4>
                                <a href="https://dynoabd786.github.io" class="text-cyan-400 hover:text-cyan-300 transition-colors">dynoabd786.github.io</a>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 p-6 bg-gray-700 rounded-lg border border-cyan-500/25">
                        <h4 class="text-white font-semibold mb-3">Response Time</h4>
                        <p class="text-gray-300 text-sm">I typically respond to inquiries within 24-48 hours. For urgent matters, please mention it in your message.</p>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="bg-gray-800 rounded-lg p-8 border border-gray-700">
                    <EditForm Model="@contactForm" OnValidSubmit="@HandleSubmit" class="space-y-6">
                        <DataAnnotationsValidator />

                        <div>
                            <label for="name" class="block text-white font-semibold mb-2">Full Name *</label>
                            <InputText @bind-Value="contactForm.Name" id="name"
                                      class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors"
                                      placeholder="Your full name" />
                            <ValidationMessage For="@(() => contactForm.Name)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="email" class="block text-white font-semibold mb-2">Email Address *</label>
                            <InputText @bind-Value="contactForm.Email" id="email" type="email"
                                      class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors"
                                      placeholder="your.email@example.com" />
                            <ValidationMessage For="@(() => contactForm.Email)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="company" class="block text-white font-semibold mb-2">Company/Organization</label>
                            <InputText @bind-Value="contactForm.Company" id="company"
                                      class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors"
                                      placeholder="Your company or organization" />
                        </div>

                        <div>
                            <label for="role" class="block text-white font-semibold mb-2">Your Role/Position</label>
                            <InputText @bind-Value="contactForm.Role" id="role"
                                      class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors"
                                      placeholder="e.g., Software Engineer, Recruiter, CTO" />
                        </div>

                        <div>
                            <label for="subject" class="block text-white font-semibold mb-2">Subject *</label>
                            <InputSelect @bind-Value="contactForm.Subject" id="subject"
                                        class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors">
                                <option value="">Select a subject</option>
                                <option value="Job Opportunity">Job Opportunity</option>
                                <option value="Freelance Project">Freelance Project</option>
                                <option value="Collaboration">Collaboration</option>
                                <option value="Consulting">Consulting</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => contactForm.Subject)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="message" class="block text-white font-semibold mb-2">Message *</label>
                            <InputTextArea @bind-Value="contactForm.Message" id="message" rows="5"
                                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/25 transition-colors resize-none"
                                          placeholder="Tell me about your project, opportunity, or how I can help..." />
                            <ValidationMessage For="@(() => contactForm.Message)" class="text-red-400 text-sm mt-1" />
                        </div>

                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="contactForm.AgreeToContact" id="agree" class="mr-3 rounded" />
                            <label for="agree" class="text-gray-300 text-sm">
                                I agree to be contacted regarding this inquiry *
                            </label>
                        </div>
                        <ValidationMessage For="@(() => contactForm.AgreeToContact)" class="text-red-400 text-sm" />

                        <button type="submit" disabled="@isSubmitting"
                                class="w-full bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                            @if (isSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin mr-2"></i>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <i class="fas fa-paper-plane mr-2"></i>
                                <span>Send Message</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(submitMessage))
                        {
                            <div class="p-4 rounded-lg @(submitSuccess ? "bg-green-500/20 border border-green-500 text-green-400" : "bg-red-500/20 border border-red-500 text-red-400")">
                                <i class="@(submitSuccess ? "fas fa-check-circle" : "fas fa-exclamation-circle") mr-2"></i>
                                @submitMessage
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private ContactFormModel contactForm = new();
    private bool isSubmitting = false;
    private string submitMessage = "";
    private bool submitSuccess = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        submitMessage = "";
        StateHasChanged();

        try
        {
            // Send email via API
            var response = await Http.PostAsJsonAsync("api/contact", contactForm);

            if (response.IsSuccessStatusCode)
            {
                submitMessage = "Thank you! Your message has been sent successfully. I'll get back to you soon.";
                submitSuccess = true;

                // Reset form after successful submission
                await Task.Delay(3000);
                contactForm = new();
                submitMessage = "";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                submitMessage = "Sorry, there was an error sending your message. Please try again or email me directly at Abdua786@outlook.com.";
                submitSuccess = false;
            }
        }
        catch (Exception ex)
        {
            submitMessage = "Sorry, there was an error sending your message. Please try again or email me directly at Abdua786@outlook.com.";
            submitSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";

        public string? Company { get; set; }
        public string? Role { get; set; }

        [Required(ErrorMessage = "Please select a subject")]
        public string Subject { get; set; } = "";

        [Required(ErrorMessage = "Message is required")]
        [MinLength(10, ErrorMessage = "Message must be at least 10 characters")]
        public string Message { get; set; } = "";

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must agree to be contacted")]
        public bool AgreeToContact { get; set; }
    }
}