

@inherits LayoutComponentBase

@* Default title; a page's own <PageTitle> renders later and wins *@
<PageTitle>Muhammad Kashif Khan - Portfolio | Software Engineer & Computer Science Student</PageTitle>

<div class="bg-gray-900 text-gray-200 min-h-screen font-sans">
    <header class="sticky top-0 z-50 bg-gray-900 bg-opacity-80 backdrop-blur-md shadow-lg shadow-cyan-500/10">
        <nav class="container mx-auto px-4 sm:px-6 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-2 sm:gap-4">
                    <a href="/" class="text-lg sm:text-2xl font-bold text-white hover:text-cyan-400 transition-colors duration-300">
                        Muhammad Kashif-Khan
                    </a>
                    <div class="hidden sm:flex gap-2 ml-2">
                        <a href="#contact" aria-label="Contact" class="text-cyan-400 hover:text-white text-xl"><i class="fas fa-envelope"></i></a>
                        <a href="https://github.com/DynoAbd786" target="_blank" aria-label="GitHub" class="text-cyan-400 hover:text-white text-xl"><i class="fab fa-github"></i></a>
                        <a href="https://linkedin.com/in/dynoabd786" target="_blank" aria-label="LinkedIn" class="text-cyan-400 hover:text-white text-xl"><i class="fab fa-linkedin"></i></a>
                        <a href="/docs/Muhammad-Kashif-Khan-CV.pdf?v=2026-07" target="_blank" aria-label="Download CV" class="text-cyan-400 hover:text-white text-xl"><i class="fas fa-file-pdf"></i></a>
                    </div>
                </div>
                
                <!-- Desktop Navigation -->
                <div class="hidden lg:flex space-x-6 items-center">
                    <a href="#home" class="nav-link">Home</a>
                    <a href="#about" class="nav-link">About</a>
                    <a href="#projects" class="nav-link">Projects</a>
                    <button type="button" onclick="mkChat.toggle()" class="nav-link flex items-center gap-2 text-cyan-400 hover:text-cyan-300">
                        <i class="fas fa-robot"></i> AI Assistant
                    </button>
                    <a href="#contact" class="bg-cyan-500 hover:bg-cyan-400 text-gray-900 font-bold py-2 px-4 rounded-lg transition-all duration-300 transform hover:scale-105">Contact</a>
                </div>
                
                <!-- Mobile Menu Button -->
                <button class="lg:hidden text-white text-2xl" id="mobile-menu-button" onclick="toggleMobileMenu()">
                    <i class="fas fa-bars" id="menu-icon"></i>
                </button>
            </div>
            
            <!-- Mobile Navigation Menu -->
            <div class="lg:hidden mt-4 pb-4 border-t border-gray-700 hidden" id="mobile-menu">
                <div class="flex flex-col space-y-4 pt-4">
                    <a href="#home" class="nav-link text-center">Home</a>
                    <a href="#about" class="nav-link text-center">About</a>
                    <a href="#projects" class="nav-link text-center">Projects</a>
                    <button type="button" onclick="mkChat.toggle()" class="nav-link text-center text-cyan-400">
                        <i class="fas fa-robot mr-2"></i>AI Assistant
                    </button>
                    <a href="#contact" class="nav-link text-center">Contact</a>
                    <div class="flex justify-center gap-4 pt-2">
                        <a href="#contact" aria-label="Contact" class="text-cyan-400 hover:text-white text-xl"><i class="fas fa-envelope"></i></a>
                        <a href="https://github.com/DynoAbd786" target="_blank" aria-label="GitHub" class="text-cyan-400 hover:text-white text-xl"><i class="fab fa-github"></i></a>
                        <a href="https://linkedin.com/in/dynoabd786" target="_blank" aria-label="LinkedIn" class="text-cyan-400 hover:text-white text-xl"><i class="fab fa-linkedin"></i></a>
                        <a href="/docs/Muhammad-Kashif-Khan-CV.pdf?v=2026-07" target="_blank" aria-label="Download CV" class="text-cyan-400 hover:text-white text-xl"><i class="fas fa-file-pdf"></i></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>


    <main>
        @Body
    </main>

    <footer class="bg-gray-900 mt-16 py-8 border-t border-gray-800">
        <div class="container mx-auto text-center text-gray-500">
            <p>&copy; @DateTime.Now.Year Muhammad Kashif-Khan. Built with Blazor & ❤️.</p>
        </div>
    </footer>

    @* data-permanent keeps enhanced navigation from touching anything inside, so the panel's
       open/full-screen classes (set by site.js) and the running chat survive page changes *@
    <div id="chat-root" data-permanent>
        <!-- AI Assistant Side Panel -->
        <div id="chat-panel" class="fixed inset-y-0 right-0 z-[60] bg-gray-900 border-l border-gray-700 shadow-2xl transform transition-transform duration-300 ease-in-out translate-x-full flex flex-col w-full sm:w-[450px]">
            <div class="bg-gray-800 p-4 flex justify-between items-center border-b border-gray-700">
                <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
                    <div>
                        <span class="font-bold text-lg text-white block">AI Assistant</span>
                        <span class="text-xs text-gray-400">Powered by Gemini & Local LLMs</span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="chat-fullscreen" onclick="mkChat.toggleFullScreen()" class="text-gray-400 hover:text-white transition-colors p-2 rounded-full hover:bg-gray-700" title="Full Screen">
                        <i class="fas fa-expand text-lg"></i>
                    </button>
                    <button type="button" onclick="mkChat.toggle()" aria-label="Close AI Assistant" class="text-gray-400 hover:text-white transition-colors p-2 rounded-full hover:bg-gray-700">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
            </div>
            <div class="flex-1 overflow-hidden relative">
                @* Shown until AiTerminal renders beside it (hidden by .chat-loading:not(:only-child) in app.css) *@
                <div class="chat-loading absolute inset-0 flex items-center justify-center text-gray-400 text-sm">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Starting assistant...
                </div>
                @* Interactive in the browser; not prerendered because it lives in localStorage *@
                <AiTerminal @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
            </div>
        </div>

        <!-- Backdrop for mobile -->
        <div id="chat-backdrop" class="fixed inset-0 bg-black/50 z-[55] backdrop-blur-sm hidden" onclick="mkChat.toggle()"></div>
    </div>
</div>

