@page "/projects/synergy"
@using website.Data

<ProjectPage Url="/projects/workflow-graph-platform" Kicker="Personal Project">
                <ProjectSection Title="Current status" Subtitle="In development · local-first: it runs on your own machine, against your own code" Icon="fas fa-circle-half-stroke">
                    <div class="grid gap-6 md:grid-cols-2">
                        <div>
                            <h3 class="mb-3 font-bold text-slate-100">What works today</h3>
                            <ul class="space-y-2 text-sm text-slate-300">
                                <li>• Parses Python, C#, Java, Go, C++, Rust, JavaScript and TypeScript into one typed graph of modules, symbols and dependencies</li>
                                <li>• Incremental analysis: unchanged files are skipped, and the result matches a full re-analysis</li>
                                <li>• Revision history, snapshots of any git commit, and structural diffs ranked by blast radius</li>
                                <li>• Call-flow diagrams from any entry point, and runtime traces that check the static graph against a real run</li>
                                <li>• An MCP server with 17 tools, so coding agents ask about structure instead of grepping text</li>
                                <li>• One command wires it into Claude Code (hooks, a skill and the server config), with an AGENTS.md for other agents</li>
                                <li>• A web dashboard: graph explorer, history diffs, UML and an agent's-eye view</li>
                            </ul>
                        </div>
                        <div class="space-y-6">
                            <div>
                                <h3 class="mb-3 font-bold text-slate-100">Built with</h3>
                                <div class="flex flex-wrap gap-2">
                                    <span class="chip">Python</span>
                                    <span class="chip">FastAPI</span>
                                    <span class="chip">tree-sitter</span>
                                    <span class="chip">SQLite</span>
                                    <span class="chip">React</span>
                                    <span class="chip">TypeScript</span>
                                    <span class="chip">MCP</span>
                                </div>
                            </div>
                            <div>
                                <h3 class="mb-3 font-bold text-slate-100">Next</h3>
                                <ul class="space-y-2 text-sm text-slate-300">
                                    <li>• Agent setup: measuring whether an agent that was never told about Synergy actually reaches for the graph</li>
                                    <li>• Call-flow precision: the calls Python makes implicitly, and flows that show only the interfaces they pass through</li>
                                    <li>• Packaging: a release that installs with one command instead of from source</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <h2 class="pt-4 text-3xl font-bold text-white">How it started</h2>

                <!-- Project Status & Research Context -->
                <ProjectSection Title="Project Status & Context" Icon="fas fa-info-circle">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">Current Stage: Active Personal Research</h3>
                        </div>
                        <p class="text-gray-300 leading-relaxed">
                            This is an independent technical research initiative exploring graph-based code analysis and LLM knowledge enhancement. Originally conceived for academic collaboration, the project has been refocused as a personal research endeavor with potential for future publication and open-source contribution. The work explores innovative approaches to bridging the gap between static code organization and dynamic workflow understanding, with particular emphasis on version-specific package analysis and token-efficient AI assistance.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Development Timeline</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• <strong>Conceptualization:</strong> October 2025</li>
                                <li>• <strong>Architecture Design:</strong> Ongoing</li>
                                <li>• <strong>Implementation:</strong> Progressive development</li>
                                <li>• <strong>Approach:</strong> Modular, iterative research</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Research Focus</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• Open-source package/library analysis</li>
                                <li>• LLM knowledge gap mitigation</li>
                                <li>• Version-specific code understanding</li>
                                <li>• Token-efficient AI assistance</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- The Problem: Code Understanding Challenges -->
                <ProjectSection Title="The Problem" Icon="fas fa-exclamation-triangle">
                    <p class="text-gray-300 mb-6">Developers and AI assistants struggle with unfamiliar codebases. Existing tools show directory structures ("where code lives") but fail to capture behavior ("how code works").</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-folder-tree mr-3"></i>Current Tool Limitations
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>File-centric organization:</strong> Shows directory structure, not workflows</li>
                                <li><strong>Static documentation:</strong> Quickly outdated, missing system-level interactions</li>
                                <li><strong>Fragmented relationships:</strong> Only immediate connections visible</li>
                                <li><strong>Lost architectural context:</strong> No project philosophy or team culture captured</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-robot mr-3"></i>AI Assistant Challenges
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>Version Mismatch:</strong> Hallucinating APIs from wrong package versions</li>
                                <li><strong>New Package Blindness:</strong> No knowledge of recently released libraries</li>
                                <li><strong>Confabulation:</strong> Plausible but incorrect code generation</li>
                                <li><strong>Missing Architectural Context:</strong> Code that works but violates team patterns</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Critical Impact</h3>
                        <p class="text-gray-300">
                            AI assistants lack Architectural Context: they don't know if your team prefers composition over inheritance, whether you use dependency injection patterns, or which design principles guide your codebase. This leads to syntactically correct code that violates team culture and architectural philosophy, requiring extensive manual refactoring.
                        </p>
                    </div>
                </ProjectSection>

                <!-- Proposed Solution: Hybrid C#/.NET Architecture -->
                <ProjectSection Title="The Solution: Hybrid C#/.NET + Python Architecture" Icon="fas fa-lightbulb">

                    <p class="text-gray-300 mb-6">A hybrid platform that transforms codebases into queryable graphs, combining Python's data science ecosystem for deep analysis with C#/.NET's enterprise-grade infrastructure for robust APIs and UI:</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Deep Analysis (Python Microservice)</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• <strong>Doxygen + AST Pipeline:</strong> Extract entities (classes, functions) and relationships</li>
                                <li>• <strong>Structural & Behavioral Graphs:</strong> UML-inspired dual-level analysis</li>
                                <li>• <strong>Philosophy Metadata:</strong> Tag packages with architectural context</li>
                                <li>• <strong>Workflow Extraction:</strong> Trace execution paths and call sequences</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-cyan-600/25">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Architectural Intelligence (C# ASP.NET Core)</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• <strong>API Gateway:</strong> Enterprise-grade REST endpoints for graph queries</li>
                                <li>• <strong>MCP Host (McpController):</strong> JSON-RPC 2.0 protocol for AI agents</li>
                                <li>• <strong>Refactoring Service:</strong> Active detection of God Classes and violations</li>
                                <li>• <strong>Python Bridge:</strong> IGraphProvider service consuming Python output</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Core Innovation: The "Architectural Linter"</h3>
                        <p class="text-gray-300">
                            Moving beyond simple code mapping to <strong>Architectural Linter capabilities</strong>. The C# RefactoringService doesn't just show the graph—it critiques it based on complexity metrics (Cyclomatic Complexity, Fan-Out) and defined project philosophies, accessible directly by LLMs via MCP. AI agents can ask: "Where are the God Classes?" and receive data-backed RefactoringCandidate objects with specific architectural violations.
                        </p>
                    </div>
                </ProjectSection>

