@page "/projects/c-programming"
@using website.Data


<ProjectPage Url="/projects/c-programming" Kicker="Academic Project · Year 1">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A set of C programs for three custom image file formats, with compression schemes that work down at the bit level.
                </p>
                <!-- Project Overview & Scope -->
                <ProjectSection Title="Project Overview" Icon="fas fa-project-diagram">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">Two-Part Coursework System</h3>
                        </div>
                        <p class="text-slate-300 leading-relaxed">
                            I wrote this across two pieces of coursework that formed the foundation of the systems programming module.
                            The task was to implement custom image file formats in C, then write the tools to read, compare, convert and
                            compress them, mostly with low-level memory and bit operations.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Coursework 1 - Foundation (50%)</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• 10 executable programs</li>
                                <li>• 3 custom file formats (EBF, EBU, EBC)</li>
                                <li>• Echo, Compare, Convert utilities</li>
                                <li>• Modular code with explicit memory management</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Coursework 2 - Advanced (50%)</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• 6 additional compression programs</li>
                                <li>• Block-based lossy compression (9x reduction)</li>
                                <li>• Random block algorithms using a seeded generator</li>
                                <li>• Averaging over 3x3 pixel blocks</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Custom File Formats Deep Dive -->
                <ProjectSection Title="Custom File Format Architecture" Icon="fas fa-file-code">

                    <!-- File Format Specifications -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-layer-group mr-3"></i>EBF Format
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">Purpose:</strong> Base image format
                                </div>
                                <div>
                                    <strong class="text-white">Pixel Range:</strong> 0-31 (black to white)
                                </div>
                                <div>
                                    <strong class="text-white">Structure:</strong>
                                    <ul class="mt-1 space-y-1 text-slate-400">
                                        <li>• Magic number identifier</li>
                                        <li>• Width and height metadata</li>
                                        <li>• Raw pixel data array</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-compress mr-3"></i>EBU Format
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">Purpose:</strong> Binary compression
                                </div>
                                <div>
                                    <strong class="text-white">Compression:</strong> ~50% size reduction
                                </div>
                                <div>
                                    <strong class="text-white">Method:</strong>
                                    <ul class="mt-1 space-y-1 text-slate-400">
                                        <li>• Remove first byte of each pixel</li>
                                        <li>• Convert to binary representation</li>
                                        <li>• Preserve metadata structure</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-compress-alt mr-3"></i>EBC Format
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">Purpose:</strong> Tighter compression
                                </div>
                                <div>
                                    <strong class="text-white">Compression:</strong> 5/8 ratio (62.5%)
                                </div>
                                <div>
                                    <strong class="text-white">Method:</strong>
                                    <ul class="mt-1 space-y-1 text-slate-400">
                                        <li>• 5-bit pixel packing</li>
                                        <li>• Bit shifting across byte boundaries</li>
                                        <li>• No unused bits stored</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Technical Implementation Example -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">EBC Compression Algorithm Example</h3>
                        <div class="bg-ink rounded-lg p-4 font-mono text-sm">
                            <div class="text-cy mb-2">// Pixel values: 30, 30, 30</div>
                            <div class="text-slate-300 mb-4">
                                <span class="text-cy">EBU format:</span> 00011110 00011110 00011110<br/>
                                <span class="text-cy">EBC format:</span> 11110|111 10|11110|0<br/>
                                <span class="text-cy">// 5-bit packing: first pixel (11110) + part of second (111)</span>
                            </div>
                            <div class="text-cy mb-2">// Core compression function</div>
                            <div class="text-slate-300">
                                <span class="text-cy">BYTE</span> *<span class="text-cy">convertEbu2Ebc</span>(<span class="text-cy">BYTE</span> *uncompressed, <span class="text-cy">BYTE</span> *compressed, <span class="text-cy">int</span> numBytes)<br/>
                                {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">BYTE</span> storageByte = <span class="text-cy">0</span>;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">int</span> bitPosition = <span class="text-cy">0</span>;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">// Pack 5 bits per pixel using bitwise operations</span><br/>
                                }
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Advanced Algorithms & Techniques -->
                <ProjectSection Title="Advanced Compression Algorithms" Icon="fas fa-cogs">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Block-Based Lossy Compression</h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>Programs:</strong> ebcBlock, ebcUnblock</div>
                                <div><strong>Method:</strong> 3x3 pixel block averaging</div>
                                <div><strong>Compression:</strong> 9x size reduction</div>
                                <div>
                                    <strong>Process:</strong>
                                    <ul class="mt-2 space-y-1 text-slate-400">
                                        <li>• Divide image into 3x3 pixel blocks</li>
                                        <li>• Calculate average pixel value per block</li>
                                        <li>• Store one value for the whole block</li>
                                        <li>• Rebuild the image by expanding each average</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Random Block Algorithms</h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>Programs:</strong> ebcR32, ebcR128, ebcU32, ebcU128</div>
                                <div><strong>Method:</strong> Seeded random selection</div>
                                <div><strong>Block Counts:</strong> 32 or 128 random selections</div>
                                <div>
                                    <strong>Algorithm:</strong>
                                    <ul class="mt-2 space-y-1 text-slate-400">
                                        <li>• Select random 3x3 blocks (seeded)</li>
                                        <li>• Map blocks to image positions</li>
                                        <li>• Process the image by similarity matching</li>
                                        <li>• Run the process in reverse to decompress</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Code Structure Example -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Data Structure Design</h3>
                        <div class="bg-ink rounded-lg p-4 font-mono text-sm">
                            <div class="text-cy mb-2">// Custom data structures for each format</div>
                            <div class="text-slate-300">
                                <span class="text-cy">typedef struct</span> {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">unsigned char</span> magicNumber[<span class="text-cy">2</span>];<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">int</span> width, height;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">long</span> numBytes;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">unsigned int</span> **imageData;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">unsigned int</span> *dataBlock;<br/>
                                } <span class="text-cy">ebfData</span>;<br/><br/>

                                <span class="text-cy">typedef</span> <span class="text-cy">uint8_t</span> <span class="text-cy">BYTE</span>; <span class="text-cy">// Better readability</span>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

