@code {
    private static readonly List<GalleryItem> GalleryItems = new()
    {
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/vessel-with-io.png", 
            Title = "1. Initial Vessel Processing", 
            Description = "The sample vessel is loaded and its inlet and outlet are found and capped automatically. This keeps the mesh topology intact, which later fluid simulations need to set valid boundary conditions."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/vessel-centerlines.png", 
            Title = "2. Centerline Computation", 
            Description = "Centerlines are computed by wave propagation from a seed point the user picks. The <span class=\"text-blue-400 font-bold\">blue line</span> marks the aneurysm sac, separate from the main path of the artery."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/parent-vessel-extraction.png", 
            Title = "3. Parent Vessel Extraction", 
            Description = "Tracing along the centerline isolates the parent vessel. This separates the healthy artery from the aneurysm and gives the exact \"landing zone\" where the flow diverter has to sit."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/mock-stent.png", 
            Title = "4. Mock Device Generation", 
            Description = "A test \"mock stent\" lattice, generated to check the deployment logic. It is fitted across the parent vessel to see whether the algorithm can bend a rigid mesh to follow the vessel's curves."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/failed-stent-fitting.png", 
            Title = "5. Deployment Simulation Status", 
            Description = "Where the stent fitting algorithm (Paliwal's VSW method) stood at the end. The deployment is incomplete: simulating physics-based wall apposition and collision detection proved too computationally complex to finish in the time available."
        }
    };
}
