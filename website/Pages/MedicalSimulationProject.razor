@code {
    private static readonly List<GalleryItem> GalleryItems = new()
    {
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/vessel-with-io.png", 
            Title = "1. Initial Vessel Processing", 
            Description = "The raw sample vessel geometry is loaded into the pipeline, where the input and output boundaries are automatically detected and capped. This topology-preservation step is crucial for defining valid boundary conditions for subsequent fluid simulations."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/vessel-centerlines.png", 
            Title = "2. Centerline Computation", 
            Description = "Vascular centerlines are computationally calculated using wave-propagation from a user-defined seed point. The <span class=\"text-blue-400 font-bold\">blue line</span> explicitly identifies the aneurysm sac, distinguishing it from the main arterial flow path."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/parent-vessel-extraction.png", 
            Title = "3. Parent Vessel Extraction", 
            Description = "The parent vessel geometry is mathematically isolated by tracing along the computed centerline. This effectively separates the healthy artery from the pathology, defining the precise \"landing zone\" required for the flow diverter."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/mock-stent.png", 
            Title = "4. Mock Device Generation", 
            Description = "An experimental \"mock stent\" lattice generated to validate the deployment logic. Designed to be fitted across the parent vessel, this parametric model tests the algorithm's ability to adapt rigid mesh structures to biological curvature."
        },
        new GalleryItem 
        { 
            ImagePath = "images/medical-simulation/failed-stent-fitting.png", 
            Title = "5. Deployment Simulation Status", 
            Description = "Current state of the stent fitting algorithm (implementing the Paliwal VSW method). The incomplete deployment highlights the immense computational complexity of simulating physics-based wall apposition and collision detection within the project's timeframe."
        }
    };
}
