@page "/projects/medical-simulation"
@using website.Data


<ProjectPage Url="/projects/medical-simulation" Kicker="Professional Experience">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    Advanced biomedical research platform for simulating flow diverter stent deployment in patient-specific vascular geometries
                </p>
                
                <!-- Project Overview & Scope -->
                <ProjectSection Title="Project Overview & Scope" Icon="fas fa-heartbeat">
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This modern research platform combines 3D vascular mesh visualization, VMTK-based vessel analysis, and physics-driven stent expansion algorithms to support aneurysm treatment planning, medical device research and development, and biomedical engineering education. The project extends upon the foundational 2016 Paliwal Virtual Stenting Workflow (VSW) algorithm, bringing cutting-edge computational methods to contemporary medical simulation.
                    </p>
