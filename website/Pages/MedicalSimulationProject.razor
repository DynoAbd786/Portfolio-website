@page "/projects/medical-simulation"
@using website.Data


<ProjectPage Url="/projects/medical-simulation" Kicker="Professional Experience">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A research tool for simulating how a flow diverter stent deploys inside a patient's own blood vessel geometry. I built its foundations in an 8-week internship; the full deployment is still unfinished.
                </p>
                
                <!-- Project Overview & Scope -->
                <ProjectSection Title="Project Overview & Scope" Icon="fas fa-heartbeat">
                    <p class="text-slate-300 text-lg leading-relaxed mb-6">
                        The platform brings together 3D vessel mesh visualization, vessel analysis with VMTK, and a physics-based stent expansion algorithm. It is meant to support aneurysm treatment planning, medical device R&D and biomedical engineering teaching. It extends Paliwal's 2016 Virtual Stenting Workflow (VSW) algorithm using current computational methods.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Research Applications</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-user-md text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Clinical Planning</h4>
                                <p class="text-slate-400 text-sm">Helping plan aneurysm treatment and inform surgical decisions</p>
                            </div>
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-flask text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Device R&D</h4>
                                <p class="text-slate-400 text-sm">Testing stent designs during device research and development</p>
                            </div>
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-graduation-cap text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Education</h4>
                                <p class="text-slate-400 text-sm">Teaching and training in biomedical engineering</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Technical Architecture & Implementation -->
                <ProjectSection Title="Technical Architecture" Icon="fas fa-cogs">
                    
                    <!-- Core System Components -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-cube mr-3"></i>Physics Engine
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Joint-level expansion:</strong> forces applied at each wire joint, so the stent opens the way a real one does</li>
                                <li><strong>Forces:</strong> the wires expand according to a physics model</li>
                                <li><strong>Collision detection:</strong> stopping the stent where it meets the vessel wall, started but not finished</li>
                                <li><strong>Conformity:</strong> fitting the stent to the vessel's shape, also unfinished</li>
                            </ul>
                        </div>
                        
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-eye mr-3"></i>Visualization Pipeline
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>GPU:</strong> rendering runs on NVIDIA CUDA</li>
                                <li><strong>PyVista/VTK:</strong> used for all the 3D views</li>
                                <li><strong>Interactive meshes:</strong> vessels can be moved and inspected in real time</li>
                                <li><strong>Multi-scale view:</strong> from the whole vessel down to microscopic detail</li>
                            </ul>
                        </div>
                        
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-heartbeat mr-3"></i>Medical Imaging
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>VMTK:</strong> analyses and reconstructs the vessel</li>
                                <li><strong>Centerlines:</strong> the path through each vessel is found automatically</li>
                                <li><strong>Geometry:</strong> builds patient-specific meshes</li>
                                <li><strong>File formats:</strong> reads DICOM, STL and VTK</li>
                            </ul>
                        </div>
                        
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-desktop mr-3"></i>User Interface
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>PyQt6:</strong> a desktop application</li>
                                <li><strong>Layers:</strong> each layer handles one concern</li>
                                <li><strong>Data:</strong> results are managed and exported as HDF5</li>
                                <li><strong>Platforms:</strong> runs on Linux and Windows</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Device Repository -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Device Repository</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <h4 class="font-bold text-white mb-2">Enterprise Stents</h4>
                                <ul class="text-slate-400 text-sm space-y-1">
                                    <li>• Codman Enterprise VRD</li>
                                    <li>• Wires that behave like the real device</li>
                                    <li>• Porosity that varies along the stent</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">Pipeline Devices</h4>
                                <ul class="text-slate-400 text-sm space-y-1">
                                    <li>• Pipeline Embolization Device</li>
                                    <li>• Models how it diverts flow</li>
                                    <li>• Simulates the braided structure</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">Silk Stents</h4>
                                <ul class="text-slate-400 text-sm space-y-1">
                                    <li>• Silk Vista Baby FD</li>
                                    <li>• Models its very fine wires</li>
                                    <li>• Analyses deployment forces</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

