                                    <i class="fas fa-user-md text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Clinical Planning</h4>
                                <p class="text-gray-400 text-sm">Aneurysm treatment planning and surgical decision support</p>
                            </div>
