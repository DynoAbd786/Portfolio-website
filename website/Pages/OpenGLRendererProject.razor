@page "/projects/opengl-renderer"
@using website.Data

<ProjectPage Url="/projects/opengl-renderer" Kicker="Academic Project">
                
                <!-- Project Overview -->
                <ProjectSection Title="Project Overview" Icon="fas fa-cube">
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This advanced computer graphics coursework involved developing a comprehensive 3D rendering application using modern OpenGL.
                        Built as a collaborative project, the application implements the complete projective graphics pipeline to create an
                        interactive visualization of a space launch platform near the Finnish archipelago, combining real-world elevation data
                        with sophisticated rendering techniques.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-project-diagram text-cy mr-3"></i>Graphics Pipeline
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Matrix Operations:</strong> 4x4 transformations and projections</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Camera Systems:</strong> First-person and tracking cameras</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Coordinate Transforms:</strong> World, view, projection spaces</span>
                                    </li>
                                     <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Modern OpenGL:</strong> Shader-based rendering pipeline</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-lightbulb text-cy mr-3"></i>Lighting & Materials
                                </h3>
                                 <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Blinn-Phong Shading:</strong> Full specular reflection model</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Point Lights:</strong> Multiple colored lights with attenuation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Material Properties:</strong> Per-object color and texture support</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Texture Mapping:</strong> Orthophoto terrain texturing</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Advanced Rendering Features -->
                <ProjectSection Title="Advanced Rendering Features" Icon="fas fa-rocket">
                    <div class="grid md:grid-cols-2 gap-6">
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Terrain & Instancing</h4>
                             <p class="text-gray-300 text-sm">
                                 Rendered real Finnish elevation data (6km x 6km) with orthophoto textures.
                                 Used instanced rendering for placing multiple launchpads efficiently without data duplication.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Procedural Models</h4>
                             <p class="text-gray-300 text-sm">
                                 Programmatically generated space vehicles using geometric primitives with proper normal generation
                                 for realistic lighting interactions and procedural modeling.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Animation System</h4>
                             <p class="text-gray-300 text-sm">
                                 Keyframe-based vehicle animation with curved flight paths, gradual acceleration, and rotation alignment. 
                                 Interactive controls for play, pause, and reset.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Particles & Split-Screen</h4>
                             <p class="text-gray-300 text-sm">
                                 Exhaust particle system with textured point sprites and additive blending.
                                 Dual viewport split-screen rendering with independent camera control.
                             </p>
                         </div>
                    </div>
                </ProjectSection>

                <!-- Performance Analysis -->
                <ProjectSection Title="Performance & Optimization" Icon="fas fa-tachometer-alt">
                    <p class="text-gray-300 leading-relaxed mb-6">
                        Implemented comprehensive GPU profiling using OpenGL timestamp queries to measure per-frame rendering time and individual component performance.
                        Optimized rendering efficiency through batching, minimized state changes, and efficient memory management.
                    </p>
                     <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">GPU Profiling</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• GL_TIMESTAMP queries</li>
                                 <li>• Per-frame timing</li>
                                 <li>• Non-blocking retrieval</li>
                             </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Resource Mgmt</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Efficient allocation</li>
                                 <li>• Resource cleanup</li>
                                 <li>• No runtime allocs</li>
                             </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Efficiency</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Minimized draw calls</li>
                                 <li>• Uniform buffers</li>
                                 <li>• Viewport culling</li>
                             </ul>
                        </div>
                     </div>
                </ProjectSection>

                <!-- Technical Implementation & Specs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Tech Implementation -->
                    <ProjectSection Title="Tech Implementation" Icon="fas fa-code">
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">OpenGL Features</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• VAO/VBO/EBO management</li>
                                    <li>• Texture mipmapping</li>
                                    <li>• Uniform Buffer Objects</li>
                                    <li>• Framebuffer Objects</li>
                                    <li>• Alpha blending</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">UI & Interaction</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• Custom 2D UI elements</li>
                                    <li>• Real-time altitude display</li>
                                    <li>• Interactive camera controls</li>
                                    <li>• WASD + Mouse navigation</li>
                                </ul>
                            </div>
                        </div>
                </ProjectSection>

                    <!-- Technical Specs & Collaboration -->
                     <ProjectSection Title="Specs & Collaboration" Icon="fas fa-cogs">
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">Core Tech</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• C++17 Standards</li>
                                    <li>• OpenGL 4.0+ API</li>
                                    <li>• GLFW Windowing</li>
                                    <li>• Premake5 Build</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">Collaboration</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• Pair programming execution</li>
                                    <li>• Modular architecture design</li>
                                    <li>• Git version control flow</li>
                                </ul>
                            </div>
                        </div>
                </ProjectSection>
                </div>


                <!-- GitHub Repository -->
                <div class="rounded-2xl p-8 border border-gray-700/50 hover:border-cy/50 transition-all text-center md:text-left bg-white/[.02]">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center">
                            <div class="bg-white/[.02] rounded-full p-4 mr-4 hidden md:block">
                                <i class="fab fa-github text-white text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-1">Source Code Repository</h3>
                                <p class="text-gray-400">Complete 3D renderer implementation with advanced features</p>
                            </div>
                        </div>
                        <a href="https://github.com/DynoAbd786/graphics-cw2" target="_blank"
                           class="inline-flex items-center px-6 py-3 rounded-lg bg-cy/10 hover:bg-green-500 text-white font-medium transition-colors shadow-lg shadow-green-900/20">
                            <i class="fab fa-github mr-2"></i>View on GitHub
                        </a>
                    </div>
                </div>
            
</ProjectPage>