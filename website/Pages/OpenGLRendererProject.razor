@page "/projects/opengl-renderer"
@using website.Data

<ProjectPage Url="/projects/opengl-renderer" Kicker="Academic Project">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    Computer Graphics Coursework 2. A 3D renderer in modern OpenGL that implements the full projective graphics pipeline. It renders real terrain with lighting, and includes a space launch you can control.
                </p>
                
                <!-- Project Overview -->
                <ProjectSection Title="Project Overview" Icon="fas fa-cube">
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        We built this 3D renderer in modern OpenGL as a team project for computer graphics coursework.
                        It implements the complete projective graphics pipeline and uses it to show a space launch platform
                        near the Finnish archipelago, built on real elevation data. You can move around the scene
                        and watch the launch interactively.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-project-diagram text-cy mr-3"></i>Graphics Pipeline
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Matrices:</strong> 4x4 transformations and projections</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Cameras:</strong> a first-person camera and a tracking camera</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Coordinate spaces:</strong> world, view and projection</span>
                                    </li>
                                     <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Modern OpenGL:</strong> everything is drawn through shaders</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-lightbulb text-cy mr-3"></i>Lighting & Materials
                                </h3>
                                 <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Blinn-Phong shading:</strong> the full model, specular highlights included</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Point lights:</strong> several coloured lights that fade with distance</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Materials:</strong> each object has its own colour and texture</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cy mt-1 mr-3"></i>
                                        <span><strong>Textures:</strong> orthophotos draped over the terrain</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Advanced Rendering Features -->
                <ProjectSection Title="Advanced Rendering Features" Icon="fas fa-rocket">
                    <div class="grid md:grid-cols-2 gap-6">
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Terrain & Instancing</h4>
                             <p class="text-gray-300 text-sm">
                                 The terrain is real Finnish elevation data covering 6km x 6km, textured with orthophotos.
                                 Several launchpads are drawn with instanced rendering, so their mesh data is stored only once.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Procedural Models</h4>
                             <p class="text-gray-300 text-sm">
                                 The space vehicles are built in code from geometric primitives.
                                 Each one gets correct normals, so lighting falls on it realistically.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Animation System</h4>
                             <p class="text-gray-300 text-sm">
                                 The vehicle is animated with keyframes. It follows a curved flight path, speeds up gradually and turns to face the way it is going.
                                 You can play, pause and reset the launch.
                             </p>
                         </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Particles & Split-Screen</h4>
                             <p class="text-gray-300 text-sm">
                                 Exhaust is a particle system of textured point sprites with additive blending.
                                 The screen can split into two viewports, each with its own camera.
                             </p>
                         </div>
                    </div>
                </ProjectSection>

                <!-- Performance Analysis -->
                <ProjectSection Title="Performance & Optimization" Icon="fas fa-tachometer-alt">
                    <p class="text-gray-300 leading-relaxed mb-6">
                        We profiled the GPU with OpenGL timestamp queries, timing each frame and each part of the scene separately.
                        Batching draws, cutting down state changes and managing memory carefully made rendering faster.
                    </p>
                     <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">GPU Profiling</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• GL_TIMESTAMP queries</li>
                                 <li>• Timing for every frame</li>
                                 <li>• Results read without stalling</li>
                             </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Resource Mgmt</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Careful allocation</li>
                                 <li>• Resources cleaned up properly</li>
                                 <li>• No allocations while running</li>
                             </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                             <h4 class="text-xl font-bold text-slate-100 mb-3">Efficiency</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Fewer draw calls</li>
                                 <li>• Uniform buffers</li>
                                 <li>• Viewport culling</li>
                             </ul>
                        </div>
                     </div>
                </ProjectSection>

                <!-- Technical Implementation & Specs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Tech Implementation -->
                    <ProjectSection Title="Tech Implementation" Icon="fas fa-code">
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">OpenGL Features</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• VAO/VBO/EBO management</li>
                                    <li>• Texture mipmapping</li>
                                    <li>• Uniform Buffer Objects</li>
                                    <li>• Framebuffer Objects</li>
                                    <li>• Alpha blending</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">UI & Interaction</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• Custom 2D UI elements</li>
                                    <li>• Live altitude readout</li>
                                    <li>• Camera controls</li>
                                    <li>• WASD and mouse to move around</li>
                                </ul>
                            </div>
                        </div>
                </ProjectSection>

                    <!-- Technical Specs & Collaboration -->
                     <ProjectSection Title="Specs & Collaboration" Icon="fas fa-cogs">
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">Core Tech</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• C++17</li>
                                    <li>• OpenGL 4.0+</li>
                                    <li>• GLFW for windowing</li>
                                    <li>• Premake5 for the build</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-slate-100 text-sm mb-2">Collaboration</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-line">
                                    <li>• Written through pair programming</li>
                                    <li>• Split into modules</li>
                                    <li>• Shared through Git</li>
                                </ul>
                            </div>
                        </div>
                </ProjectSection>
                </div>


                <!-- GitHub Repository -->
                <div class="rounded-2xl p-8 border border-gray-700/50 hover:border-cy/50 transition-all text-center md:text-left bg-white/[.02]">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center">
                            <div class="bg-white/[.02] rounded-full p-4 mr-4 hidden md:block">
                                <i class="fab fa-github text-white text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-1">Source Code Repository</h3>
                                <p class="text-gray-400">The full source of the 3D renderer</p>
                            </div>
                        </div>
                        <a href="https://github.com/DynoAbd786/graphics-cw2" target="_blank"
                           class="btn-ghost">
                            <i class="fab fa-github mr-2"></i>View on GitHub
                        </a>
                    </div>
                </div>
            
</ProjectPage>