@page "/projects/opengl-renderer"
@using website.Data

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-green-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-green-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">3D OpenGL Renderer</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-green-500 to-teal-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Academic Project
            </div>
            <h1 class="text-5xl font-bold text-white mb-4">3D OpenGL Renderer</h1>
            <h2 class="text-2xl text-gray-400 mb-6">Advanced Projective Graphics Pipeline</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                Computer Graphics Coursework 2 - Advanced 3D rendering application implementing the complete projective graphics pipeline with modern OpenGL, featuring terrain visualization, lighting models, and interactive space launch simulation.
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">Modern OpenGL</span>
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">C++17</span>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">GLSL</span>
                <span class="bg-yellow-600 text-white px-4 py-2 rounded-full text-sm">GLFW</span>
                <span class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm">Performance Profiling</span>
            </div>
        </div>

        <!-- Hero Visual -->
        <div class="bg-gradient-to-r from-green-900 to-teal-900 rounded-lg p-12 mb-16 text-center border border-gray-700">
            <div class="text-8xl mb-4">🧊</div>
             <p class="text-white/75 text-lg">3D Rendering Pipeline • Shader Programming • Terrain Instancing • Physics Engine</p>
        </div>

        <div class="max-w-6xl mx-auto">
            <!-- Main Content Sections -->
            <div class="grid grid-cols-1 gap-8">
                
                <!-- Project Overview -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-full p-3 mr-4">
                            <i class="fas fa-cube text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-green-400">Project Overview</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This advanced computer graphics coursework involved developing a comprehensive 3D rendering application using modern OpenGL.
                        Built as a collaborative project, the application implements the complete projective graphics pipeline to create an
                        interactive visualization of a space launch platform near the Finnish archipelago, combining real-world elevation data
                        with sophisticated rendering techniques.
                    </p>
                    <div class="bg-gray-800 rounded-lg p-6 border border-green-500/25">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-project-diagram text-green-400 mr-3"></i>Graphics Pipeline
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Matrix Operations:</strong> 4x4 transformations and projections</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Camera Systems:</strong> First-person and tracking cameras</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Coordinate Transforms:</strong> World, view, projection spaces</span>
                                    </li>
                                     <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Modern OpenGL:</strong> Shader-based rendering pipeline</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-lightbulb text-green-400 mr-3"></i>Lighting & Materials
                                </h3>
                                 <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Blinn-Phong Shading:</strong> Full specular reflection model</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Point Lights:</strong> Multiple colored lights with attenuation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Material Properties:</strong> Per-object color and texture support</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-green-500 mt-1 mr-3"></i>
                                        <span><strong>Texture Mapping:</strong> Orthophoto terrain texturing</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Advanced Rendering Features -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-blue-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-full p-3 mr-4">
                            <i class="fas fa-rocket text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-blue-400">Advanced Rendering Features</h2>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                         <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                             <h4 class="text-xl font-bold text-blue-400 mb-3">Terrain & Instancing</h4>
                             <p class="text-gray-300 text-sm">
                                 Rendered real Finnish elevation data (6km x 6km) with orthophoto textures.
                                 Used instanced rendering for placing multiple launchpads efficiently without data duplication.
                             </p>
                         </div>
                         <div class="bg-gray-800 rounded-lg p-6 border border-green-600/25">
                             <h4 class="text-xl font-bold text-green-400 mb-3">Procedural Models</h4>
                             <p class="text-gray-300 text-sm">
                                 Programmatically generated space vehicles using geometric primitives with proper normal generation
                                 for realistic lighting interactions and procedural modeling.
                             </p>
                         </div>
                         <div class="bg-gray-800 rounded-lg p-6 border border-yellow-600/25">
                             <h4 class="text-xl font-bold text-yellow-400 mb-3">Animation System</h4>
                             <p class="text-gray-300 text-sm">
                                 Keyframe-based vehicle animation with curved flight paths, gradual acceleration, and rotation alignment. 
                                 Interactive controls for play, pause, and reset.
                             </p>
                         </div>
                         <div class="bg-gray-800 rounded-lg p-6 border border-red-600/25">
                             <h4 class="text-xl font-bold text-red-400 mb-3">Particles & Split-Screen</h4>
                             <p class="text-gray-300 text-sm">
                                 Exhaust particle system with textured point sprites and additive blending.
                                 Dual viewport split-screen rendering with independent camera control.
                             </p>
                         </div>
                    </div>
                </div>

                <!-- Performance Analysis -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-yellow-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full p-3 mr-4">
                            <i class="fas fa-tachometer-alt text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-yellow-400">Performance & Optimization</h2>
                    </div>
                    <p class="text-gray-300 leading-relaxed mb-6">
                        Implemented comprehensive GPU profiling using OpenGL timestamp queries to measure per-frame rendering time and individual component performance.
                        Optimized rendering efficiency through batching, minimized state changes, and efficient memory management.
                    </p>
                     <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-yellow-600/25">
                             <h4 class="text-xl font-bold text-yellow-400 mb-3">GPU Profiling</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• GL_TIMESTAMP queries</li>
                                 <li>• Per-frame timing</li>
                                 <li>• Non-blocking retrieval</li>
                             </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-green-600/25">
                             <h4 class="text-xl font-bold text-green-400 mb-3">Resource Mgmt</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Efficient allocation</li>
                                 <li>• Resource cleanup</li>
                                 <li>• No runtime allocs</li>
                             </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                             <h4 class="text-xl font-bold text-blue-400 mb-3">Efficiency</h4>
                             <ul class="text-gray-300 space-y-2 text-sm">
                                 <li>• Minimized draw calls</li>
                                 <li>• Uniform buffers</li>
                                 <li>• Viewport culling</li>
                             </ul>
                        </div>
                     </div>
                </div>

                <!-- Technical Implementation & Specs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Tech Implementation -->
                    <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 rounded-full p-3 mr-4">
                                <i class="fas fa-code text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-cyan-400">Tech Implementation</h2>
                        </div>
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-cyan-400 text-sm mb-2">OpenGL Features</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• VAO/VBO/EBO management</li>
                                    <li>• Texture mipmapping</li>
                                    <li>• Uniform Buffer Objects</li>
                                    <li>• Framebuffer Objects</li>
                                    <li>• Alpha blending</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-cyan-400 text-sm mb-2">UI & Interaction</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• Custom 2D UI elements</li>
                                    <li>• Real-time altitude display</li>
                                    <li>• Interactive camera controls</li>
                                    <li>• WASD + Mouse navigation</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Technical Specs & Collaboration -->
                     <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-indigo-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                             <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full p-3 mr-4">
                                <i class="fas fa-cogs text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-indigo-400">Specs & Collaboration</h2>
                        </div>
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-indigo-400 text-sm mb-2">Core Tech</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• C++17 Standards</li>
                                    <li>• OpenGL 4.0+ API</li>
                                    <li>• GLFW Windowing</li>
                                    <li>• Premake5 Build</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-indigo-400 text-sm mb-2">Collaboration</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• Pair programming execution</li>
                                    <li>• Modular architecture design</li>
                                    <li>• Git version control flow</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- GitHub Repository -->
                <div class="bg-gradient-to-r from-gray-800 to-gray-900 rounded-2xl p-8 border border-gray-700/50 hover:border-green-500/30 transition-all text-center md:text-left">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center">
                            <div class="bg-gray-700/50 rounded-full p-4 mr-4 hidden md:block">
                                <i class="fab fa-github text-white text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-1">Source Code Repository</h3>
                                <p class="text-gray-400">Complete 3D renderer implementation with advanced features</p>
                            </div>
                        </div>
                        <a href="https://github.com/DynoAbd786/graphics-cw2" target="_blank"
                           class="inline-flex items-center px-6 py-3 rounded-lg bg-green-600 hover:bg-green-500 text-white font-medium transition-colors shadow-lg shadow-green-900/20">
                            <i class="fab fa-github mr-2"></i>View on GitHub
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="bg-cyan-500 hover:bg-cyan-400 text-gray-900 font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>