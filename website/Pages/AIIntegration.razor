@page "/ai-integration"

<PageTitle>AI Integration</PageTitle>

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
                <span>/</span>
                <span class="text-white">AI Integration</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                AI Integration
            </div>
            <h1 class="text-6xl font-bold text-white mb-4">Model Context Protocol</h1>
            <h2 class="text-2xl text-gray-400 mb-6">AI Agent Integration & Future-Ready Architecture</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                Custom MCP server implementation enabling AI agents to interact with portfolio data and functionality through standardized protocols
            </p>
        </div>

        <!-- Development Status Alert -->
        <div class="max-w-4xl mx-auto mb-16">
            <div class="bg-amber-900/50 rounded-lg p-8 border border-amber-700">
                <div class="flex items-start">
                    <div class="bg-amber-500 rounded-full p-3 mr-4 flex-shrink-0">
                        <i class="fas fa-exclamation-triangle text-white text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold text-amber-400 mb-4">🚧 Development Status</h3>
                        <div class="space-y-4">
                            <div class="flex items-start">
                                <div class="bg-green-500 rounded-full w-3 h-3 mt-2 mr-3 flex-shrink-0"></div>
                                <p class="text-amber-100">
                                    <strong>✅ MCP Inspector Compatible:</strong> Successfully tested and fully compliant with the official MCP Inspector tool
                                </p>
                            </div>
                            <div class="flex items-start">
                                <div class="bg-amber-500 rounded-full w-3 h-3 mt-2 mr-3 flex-shrink-0"></div>
                                <p class="text-amber-100">
                                    <strong>⏳ Claude Desktop Integration:</strong> Waiting for stable MCP connector support - currently in beta
                                </p>
                            </div>
                            <div class="flex items-start">
                                <div class="bg-amber-500 rounded-full w-3 h-3 mt-2 mr-3 flex-shrink-0"></div>
                                <p class="text-amber-100">
                                    <strong>🔄 Platform Rollout:</strong> Waiting for LLM platforms to roll out stable MCP connectors out of beta phase
                                </p>
                            </div>
                        </div>
                        <div class="mt-4 p-4 bg-amber-800/30 rounded-lg border border-amber-600/50">
                            <p class="text-amber-200 text-sm">
                                <strong>Technical Status:</strong> The MCP server implementation is complete and protocol-compliant.
                                Integration issues are platform-specific, not implementation-related.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto">
            <!-- MCP Overview -->
            <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300 mb-8">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                        <i class="fas fa-robot text-white text-xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-cyan-400">What is MCP?</h2>
                </div>
                <p class="text-gray-300 text-lg leading-relaxed">
                    Model Context Protocol (MCP) is an emerging standard for enabling AI agents to interact with external systems, data, and functionality.
                    Our implementation provides a JSON-RPC 2.0 compliant server that exposes portfolio data, project search capabilities, and contact functionality
                    to AI assistants through standardized tool interfaces.
                </p>
            </div>

            <!-- Technical Implementation -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-full p-3 mr-4">
                            <i class="fas fa-check-circle text-white text-xl"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-green-400">Working Features</h3>
                    </div>
                    <ul class="space-y-3">
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">•</span>
                            <span class="text-gray-300">JSON-RPC 2.0 protocol compliance</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">•</span>
                            <span class="text-gray-300">Project search by category/technology/keyword</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">•</span>
                            <span class="text-gray-300">Contact form submission via email service</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">•</span>
                            <span class="text-gray-300">Resource endpoints for profile & project data</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">•</span>
                            <span class="text-gray-300">Full MCP Inspector compatibility</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-amber-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-full p-3 mr-4">
                            <i class="fas fa-clock text-white text-xl"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-amber-400">Platform Integration Status</h3>
                    </div>
                    <ul class="space-y-3">
                        <li class="flex items-start">
                            <span class="text-green-400 mr-3 mt-1">✅</span>
                            <span class="text-gray-300"><strong>MCP Inspector:</strong> Fully functional</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-amber-400 mr-3 mt-1">⏳</span>
                            <span class="text-gray-300"><strong>Claude Desktop:</strong> Awaiting stable support</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-amber-400 mr-3 mt-1">⏳</span>
                            <span class="text-gray-300"><strong>Other AI Platforms:</strong> Beta phase</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-400 mr-3 mt-1">🔮</span>
                            <span class="text-gray-300"><strong>Future:</strong> Universal AI agent compatibility</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Technical Details -->
            <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300 mb-8">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                        <i class="fas fa-cogs text-white text-xl"></i>
                    </div>
                    <h3 class="text-3xl font-bold text-purple-400">Technical Architecture</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="text-xl font-bold text-white mb-3">Server Implementation</h4>
                        <ul class="text-gray-300 space-y-2">
                            <li>• ASP.NET Core Web API backend</li>
                            <li>• JSON-RPC 2.0 message handling</li>
                            <li>• RESTful HTTP transport layer</li>
                            <li>• Comprehensive request/response logging</li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold text-white mb-3">Available Tools</h4>
                        <ul class="text-gray-300 space-y-2">
                            <li>• <code class="bg-gray-700 px-2 py-1 rounded">search_projects</code></li>
                            <li>• <code class="bg-gray-700 px-2 py-1 rounded">submit_contact</code></li>
                            <li>• Resource endpoints for data access</li>
                            <li>• Schema-compliant tool definitions</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Integration Instructions -->
            <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300 mb-8">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                        <i class="fas fa-code text-white text-xl"></i>
                    </div>
                    <h3 class="text-3xl font-bold text-cyan-400">Integration Instructions</h3>
                </div>
                <p class="text-gray-300 mb-6">For developers who want to integrate with the MCP server:</p>

                <div class="space-y-8">
                    <!-- MCP Inspector Testing -->
                    <div>
                        <h4 class="text-xl font-bold text-green-400 mb-4">🧪 Test with MCP Inspector</h4>
                        <div class="bg-gray-800 rounded-lg p-4 border border-gray-600">
                            <p class="text-gray-300 mb-3">Use the official MCP Inspector to test the server:</p>
                            <div class="bg-gray-900 rounded-lg p-3 font-mono text-sm border border-gray-700">
                                <div class="text-green-400 mb-2"># Install and run MCP Inspector</div>
                                <div class="text-cyan-400">npx @@modelcontextprotocol/inspector --transport http --server-url https://mkkai.dev/api/mcp</div>
                            </div>
                            <p class="text-gray-400 text-sm mt-3">This will open a web interface to test all available tools and resources.</p>
                        </div>
                    </div>

                    <!-- Claude Desktop Setup -->
                    <div>
                        <h4 class="text-xl font-bold text-purple-400 mb-4">🖥️ Claude Desktop Configuration</h4>
                        <div class="bg-amber-900/30 rounded-lg p-4 border border-amber-600/50 mb-4">
                            <div class="flex items-start">
                                <div class="bg-amber-500 rounded-full w-3 h-3 mt-2 mr-3 flex-shrink-0"></div>
                                <p class="text-amber-200 text-sm">
                                    <strong>Note:</strong> Currently experiencing compatibility issues. MCP connectors are in beta phase.
                                </p>
                            </div>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-4 border border-gray-600">
                            <p class="text-gray-300 mb-3">Add to Claude Desktop settings (Settings → Connectors):</p>
                            <div class="bg-gray-900 rounded-lg p-3 overflow-x-auto border border-gray-700">
                                <pre class="text-sm text-purple-400"><code>{
  "mcpServers": {
    "muhammad-portfolio": {
      "transport": "http",
      "url": "https://mkkai.dev/api/mcp",
      "description": "Muhammad's Portfolio MCP Server"
    }
  }
}</code></pre>
                            </div>
                        </div>
                    </div>

                    <!-- Direct API Testing -->
                    <div>
                        <h4 class="text-xl font-bold text-blue-400 mb-4">🔧 Direct API Testing</h4>
                        <div class="bg-gray-800 rounded-lg p-4 border border-gray-600">
                            <p class="text-gray-300 mb-3">Test the JSON-RPC endpoints directly with curl:</p>

                            <div class="space-y-4">
                                <div>
                                    <p class="text-white font-semibold mb-2">Initialize connection:</p>
                                    <div class="bg-gray-900 rounded-lg p-3 font-mono text-xs border border-gray-700 overflow-x-auto">
                                        <div class="text-blue-400">curl -X POST https://mkkai.dev/api/mcp \</div>
                                        <div class="text-blue-400 ml-2">-H "Content-Type: application/json" \</div>
                                        <div class="text-blue-400 ml-2">-d '{</div>
                                        <div class="text-cyan-400 ml-4">"jsonrpc": "2.0",</div>
                                        <div class="text-cyan-400 ml-4">"id": 1,</div>
                                        <div class="text-cyan-400 ml-4">"method": "initialize",</div>
                                        <div class="text-cyan-400 ml-4">"params": {</div>
                                        <div class="text-green-400 ml-6">"protocolVersion": "2025-06-18",</div>
                                        <div class="text-green-400 ml-6">"capabilities": {},</div>
                                        <div class="text-green-400 ml-6">"clientInfo": {"name": "test", "version": "1.0"}</div>
                                        <div class="text-cyan-400 ml-4">}</div>
                                        <div class="text-blue-400 ml-2">}'</div>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-white font-semibold mb-2">List available tools:</p>
                                    <div class="bg-gray-900 rounded-lg p-3 font-mono text-xs border border-gray-700 overflow-x-auto">
                                        <div class="text-blue-400">curl -X POST https://mkkai.dev/api/mcp \</div>
                                        <div class="text-blue-400 ml-2">-H "Content-Type: application/json" \</div>
                                        <div class="text-blue-400 ml-2">-d '{</div>
                                        <div class="text-cyan-400 ml-4">"jsonrpc": "2.0",</div>
                                        <div class="text-cyan-400 ml-4">"id": 2,</div>
                                        <div class="text-cyan-400 ml-4">"method": "tools/list",</div>
                                        <div class="text-cyan-400 ml-4">"params": {}</div>
                                        <div class="text-blue-400 ml-2">}'</div>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-white font-semibold mb-2">Search projects:</p>
                                    <div class="bg-gray-900 rounded-lg p-3 font-mono text-xs border border-gray-700 overflow-x-auto">
                                        <div class="text-blue-400">curl -X POST https://mkkai.dev/api/mcp \</div>
                                        <div class="text-blue-400 ml-2">-H "Content-Type: application/json" \</div>
                                        <div class="text-blue-400 ml-2">-d '{</div>
                                        <div class="text-cyan-400 ml-4">"jsonrpc": "2.0",</div>
                                        <div class="text-cyan-400 ml-4">"id": 3,</div>
                                        <div class="text-cyan-400 ml-4">"method": "tools/call",</div>
                                        <div class="text-cyan-400 ml-4">"params": {</div>
                                        <div class="text-green-400 ml-6">"name": "search_projects",</div>
                                        <div class="text-green-400 ml-6">"arguments": {"technology": "Python"}</div>
                                        <div class="text-cyan-400 ml-4">}</div>
                                        <div class="text-blue-400 ml-2">}'</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Available Tools & Resources -->
                    <div>
                        <h4 class="text-xl font-bold text-yellow-400 mb-4">📋 Available Tools & Resources</h4>
                        <div class="bg-gray-800 rounded-lg p-4 border border-gray-600">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <p class="text-white font-semibold mb-3">🛠️ Tools:</p>
                                    <ul class="space-y-2 text-gray-300 text-sm">
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">search_projects</code> - Search by category/technology/keyword</li>
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-cyan-400">submit_contact</code> - Send contact form messages</li>
                                    </ul>
                                </div>
                                <div>
                                    <p class="text-white font-semibold mb-3">📁 Resources:</p>
                                    <ul class="space-y-2 text-gray-300 text-sm">
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-purple-400">portfolio://profile</code> - Professional info</li>
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-purple-400">portfolio://contact</code> - Contact details</li>
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-purple-400">portfolio://projects/all</code> - All projects</li>
                                        <li>• <code class="bg-gray-700 px-2 py-1 rounded text-purple-400">portfolio://projects/{id}</code> - Individual projects</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Future Vision -->
            <div class="bg-gradient-to-r from-blue-900 via-purple-900 to-cyan-900 rounded-lg p-8 border border-gray-700 text-center">
                <div class="text-6xl mb-4">🚀</div>
                <h3 class="text-3xl font-bold text-white mb-4">Future AI Integration</h3>
                <p class="text-gray-300 text-lg max-w-3xl mx-auto">
                    Once MCP support stabilizes across AI platforms, this portfolio will offer seamless integration with AI assistants,
                    enabling dynamic project exploration, automated contact handling, and intelligent portfolio navigation through natural language interactions.
                </p>
            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="inline-flex items-center px-8 py-3 rounded-full bg-gradient-to-r from-red-500 to-pink-500 text-white font-bold hover:shadow-lg hover:shadow-red-500/20 transition-all transform hover:-translate-y-1">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>