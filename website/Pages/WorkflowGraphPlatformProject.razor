@page "/projects/workflow-graph-platform"
@using website.Data

<PageTitle>Workflow-Centric Graph Construction & Architectural Intelligence Platform</PageTitle>

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-cyan-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">Workflow-Centric Graph Platform</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Personal Projects • Independent Research (In Development)
            </div>
            <h1 class="text-6xl font-bold text-white mb-4">Workflow-Centric Graph Construction &amp; Architectural Intelligence Platform</h1>
            <h2 class="text-2xl text-gray-400 mb-6">C#/.NET Hybrid Architecture with Python Analysis Engine</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                Hybrid C#/.NET and Python platform transforming codebases into queryable graphs with architectural intelligence—featuring ASP.NET Core API, Blazor WASM UI, and active "Architectural Linter" capabilities for AI-assisted development
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">C# / .NET 8</span>
                <span class="bg-cyan-600 text-white px-4 py-2 rounded-full text-sm">ASP.NET Core</span>
                <span class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm">Blazor WASM</span>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">Python Analysis</span>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">Neo4j</span>
                <span class="bg-red-600 text-white px-4 py-2 rounded-full text-sm">MCP Protocol</span>
                <span class="bg-yellow-600 text-white px-4 py-2 rounded-full text-sm">Architectural Linter</span>
            </div>
        </div>

        <!-- Hero Visual -->
        <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-lg p-12 mb-16 text-center border border-gray-700">
            <div class="text-8xl mb-4">🏗️</div>
            <p class="text-gray-400 text-lg">Hybrid C#/.NET + Python • ASP.NET Core API • Blazor WASM UI • Architectural Intelligence</p>
        </div>

        <div class="max-w-6xl mx-auto">
            <!-- Main Content Sections -->
            <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">

                <!-- Project Status & Research Context -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full p-3 mr-4">
                            <i class="fas fa-info-circle text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-yellow-400">Project Status & Context</h2>
                    </div>
                    <div class="bg-yellow-900/20 rounded-lg p-6 border border-yellow-500/25 mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-yellow-500 rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-yellow-400">Current Stage: Active Personal Research</h3>
                        </div>
                        <p class="text-gray-300 leading-relaxed">
                            This is an independent technical research initiative exploring graph-based code analysis and LLM knowledge enhancement. Originally conceived for academic collaboration, the project has been refocused as a personal research endeavor with potential for future publication and open-source contribution. The work explores innovative approaches to bridging the gap between static code organization and dynamic workflow understanding, with particular emphasis on version-specific package analysis and token-efficient AI assistance.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-gray-800 rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Development Timeline</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• <strong>Conceptualization:</strong> October 2025</li>
                                <li>• <strong>Architecture Design:</strong> Ongoing</li>
                                <li>• <strong>Implementation:</strong> Progressive development</li>
                                <li>• <strong>Approach:</strong> Modular, iterative research</li>
                            </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Research Focus</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• Open-source package/library analysis</li>
                                <li>• LLM knowledge gap mitigation</li>
                                <li>• Version-specific code understanding</li>
                                <li>• Token-efficient AI assistance</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- The Problem: Code Understanding Challenges -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-red-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-full p-3 mr-4">
                            <i class="fas fa-exclamation-triangle text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-red-400">The Problem</h2>
                    </div>
                    <p class="text-gray-300 mb-6">Developers and AI assistants struggle with unfamiliar codebases. Existing tools show directory structures ("where code lives") but fail to capture behavior ("how code works").</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-gray-800 rounded-lg p-6 border border-red-600/25">
                            <h3 class="text-xl font-bold text-red-400 mb-4 flex items-center">
                                <i class="fas fa-folder-tree mr-3"></i>Current Tool Limitations
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>File-centric organization:</strong> Shows directory structure, not workflows</li>
                                <li><strong>Static documentation:</strong> Quickly outdated, missing system-level interactions</li>
                                <li><strong>Fragmented relationships:</strong> Only immediate connections visible</li>
                                <li><strong>Lost architectural context:</strong> No project philosophy or team culture captured</li>
                            </ul>
                        </div>

                        <div class="bg-gray-800 rounded-lg p-6 border border-orange-600/25">
                            <h3 class="text-xl font-bold text-orange-400 mb-4 flex items-center">
                                <i class="fas fa-robot mr-3"></i>AI Assistant Challenges
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>Version Mismatch:</strong> Hallucinating APIs from wrong package versions</li>
                                <li><strong>New Package Blindness:</strong> No knowledge of recently released libraries</li>
                                <li><strong>Confabulation:</strong> Plausible but incorrect code generation</li>
                                <li><strong>Missing Architectural Context:</strong> Code that works but violates team patterns</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-red-900/20 rounded-lg p-6 border border-red-500/25">
                        <h3 class="text-xl font-bold text-red-400 mb-4">Critical Impact</h3>
                        <p class="text-gray-300">
                            AI assistants lack Architectural Context: they don't know if your team prefers composition over inheritance, whether you use dependency injection patterns, or which design principles guide your codebase. This leads to syntactically correct code that violates team culture and architectural philosophy, requiring extensive manual refactoring.
                        </p>
                    </div>
                </div>

                <!-- Proposed Solution: Hybrid C#/.NET Architecture -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-green-400 to-green-600 rounded-full p-3 mr-4">
                            <i class="fas fa-lightbulb text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-green-400">The Solution: Hybrid C#/.NET + Python Architecture</h2>
                    </div>

                    <p class="text-gray-300 mb-6">A hybrid platform that transforms codebases into queryable graphs, combining Python's data science ecosystem for deep analysis with C#/.NET's enterprise-grade infrastructure for robust APIs and UI:</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                            <h3 class="text-xl font-bold text-blue-400 mb-4">Deep Analysis (Python Microservice)</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• <strong>Doxygen + AST Pipeline:</strong> Extract entities (classes, functions) and relationships</li>
                                <li>• <strong>Structural & Behavioral Graphs:</strong> UML-inspired dual-level analysis</li>
                                <li>• <strong>Philosophy Metadata:</strong> Tag packages with architectural context</li>
                                <li>• <strong>Workflow Extraction:</strong> Trace execution paths and call sequences</li>
                            </ul>
                        </div>

                        <div class="bg-gray-800 rounded-lg p-6 border border-cyan-600/25">
                            <h3 class="text-xl font-bold text-cyan-400 mb-4">Architectural Intelligence (C# ASP.NET Core)</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• <strong>API Gateway:</strong> Enterprise-grade REST endpoints for graph queries</li>
                                <li>• <strong>MCP Host (McpController):</strong> JSON-RPC 2.0 protocol for AI agents</li>
                                <li>• <strong>Refactoring Service:</strong> Active detection of God Classes and violations</li>
                                <li>• <strong>Python Bridge:</strong> IGraphProvider service consuming Python output</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-green-900/20 rounded-lg p-6 border border-green-500/25">
                        <h3 class="text-xl font-bold text-green-400 mb-4">Core Innovation: The "Architectural Linter"</h3>
                        <p class="text-gray-300">
                            Moving beyond simple code mapping to <strong>Architectural Linter capabilities</strong>. The C# RefactoringService doesn't just show the graph—it critiques it based on complexity metrics (Cyclomatic Complexity, Fan-Out) and defined project philosophies, accessible directly by LLMs via MCP. AI agents can ask: "Where are the God Classes?" and receive data-backed RefactoringCandidate objects with specific architectural violations.
                        </p>
                    </div>
                </div>

                <!-- System Architecture: Hybrid C#/.NET + Python -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-server text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-purple-400">System Architecture: Hybrid Microservices</h2>
                    </div>
                    <p class="text-gray-300 mb-6">Multi-container architecture separating analysis concerns (Python) from application infrastructure (C#/.NET), communicating via REST APIs and shared Neo4j database:</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-gradient-to-br from-blue-900 to-blue-800 rounded-lg p-6 border border-cyan-600/50">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-layer-group text-cyan-400 text-2xl mr-3"></i>
                                <h3 class="text-xl font-bold text-cyan-400">Frontend: Blazor WebAssembly (C#)</h3>
                            </div>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• Interactive graph visualization (D3.js/Cytoscape interop)</li>
                                <li>• "Audit View" displaying RefactoringCandidates</li>
                                <li>• GitHub repository submission interface</li>
                                <li>• Real-time graph exploration with C# client</li>
                            </ul>
                        </div>

                        <div class="bg-gradient-to-br from-cyan-900 to-cyan-800 rounded-lg p-6 border border-blue-600/50">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-server text-blue-400 text-2xl mr-3"></i>
                                <h3 class="text-xl font-bold text-blue-400">Application Layer: ASP.NET Core API (C#)</h3>
                            </div>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• <strong>API Gateway:</strong> REST endpoints for graph queries</li>
                                <li>• <strong>McpController:</strong> JSON-RPC 2.0 for AI tool calls</li>
                                <li>• <strong>RefactoringService:</strong> God Class detection heuristics</li>
                                <li>• <strong>PythonBridgeService:</strong> IGraphProvider implementation</li>
                            </ul>
                        </div>

                        <div class="bg-gradient-to-br from-purple-900 to-purple-800 rounded-lg p-6 border border-purple-600/50">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-code text-purple-400 text-2xl mr-3"></i>
                                <h3 class="text-xl font-bold text-purple-400">Analysis Layer: Python Microservice</h3>
                            </div>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• <strong>Doxygen + AST:</strong> Entity/relationship extraction</li>
                                <li>• <strong>Hierarchical Sanitization:</strong> Multi-level graph construction</li>
                                <li>• <strong>Philosophy Metadata:</strong> Architectural context tagging</li>
                                <li>• <strong>OpenAI Integration:</strong> AI-generated documentation</li>
                            </ul>
                        </div>

                        <div class="bg-gradient-to-br from-green-900 to-green-800 rounded-lg p-6 border border-green-600/50">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-database text-green-400 text-2xl mr-3"></i>
                                <h3 class="text-xl font-bold text-green-400">Data Layer: Neo4j + Redis</h3>
                            </div>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• <strong>Neo4j:</strong> Graph database with package:version namespacing</li>
                                <li>• <strong>Redis:</strong> Caching layer for heavy queries and AI calls</li>
                                <li>• <strong>Cypher Queries:</strong> Graph traversal and pattern matching</li>
                                <li>• <strong>Shared Access:</strong> Both Python and C# services connect</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-purple-900/20 rounded-lg p-6 border border-purple-500/25 mt-6">
                        <h3 class="text-xl font-bold text-purple-400 mb-4">Architecture Benefits</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                            <div>
                                <h4 class="font-bold text-white mb-2">Separation of Concerns</h4>
                                <p class="text-gray-400">Python handles data science, C# handles enterprise infrastructure</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">Language-Specific Strengths</h4>
                                <p class="text-gray-400">Leverage ecosystems: NumPy/Pandas vs. robust APIs/DI</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">MCP-First Design</h4>
                                <p class="text-gray-400">AI agents as first-class citizens with dedicated endpoints</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Primary Use Case: Open-Source Package Analysis -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                            <i class="fas fa-box-open text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-cyan-400">Primary Use Case: Open-Source Package Analysis</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-green-600/25">
                            <h3 class="text-xl font-bold text-green-400 mb-4">For Human Developers</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• Understand package/library APIs before integration</li>
                                <li>• Learn capabilities and features</li>
                                <li>• Explore class structure for open-source contributions</li>
                                <li>• Navigate workflows to understand implementations</li>
                            </ul>
                        </div>

                        <div class="bg-gray-800 rounded-lg p-6 border border-purple-600/25">
                            <h3 class="text-xl font-bold text-purple-400 mb-4">For AI Systems (via MCP)</h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li>• Query package capabilities by name and version</li>
                                <li>• Retrieve structured API documentation</li>
                                <li>• Access class structure for contributions</li>
                                <li>• Debug version-specific dependency issues</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-cyan-900/20 rounded-lg p-6 border border-cyan-500/25">
                        <h3 class="text-xl font-bold text-cyan-400 mb-4">Package-Centric Workflow</h3>
                        <div class="space-y-3 text-gray-300 text-sm">
                            <div class="flex items-start">
                                <span class="text-cyan-400 font-bold mr-3">1.</span>
                                <span>User submits GitHub repository link and specifies version/tag via web interface</span>
                            </div>
                            <div class="flex items-start">
                                <span class="text-cyan-400 font-bold mr-3">2.</span>
                                <span>Backend clones repository at specified version and runs analysis pipeline</span>
                            </div>
                            <div class="flex items-start">
                                <span class="text-cyan-400 font-bold mr-3">3.</span>
                                <span>Structural and behavioral graphs generated with version metadata (e.g., numpy:1.24.0)</span>
                            </div>
                            <div class="flex items-start">
                                <span class="text-cyan-400 font-bold mr-3">4.</span>
                                <span>Human users explore via web visualization, AI systems query via MCP API</span>
                            </div>
                            <div class="flex items-start">
                                <span class="text-cyan-400 font-bold mr-3">5.</span>
                                <span>Version-specific analysis enables cross-version comparisons and debugging</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Implementation Phases -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-blue-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full p-3 mr-4">
                            <i class="fas fa-tasks text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-blue-400">Implementation Phases</h2>
                    </div>

                    <div class="mb-8">
                        <h3 class="text-2xl font-bold text-green-400 mb-4">Phase 1: The "Market-Ready" Prototype</h3>
                        <p class="text-gray-300 mb-4">Goal: A functional system capable of ingesting a repo, detecting architectural flaws (God Classes), and exposing the graph to AI agents via MCP</p>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="bg-gray-800 rounded-lg p-4 border border-purple-600/25">
                                <h4 class="font-bold text-purple-400 mb-2">Stage 1: Python Backend</h4>
                                <ul class="text-gray-300 text-sm space-y-1">
                                    <li>• Doxygen + AST pipeline</li>
                                    <li>• Entity/relationship extraction</li>
                                    <li>• Philosophy metadata tagging</li>
                                </ul>
                            </div>
                            <div class="bg-gray-800 rounded-lg p-4 border border-cyan-600/25">
                                <h4 class="font-bold text-cyan-400 mb-2">Stage 2: C# Bridge & MCP</h4>
                                <ul class="text-gray-300 text-sm space-y-1">
                                    <li>• IGraphProvider + PythonBridgeService</li>
                                    <li>• McpController (get_workflow, explain_structure)</li>
                                    <li>• RefactoringService with God Class detection</li>
                                </ul>
                            </div>
                            <div class="bg-gray-800 rounded-lg p-4 border border-indigo-600/25">
                                <h4 class="font-bold text-indigo-400 mb-2">Stage 3: Blazor UI</h4>
                                <ul class="text-gray-300 text-sm space-y-1">
                                    <li>• Interactive graph rendering (D3.js interop)</li>
                                    <li>• "Audit View" for RefactoringCandidates</li>
                                    <li>• Docker deployment</li>
                                </ul>
                            </div>
                        </div>

                        <div class="bg-green-900/20 rounded-lg p-4 border border-green-500/25 mt-4">
                            <p class="text-gray-300 text-sm">
                                <strong class="text-green-400">Phase 1 Deliverable:</strong> Deployable Docker container where users upload a package (e.g., numpy), visualize the graph in Blazor, and AI agents query "Where are the God Classes?" via MCP for data-backed answers
                            </p>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-2xl font-bold text-yellow-400 mb-4">Phase 2: Individual Research Tracks</h3>
                        <p class="text-gray-300 mb-4">Building on the C#/.NET + Python foundation with specialized research directions:</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-gray-800 rounded-lg p-4 border border-blue-600/25">
                                <h4 class="font-bold text-blue-400 mb-2">Track 1: Big Data ML + Cross-Language</h4>
                                <p class="text-gray-300 text-sm">Train GNNs on graph data, map Python AST to C# structures, predict missing edges</p>
                            </div>
                            <div class="bg-gray-800 rounded-lg p-4 border border-red-600/25">
                                <h4 class="font-bold text-red-400 mb-2">Track 2: Cybersecurity Threat Modeling</h4>
                                <p class="text-gray-300 text-sm">SecurityScanner extension, CVE mapping, vulnerability heatmap in Blazor UI</p>
                            </div>
                            <div class="bg-gray-800 rounded-lg p-4 border border-green-600/25">
                                <h4 class="font-bold text-green-400 mb-2">Track 3: Enterprise Scaling + Hierarchical Agents</h4>
                                <p class="text-gray-300 text-sm">Scale ASP.NET Core for concurrent MCP, Redis caching, sub-linear latency benchmarks</p>
                            </div>
                            <div class="bg-gray-800 rounded-lg p-4 border border-purple-600/25">
                                <h4 class="font-bold text-purple-400 mb-2">Track 4: Consultancy + Automated Auditing</h4>
                                <p class="text-gray-300 text-sm">ReviewController for PDF reports, user validation studies, "State of OSS Architecture" report</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Validation Framework: LLM Before/After Evaluation -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-yellow-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full p-3 mr-4">
                            <i class="fas fa-chart-line text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-yellow-400">Validation Framework</h2>
                    </div>

                    <p class="text-gray-300 mb-6"><strong>Primary Evaluation:</strong> Three-condition LLM experiment using Manim v0.17.3 as test codebase</p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-gray-800 rounded-lg p-6 border border-red-600/25">
                            <h3 class="text-xl font-bold text-red-400 mb-3">Condition A: Baseline</h3>
                            <p class="text-gray-300 text-sm">LLM with Manim documentation only, no codebase access</p>
                            <div class="mt-3 text-sm text-gray-400">
                                <strong>Expected Error Rate:</strong> ~50%
                            </div>
                        </div>

                        <div class="bg-gray-800 rounded-lg p-6 border border-yellow-600/25">
                            <h3 class="text-xl font-bold text-yellow-400 mb-3">Condition B: Full Codebase</h3>
                            <p class="text-gray-300 text-sm">Claude Code / Agentic Tool with entire repository access</p>
                            <div class="mt-3 text-sm text-gray-400">
                                <strong>Expected Error Rate:</strong> ~28%<br/>
                                <strong>Avg Input Tokens:</strong> 18,500
                            </div>
                        </div>

                        <div class="bg-gray-800 rounded-lg p-6 border border-green-600/25">
                            <h3 class="text-xl font-bold text-green-400 mb-3">Condition C: MCP Tool (Our System)</h3>
                            <p class="text-gray-300 text-sm">Access to MCP API for structured queries</p>
                            <div class="mt-3 text-sm text-gray-400">
                                <strong>Target Error Rate:</strong> &lt;18%<br/>
