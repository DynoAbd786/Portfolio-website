@page "/projects/home-lab"
@using website.Data

<ProjectPage Url="/projects/home-lab" Kicker="Personal Project · Infrastructure">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A distributed self-hosted ecosystem connecting multiple devices into a unified computing grid. Leveraging Tailscale, SSH, and Android-based servers to provide on-demand access to high-performance AI resources from anywhere in the world.
                </p>
            
            <!-- Live Status Block -->
            <ProjectSection Title="System Status" Icon="fas fa-signal">
                
                <BridgeStatus />
                </ProjectSection>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">
                
                <!-- Infrastructure Overview -->
                <ProjectSection Title="Network Architecture" Icon="fas fa-network-wired">
                    <div class="mb-8 rounded-lg border border-line bg-white/[.02] p-8 sm:p-12">
                    <div class="flex justify-center items-center gap-4 md:gap-16 flex-wrap md:flex-nowrap">
                <!-- Node: Laptop -->
                <div class="flex flex-col items-center group">
                    <div class="w-24 h-24 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500">
                        <i class="fas fa-laptop text-3xl text-cy"></i>
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Client</div>
                        <div class="text-xs text-slate-500 font-mono tracking-wide">MacBook / PC</div>
                    </div>
                </div>

                <!-- Connection Line -->
                <div class="hidden md:flex flex-col items-center w-24 opacity-60">
                    <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-cy to-transparent"></div>
                    <span class="text-[10px] text-cy mt-2 font-mono uppercase tracking-widest">VPN</span>
                </div>

                <!-- Node: Mobile -->
                <div class="flex flex-col items-center group">
                    <div class="w-20 h-28 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500 relative">
                        <i class="fas fa-mobile-alt text-3xl text-cy"></i>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-black/50 rounded-full border border-white/10 flex items-center justify-center">
                            <i class="fas fa-terminal text-xs text-cy"></i>
                        </div>
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Gateway</div>
                        <div class="text-xs text-slate-500 font-mono tracking-wide">Android / Termux</div>
                    </div>
                </div>

                <!-- Connection Line -->
                <div class="hidden md:flex flex-col items-center w-24 opacity-60">
                     <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-cy to-transparent"></div>
                     <span class="text-[10px] text-cy mt-2 font-mono uppercase tracking-widest">SSH</span>
                </div>

                <!-- Node: Desktop -->
                <div class="flex flex-col items-center group">
                    <div class="w-24 h-32 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500 relative">
                        <i class="fas fa-server text-4xl text-cy"></i>
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Core</div>
                        <div class="text-xs text-slate-500 font-mono tracking-wide">Linux / Ollama</div>
                    </div>
                </div>
            </div>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        The core of this system is a secure Mesh VPN powered by <strong>Tailscale</strong>, allowing seamless communication between devices regardless of their physical network. This flat network topology enables my laptop, phones, and desktop to interact as if they were on the same local LAN.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-server text-cy mr-3"></i>High-Performance Node
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Custom Desktop PC running Linux, serving as the heavy-lifter for LLM inference (Ollama) and heavy compilation tasks.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> NVIDIA GPU Acceleration</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Containerized Services (Docker)</li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-mobile-alt text-cy mr-3"></i>Mobile Control Nodes
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Android devices running Termux, acting as always-on lightweight servers and control interfaces.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Always-On SSH Gateway</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Low Power Consumption</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Automation & AI -->
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Mobile Server Cluster -->
                     <ProjectSection Title="Mobile Servers" Icon="fas fa-terminal">
                        <p class="text-gray-300 mb-4">
                            Repurposed Android devices serve as resilient control planes.
                        </p>
                        <ul class="space-y-3 text-gray-300">
                             <li class="flex items-start">
                                <i class="fas fa-code text-cy mt-1 mr-3"></i>
                                <span><strong>Termux Environment:</strong> A full Linux environment in the pocket, enabling script execution and SSH access.</span>
                            </li>
                             <li class="flex items-start">
                                <i class="fas fa-bolt text-cy mt-1 mr-3"></i>
                                <span><strong>Wake-on-LAN:</strong> n8n workflows trigger power management for the main desktop, saving energy.</span>
                            </li>
                        </ul>
                </ProjectSection>

                     <!-- Local Inference -->
                     <ProjectSection Title="Local Inference" Icon="fas fa-brain">
                        <p class="text-gray-300 mb-4">
                            Serving open-weights LLMs via Ollama through the Tailscale tunnel.
                        </p>
                        <ul class="space-y-3 text-gray-300">
                             <li class="flex items-start">
                                <i class="fas fa-shield-alt text-cy mt-1 mr-3"></i>
                                <span><strong>Data Sovereignty:</strong> Sensitive data never leaves the mesh network.</span>
                            </li>
                             <li class="flex items-start">
                                <i class="fas fa-rocket text-cy mt-1 mr-3"></i>
                                <span><strong>Low Latency:</strong> Direct peer-to-peer connection for fast model queries.</span>
                            </li>
                        </ul>
                </ProjectSection>
                 </div>

                <!-- Collaborative Research Workspace -->
                <ProjectSection Title="Collaborative Research Workspace" Icon="fas fa-users">
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                         To facilitate group research projects, I've architected a <strong>secure shared workspace</strong> on the main GPU node, allowing friends to leverage the RTX 5090 compute power.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-user-lock text-cy mr-3"></i>Granular Access Control
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Using advanced Linux <strong>Access Control Lists (ACLs)</strong>, collaborators are "parachuted" directly into a shared project directory via SSH.</p>
                                 <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cy mr-2"></i> Strict Traversal Permissions</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cy mr-2"></i> Private Home Directory Isolation</li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-terminal text-cy mr-3"></i>Automated Onboarding
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Custom bash scripts handle SSH key provisioning and environment configuration.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cy mr-2"></i> Instant Team Integration</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cy mr-2"></i> Automated Environment Setup</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

            </div>
        
</ProjectPage>

