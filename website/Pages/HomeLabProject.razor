@page "/projects/home-lab"
@using website.Data
@using System.Text.Json
@inject HttpClient Http

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-cyan-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">Home Lab & Remote Infrastructure</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Infrastructure Portfolio
            </div>
            <h1 class="text-5xl font-bold text-white mb-4">Home Lab & Remote Infrastructure</h1>
            <h2 class="text-2xl text-gray-400 mb-6">Secure. Scalable. Sovereign.</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                A distributed self-hosted ecosystem connecting multiple devices into a unified computing grid. Leveraging Tailscale, SSH, and Android-based servers to provide on-demand access to high-performance AI resources from anywhere in the world.
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-cyan-600 text-white px-4 py-2 rounded-full text-sm">Tailscale</span>
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">SSH</span>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">Ollama</span>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">Termux</span>
                <span class="bg-gray-600 text-white px-4 py-2 rounded-full text-sm">Linux</span>
            </div>
        </div>

        <!-- Hero Visual / Topology Visualization -->
        <div class="bg-gradient-to-r from-gray-900 to-blue-950 rounded-lg p-12 mb-16 border border-gray-700 relative overflow-hidden">
             
             <div class="flex justify-center items-center gap-4 md:gap-16 flex-wrap md:flex-nowrap relative z-10">
                <!-- Node: Laptop -->
                <div class="flex flex-col items-center group">
                    <div class="w-24 h-24 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500">
                        <i class="fas fa-laptop text-3xl text-cyan-200"></i>
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Client</div>
                        <div class="text-xs text-cyan-200/60 font-mono tracking-wide">MacBook / PC</div>
                    </div>
                </div>

                <!-- Connection Line -->
                <div class="hidden md:flex flex-col items-center w-24 opacity-60">
                    <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-cyan-400 to-transparent"></div>
                    <span class="text-[10px] text-cyan-300 mt-2 font-mono uppercase tracking-widest">VPN</span>
                </div>

                <!-- Node: Mobile -->
                <div class="flex flex-col items-center group">
                    <div class="w-20 h-28 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500 relative">
                        <i class="fas fa-mobile-alt text-3xl text-green-200"></i>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-black/50 rounded-full border border-white/10 flex items-center justify-center">
                            <i class="fas fa-terminal text-xs text-green-400"></i>
                        </div>
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Gateway</div>
                        <div class="text-xs text-green-200/60 font-mono tracking-wide">Android / Termux</div>
                    </div>
                </div>

                <!-- Connection Line -->
                <div class="hidden md:flex flex-col items-center w-24 opacity-60">
                     <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-purple-400 to-transparent"></div>
                     <span class="text-[10px] text-purple-300 mt-2 font-mono uppercase tracking-widest">SSH</span>
                </div>

                <!-- Node: Desktop -->
                <div class="flex flex-col items-center group">
                    <div class="w-24 h-32 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shadow-xl backdrop-blur-sm group-hover:bg-white/10 transition-all duration-500 relative">
                        <i class="fas fa-server text-4xl text-purple-200"></i>
                         <!-- Live Pulse -->
                         @if (IsOnline) {
                            <div class="absolute inset-0 bg-purple-400/10 animate-pulse rounded-lg pointer-events-none"></div>
                            <div class="absolute top-3 right-3 w-2 h-2 rounded-full bg-green-400 shadow-[0_0_10px_rgba(74,222,128,0.8)]"></div>
                         }
                    </div>
                    <div class="mt-4 text-center">
                        <div class="text-white font-bold text-lg">Core</div>
                        <div class="text-xs text-purple-200/60 font-mono tracking-wide">Linux / Ollama</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto">
            
            <!-- Live Status Block -->
            <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300 mb-12">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-green-600 to-green-700 rounded-full p-3 mr-4">
                        <i class="fas fa-signal text-white text-xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-green-400">System Status</h2>
                </div>
                
                <div class="bg-black rounded-lg p-6 border border-gray-800 flex items-center justify-between">
                     <div class="flex items-center gap-4">
                        <div class="relative flex h-4 w-4">
                          @if (IsOnline)
                          {
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-4 w-4 bg-green-500"></span>
                          }
                          else
                          {
                              <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500"></span>
                          }
                        </div>
                        <div>
                            <div class="text-white font-bold text-lg">@(IsOnline ? "ONLINE" : "OFFLINE")</div>
                            <div class="text-gray-500 text-sm">Bridge Connection</div>
                        </div>
                     </div>
                     
                     <div class="text-right hidden sm:block">
                         <div class="text-gray-400 text-sm">Uptime</div>
                         <div class="text-white font-mono">99.98%</div>
                     </div>
                </div>
                
                 <div class="mt-4 p-4 bg-gray-800 rounded-lg border-l-4 border-green-500">
                    <p class="text-gray-300 text-sm leading-relaxed">
                        <strong class="text-white">Live Monitoring:</strong> This indicator polls the backend API (Server-Sent Events Bridge) to verify if the local home lab agent is currently reachable for AI inference tasks.
                    </p>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">
                
                <!-- Infrastructure Overview -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-cyan-600 to-blue-600 rounded-full p-3 mr-4">
                            <i class="fas fa-network-wired text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-cyan-400">Network Architecture</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        The core of this system is a secure Mesh VPN powered by <strong>Tailscale</strong>, allowing seamless communication between devices regardless of their physical network. This flat network topology enables my laptop, phones, and desktop to interact as if they were on the same local LAN.
                    </p>
                    <div class="bg-gray-800 rounded-lg p-6 border border-cyan-500/25">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-server text-cyan-400 mr-3"></i>High-Performance Node
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Custom Desktop PC running Linux, serving as the heavy-lifter for LLM inference (Ollama) and heavy compilation tasks.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> NVIDIA GPU Acceleration</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Containerized Services (Docker)</li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-mobile-alt text-cyan-400 mr-3"></i>Mobile Control Nodes
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Android devices running Termux, acting as always-on lightweight servers and control interfaces.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Always-On SSH Gateway</li>
                                    <li class="flex items-center"><i class="fas fa-check text-cyan-500 mr-2"></i> Low Power Consumption</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Automation & AI -->
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Mobile Server Cluster -->
                     <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-green-600 to-green-700 rounded-full p-3 mr-4">
                                <i class="fas fa-terminal text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-green-400">Mobile Servers</h2>
                        </div>
                        <p class="text-gray-300 mb-4">
                            Repurposed Android devices serve as resilient control planes.
                        </p>
                        <ul class="space-y-3 text-gray-300">
                             <li class="flex items-start">
                                <i class="fas fa-code text-green-500 mt-1 mr-3"></i>
                                <span><strong>Termux Environment:</strong> A full Linux environment in the pocket, enabling script execution and SSH access.</span>
                            </li>
                             <li class="flex items-start">
                                <i class="fas fa-bolt text-green-500 mt-1 mr-3"></i>
                                <span><strong>Wake-on-LAN:</strong> n8n workflows trigger power management for the main desktop, saving energy.</span>
                            </li>
                        </ul>
                     </div>

                     <!-- Local Inference -->
                     <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-purple-600 to-purple-700 rounded-full p-3 mr-4">
                                <i class="fas fa-brain text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-purple-400">Local Inference</h2>
                        </div>
                        <p class="text-gray-300 mb-4">
                            Serving open-weights LLMs via Ollama through the Tailscale tunnel.
                        </p>
                        <ul class="space-y-3 text-gray-300">
                             <li class="flex items-start">
                                <i class="fas fa-shield-alt text-purple-500 mt-1 mr-3"></i>
                                <span><strong>Data Sovereignty:</strong> Sensitive data never leaves the mesh network.</span>
                            </li>
                             <li class="flex items-start">
                                <i class="fas fa-rocket text-purple-500 mt-1 mr-3"></i>
                                <span><strong>Low Latency:</strong> Direct peer-to-peer connection for fast model queries.</span>
                            </li>
                        </ul>
                     </div>
                 </div>

                <!-- Collaborative Research Workspace -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-yellow-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-yellow-600 to-orange-600 rounded-full p-3 mr-4">
                            <i class="fas fa-users text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-yellow-400">Collaborative Research Workspace</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                         To facilitate group research projects, I've architected a <strong>secure shared workspace</strong> on the main GPU node, allowing friends to leverage the RTX 5090 compute power.
                    </p>
                    <div class="bg-gray-800 rounded-lg p-6 border border-yellow-500/25">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-user-lock text-yellow-500 mr-3"></i>Granular Access Control
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Using advanced Linux <strong>Access Control Lists (ACLs)</strong>, collaborators are "parachuted" directly into a shared project directory via SSH.</p>
                                 <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-yellow-500 mr-2"></i> Strict Traversal Permissions</li>
                                    <li class="flex items-center"><i class="fas fa-check text-yellow-500 mr-2"></i> Private Home Directory Isolation</li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-terminal text-yellow-500 mr-3"></i>Automated Onboarding
                                </h3>
                                <p class="text-gray-300 text-sm mb-4">Custom bash scripts handle SSH key provisioning and environment configuration.</p>
                                <ul class="space-y-2 text-gray-400 text-sm">
                                    <li class="flex items-center"><i class="fas fa-check text-yellow-500 mr-2"></i> Instant Team Integration</li>
                                    <li class="flex items-center"><i class="fas fa-check text-yellow-500 mr-2"></i> Automated Environment Setup</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>

@implements IDisposable

@code {
    private bool IsOnline = false;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // Poll every 3 seconds to update status
        _timer = new System.Threading.Timer(async _ =>
        {
            await CheckStatus();
            await InvokeAsync(StateHasChanged);
        }, null, 0, 3000);
    }

    private async Task CheckStatus()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<JsonElement>("api/mcp/status/bridge");
            if (response.TryGetProperty("isConnected", out var connected))
            {
                IsOnline = connected.GetBoolean();
            }
        }
        catch
        {
            IsOnline = false;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
