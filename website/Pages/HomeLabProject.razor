@page "/projects/home-lab"
@using website.Data

<ProjectPage Url="/projects/home-lab" Kicker="Personal Project · Infrastructure">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-300">
                    My home lab is a desktop with an RTX 5090 that runs local LLMs and coding agents, plus a Raspberry Pi that stays on all the time.
                    Tailscale links them to my laptop and phone, so I can use all of it from anywhere.
                </p>

                <ProjectSection Title="Network Architecture" Icon="fas fa-network-wired">
                    <div class="mb-8 rounded-lg border border-line bg-white/[.02] p-8 sm:p-12">
                        <div class="flex flex-wrap items-center justify-center gap-4 md:flex-nowrap md:gap-12">
                            <div class="flex flex-col items-center">
                                <div class="flex h-24 w-24 items-center justify-center rounded-full border border-white/10 bg-white/5">
                                    <i class="fas fa-laptop text-3xl text-cy" aria-hidden="true"></i>
                                </div>
                                <div class="mt-4 text-center">
                                    <div class="text-lg font-bold text-white">Laptop &amp; phone</div>
                                    <div class="font-mono text-xs text-slate-400">anywhere</div>
                                </div>
                            </div>
                            <div class="hidden w-24 flex-col items-center opacity-60 md:flex">
                                <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-cy to-transparent"></div>
                                <span class="mt-2 font-mono text-[10px] uppercase tracking-widest text-cy">Tailscale</span>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="flex h-24 w-20 items-center justify-center rounded-2xl border border-white/10 bg-white/5">
                                    <i class="fab fa-raspberry-pi text-3xl text-cy" aria-hidden="true"></i>
                                </div>
                                <div class="mt-4 text-center">
                                    <div class="text-lg font-bold text-white">Raspberry Pi</div>
                                    <div class="font-mono text-xs text-slate-400">always on · exit node</div>
                                </div>
                            </div>
                            <div class="hidden w-24 flex-col items-center opacity-60 md:flex">
                                <div class="h-0.5 w-full bg-gradient-to-r from-transparent via-cy to-transparent"></div>
                                <span class="mt-2 font-mono text-[10px] uppercase tracking-widest text-cy">Tailscale</span>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="flex h-32 w-24 items-center justify-center rounded-lg border border-white/10 bg-white/5">
                                    <i class="fas fa-server text-4xl text-cy" aria-hidden="true"></i>
                                </div>
                                <div class="mt-4 text-center">
                                    <div class="text-lg font-bold text-white">GPU desktop</div>
                                    <div class="font-mono text-xs text-slate-400">Ubuntu · RTX 5090</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p class="mb-6 text-lg leading-relaxed text-slate-300">
                        Every device is on a private Tailscale network, so they reach each other directly wherever they are, without opening any ports to the internet.
                        The Pi also works as an exit node, so on public Wi-Fi my traffic can go out through home.
                    </p>
                    <div class="grid gap-6 md:grid-cols-2">
                        <div class="rounded-lg border border-line bg-white/[.02] p-6">
                            <h3 class="mb-3 flex items-center text-xl font-bold text-white"><i class="fas fa-server mr-3 text-cy" aria-hidden="true"></i>GPU desktop</h3>
                            <p class="text-sm leading-relaxed text-slate-300">Ubuntu with an RTX 5090. It runs local models with llama.cpp and Hermes, the coding agents, and containerised services in Docker.</p>
                        </div>
                        <div class="rounded-lg border border-line bg-white/[.02] p-6">
                            <h3 class="mb-3 flex items-center text-xl font-bold text-white"><i class="fab fa-raspberry-pi mr-3 text-cy" aria-hidden="true"></i>Raspberry Pi</h3>
                            <p class="text-sm leading-relaxed text-slate-300">Low power and always on. It runs some of the containerised services and is the network's exit node.</p>
                        </div>
                    </div>
                </ProjectSection>

                <ProjectSection Title="Local Inference" Icon="fas fa-brain">
                    <p class="leading-relaxed text-slate-300">
                        Open-weight models run on the 5090 with llama.cpp, tuned for long inference runs. Prompts and data stay on my own hardware,
                        and because the devices talk to each other directly over Tailscale, using a model from my laptop or phone feels local.
                    </p>
                </ProjectSection>

                <ProjectSection Title="Collaborative Research Workspace" Icon="fas fa-users">
                    <p class="mb-6 leading-relaxed text-slate-300">
                        Friends working on research projects can use the 5090 too. Each person gets SSH access straight into a shared project folder, and nothing else.
                    </p>
                    <div class="grid gap-6 md:grid-cols-2">
                        <div class="rounded-lg border border-line bg-white/[.02] p-6">
                            <h3 class="mb-3 flex items-center text-xl font-bold text-white"><i class="fas fa-user-lock mr-3 text-cy" aria-hidden="true"></i>Granular Access Control</h3>
                            <p class="text-sm leading-relaxed text-slate-300">Linux access control lists let collaborators into the shared folder while keeping every home directory private.</p>
                        </div>
                        <div class="rounded-lg border border-line bg-white/[.02] p-6">
                            <h3 class="mb-3 flex items-center text-xl font-bold text-white"><i class="fas fa-terminal mr-3 text-cy" aria-hidden="true"></i>Automated Onboarding</h3>
                            <p class="text-sm leading-relaxed text-slate-300">A bash script sets up each person's SSH keys and environment.</p>
                        </div>
                    </div>
                </ProjectSection>
</ProjectPage>
