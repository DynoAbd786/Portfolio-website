@page "/projects/ai-search-algorithms"
@using website.Data


<ProjectPage Url="/projects/ai-search-algorithms" Kicker="Academic Project · Year 2">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    AI coursework where we implemented search algorithms, measured how they performed on hard problems, and designed our own heuristics to speed them up.
                </p>
                <!-- Course Information & Assignment Overview -->
                <ProjectSection Title="Course Information" Subtitle="COMP2611 - Artificial Intelligence, University of Leeds" Icon="fas fa-university">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Course Details</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Module:</strong> COMP2611 - Artificial Intelligence</p>
                                <p><strong>Institution:</strong> University of Leeds</p>
                                <p><strong>Year:</strong> 2023/24 (Year 2)</p>
                                <p><strong>Assessment:</strong> Coursework 1 (20% weight)</p>
                                <p><strong>Format:</strong> Research Report & Analysis</p>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Assignment Structure</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Type:</strong> Pair Work Assignment</p>
                                <p><strong>Focus:</strong> Search Algorithm Implementation</p>
                                <p><strong>Length:</strong> 8-10 page report</p>
                                <p><strong>Scope:</strong> Sliding Block Puzzles & Robot Workers</p>
                                <p><strong>Extension:</strong> Designing our own heuristics</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Search Algorithm Implementation -->
                <ProjectSection Title="Search Algorithm Implementation" Subtitle="The algorithms we built and the problems we ran them on" Icon="fas fa-search">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Core Algorithms</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">A* Search Algorithm</h4>
                                    <p class="text-sm text-gray-300">With an admissible heuristic it is guaranteed to find the shortest path</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Greedy Best-First Search</h4>
                                    <p class="text-sm text-gray-300">Follows the heuristic alone, so it finds solutions fast but not always the best one</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Informed Search Methods</h4>
                                    <p class="text-sm text-gray-300">Heuristic functions we wrote for each specific problem</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Problem Domains</h3>
                            <div class="bg-white/[.02] rounded-lg p-4 mb-4">
                                <h4 class="font-bold text-slate-100 mb-2">Sliding Block Puzzles</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• 8-puzzle and 15-puzzle configurations</li>
                                    <li>• Tuning the Manhattan distance heuristic</li>
                                    <li>• Analysing how the state space is explored</li>
                                    <li>• Finding shorter move sequences</li>
                                </ul>
                            </div>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Robot Worker Scenarios</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Pathfinding for several agents at once</li>
                                    <li>• Efficient routes around a warehouse</li>
                                    <li>• Deciding how to allocate resources</li>
                                    <li>• Keeping robots from colliding</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Performance Analysis & Heuristics -->
                <ProjectSection Title="Performance Analysis & Custom Heuristics" Subtitle="How efficient each approach was, and how we improved it" Icon="fas fa-chart-line">
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Complexity Analysis</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Time complexity in O-notation</li>
                                <li>• Reducing space complexity</li>
                                <li>• Branching factor</li>
                                <li>• How search depth affects cost</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Heuristic Development</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Improving on Manhattan distance</li>
                                <li>• Detecting linear conflicts</li>
                                <li>• Building pattern databases</li>
                                <li>• Checking each heuristic is admissible</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Empirical Testing</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Tests across many puzzle configurations</li>
                                <li>• Statistical comparison of performance</li>
                                <li>• How good each solution was</li>
                                <li>• Where runtime could be cut</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Implementation & Results -->
                <ProjectSection Title="Technical Implementation & Results" Subtitle="Written in Python, with a testing framework to measure it" Icon="fas fa-code">
                    <div class="grid lg:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Implementation Highlights</h3>
                            <div class="bg-white/[.02] rounded-lg p-4 mb-4">
                                <h4 class="font-bold text-slate-100 mb-2">Algorithm Structure</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• A priority queue for A*</li>
                                    <li>• A compact state representation</li>
                                    <li>• Nodes stored to save memory</li>
                                    <li>• Rebuilding the path once the goal is found</li>
                                </ul>
                            </div>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Testing Framework</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Test cases generated automatically</li>
                                    <li>• Benchmarks for performance</li>
                                    <li>• Checks that each solution is valid</li>
                                    <li>• Tools for the statistical analysis</li>
                                </ul>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Research Outcomes</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Performance Results</h4>
                                    <p class="text-sm text-gray-300">A* consistently found better solutions than greedy search</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Heuristic Effectiveness</h4>
                                    <p class="text-sm text-gray-300">Our heuristics cut the search space by 40-60% on average</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Scalability Analysis</h4>
                                    <p class="text-sm text-gray-300">Memory use grew linearly with problem complexity</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Downloads Section -->
                <ProjectSection Title="Project Documentation" Subtitle="The assignment brief and our submitted report" Icon="fas fa-download">
                    <div class="grid md:grid-cols-2 gap-4">
                        <a href="/docs/ai-search-algorithms-brief.pdf" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fas fa-file-pdf mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">Assignment Brief</div>
                                <div class="text-sm opacity-90">COMP2611 search algorithms coursework</div>
                            </div>
                        </a>
                        <a href="/docs/ai-search-algorithms-submission.pdf" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fas fa-file-pdf mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">Research Submission</div>
                                <div class="text-sm opacity-90">Full report (8-10 pages)</div>
                            </div>
                        </a>
                    </div>
                </ProjectSection>

                <!-- Academic Excellence Note -->
                <div class="rounded-lg p-8 text-center border border-line bg-white/[.02]">
                    <h3 class="text-2xl font-bold text-white mb-3">Takeaways</h3>
                    <p class="text-slate-300 mb-4">
                        We implemented the search algorithms, tested them against each other and backed the comparison with data.
                        The ideas behind the heuristics we designed carry over
                        to real-world AI problems.
                    </p>
                    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
                        <span class="text-cy">✓ A* Search</span>
                        <span class="text-cy">✓ Custom Heuristics</span>
                        <span class="text-cy">✓ Performance Analysis</span>
                        <span class="text-cy">✓ Python Implementation</span>
                    </div>
                </div>

            
</ProjectPage>