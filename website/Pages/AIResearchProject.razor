@page "/projects/portfolio"
@using website.Data


<ProjectPage Url="/projects/portfolio" Kicker="Personal Project">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A comprehensive C# learning project built as a full-stack web application, showcasing advanced .NET concepts, language features, and professional development practices
                </p>
                
                <!-- Learning Objective -->
                <ProjectSection Title="Learning Objective" Icon="fas fa-graduation-cap">
                    <p class="text-gray-300 text-lg leading-relaxed">
                        This portfolio serves as my comprehensive C# learning journey, built as a full-stack web application to explore advanced .NET concepts and language features. Through implementing Blazor WebAssembly frontend and ASP.NET Core Web API backend, I've gained hands-on experience with async/await patterns, dependency injection, component architecture, API design, and professional email integration. The project demonstrates practical C# development skills while creating a production-ready application that showcases both learning progress and professional development capabilities.
                    </p>
                </ProjectSection>

                <!-- Technology Deep Dive -->
                <ProjectSection Title="C# & .NET Technologies Explored" Icon="fas fa-code">
                    <p class="text-gray-300 mb-6">Hands-on learning with enterprise-grade Microsoft technologies:</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <div class="flex items-center mb-4">
                                <div class="bg-cy/10 rounded-full w-3 h-3 mr-3"></div>
                                <h3 class="text-xl font-bold text-slate-100">Blazor WebAssembly</h3>
                            </div>
                            <p class="text-gray-400 text-sm">Client-side C# web development with WebAssembly for high-performance SPAs without JavaScript frameworks.</p>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <div class="flex items-center mb-4">
                                <div class="bg-cy/10 rounded-full w-3 h-3 mr-3"></div>
                                <h3 class="text-xl font-bold text-slate-100">.NET 8</h3>
                            </div>
                            <p class="text-gray-400 text-sm">Latest .NET platform with improved performance, new language features, and modern development patterns.</p>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <div class="flex items-center mb-4">
                                <div class="bg-cy/10 rounded-full w-3 h-3 mr-3"></div>
                                <h3 class="text-xl font-bold text-slate-100">Component Architecture</h3>
                            </div>
                            <p class="text-gray-400 text-sm">Razor components, parameter binding, lifecycle methods, and reusable UI patterns.</p>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <div class="flex items-center mb-4">
                                <div class="bg-cyan-500 rounded-full w-3 h-3 mr-3"></div>
                                <h3 class="text-xl font-bold text-slate-100">Dependency Injection</h3>
                            </div>
                            <p class="text-gray-400 text-sm">Built-in DI container, service registration, and modern .NET architectural patterns.</p>
                        </div>
                    </div>
                </ProjectSection>

                <!-- MCP & AI Architecture -->
                <ProjectSection Title="AI & MCP Architecture" Icon="fas fa-network-wired">
                    
                    <p class="text-gray-300 text-lg leading-relaxed mb-8">
                        This website goes beyond a static portfolio; it is a fully interactive <strong>Model Context Protocol (MCP) Server</strong> and <strong>AI-Agentic Platform</strong>. It demonstrates the future of web development where sites are both human-readable and machine-readable.
                    </p>

                    <div class="space-y-8">
                        <!-- 1. Custom MCP Server -->
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-white mb-3">1. Custom MCP Server</h3>
                            <p class="text-gray-400 mb-4">
                                The ASP.NET Core backend implements the open Model Context Protocol standard (JSON-RPC 2.0).
                            </p>
                            <ul class="space-y-2 text-gray-300">
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Machine Readable:</strong> AI agents (like LM Studio) can connect to this site to "read" my skills, experience, and projects as structured data resources.</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Tool Exposure:</strong> Exposes executable tools like <code>search_projects(query)</code> and <code>submit_contact(message)</code> directly to connected LLMs.</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Remote MCP (SSE):</strong> Fully optimized for Server-Sent Events, allowing seamless connection from local AI clients without complex networking.</span>
                                </li>
                            </ul>
                        </div>

                        <!-- 2. Interactive AI Assistant (RAG) -->
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-white mb-3">2. Interactive AI Assistant</h3>
                            <p class="text-gray-400 mb-4">
                                A built-in AI chat interface (available in the navbar) that allows visitors to ask natural language questions about my background.
                            </p>
                            <ul class="space-y-2 text-gray-300">
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Context-Aware (RAG):</strong> The assistant is injected with my full portfolio data as context, allowing it to answer questions about my specific projects and skills accurately.</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Gemini 3 Flash Integration:</strong> Powered by Google's efficient Gemini 3 Flash model for fast, high-quality reasoning.</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Full-Screen Mode:</strong> A responsive, immersive chat experience that adapts from a side-panel to a full-screen workspace.</span>
                                </li>
                            </ul>
                        </div>

                        <!-- 3. Local LLM Bridge -->
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-white mb-3">3. Hosted Local LLMs</h3>
                            <p class="text-gray-400 mb-4">
                                Values privacy and sovereign compute? The site connects directly to my own on-premise hardware.
                            </p>
                            <ul class="space-y-2 text-gray-300">
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>Server-Side Inference:</strong> The website communicates with an Ollama instance running on my personal server, allowing you to chat with models like Llama 3 or Mistral running entirely on my infrastructure.</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fas fa-check-circle text-cy mt-1 mr-3"></i>
                                    <span><strong>No External Clouds:</strong> When using the "Ollama" provider, your chat data never leaves my server, ensuring complete privacy from big tech AI providers.</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Learning Areas -->
                <ProjectSection Title="Key Learning Areas" Icon="fas fa-book-open">
                    <p class="text-gray-300 mb-6">Practical C# and web development concepts mastered through this project:</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">C# Language Features:</strong>
                                <span class="text-gray-400"> Records, nullable types, async/await, LINQ</span>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">Web Development:</strong>
                                <span class="text-gray-400"> SPA architecture, responsive design, CSS frameworks</span>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">Project Structure:</strong>
                                <span class="text-gray-400"> .NET project organization, namespaces, file structure</span>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">Development Tools:</strong>
                                <span class="text-gray-400"> .NET CLI, hot reload, debugging, deployment</span>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">Modern Patterns:</strong>
                                <span class="text-gray-400"> Service patterns, data binding, event handling</span>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="bg-cy rounded-full w-2 h-2 mt-2 mr-3 flex-shrink-0"></div>
                            <div>
                                <strong class="text-white">AI-Assisted Development:</strong>
                                <span class="text-gray-400"> Learning with Claude Code guidance and mentorship</span>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Portfolio Purpose & Professional Impact Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Portfolio Purpose -->
                    <ProjectSection Title="Portfolio Purpose" Icon="fas fa-briefcase">
                        <p class="text-gray-300 mb-4">This site serves multiple audiences:</p>
                        <ul class="space-y-3">
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300"><strong>Recruiters & Employers:</strong> Professional project showcase</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300"><strong>Fellow Developers:</strong> Learning journey documentation</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300"><strong>General Visitors:</strong> Technical skills demonstration</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300"><strong>Personal Growth:</strong> Progress tracking and reflection</span>
                            </li>
                        </ul>
                </ProjectSection>

                    <!-- Professional Value -->
                    <ProjectSection Title="Professional Value" Icon="fas fa-star">
                        <p class="text-gray-300 mb-4">Skills and qualities demonstrated:</p>
                        <ul class="space-y-3">
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300">Rapid learning and technology adoption</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300">Modern development workflow proficiency</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300">AI-augmented productivity mindset</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300">Full-stack web development capability</span>
                            </li>
                            <li class="flex items-start">
                                <span class="text-cy mr-3 mt-1">•</span>
                                <span class="text-gray-300">Self-directed learning and documentation</span>
                            </li>
                        </ul>
                </ProjectSection>
                </div>

                <!-- Technical Implementation -->
                <ProjectSection Title="Technical Implementation" Icon="fas fa-cogs">
                    <p class="text-gray-400 mb-6">Built with modern Microsoft technologies and development practices</p>
                    <div class="flex flex-wrap justify-center gap-3">
                        <span class="chip">Blazor WebAssembly</span>
                        <span class="chip">.NET 8</span>
                        <span class="chip">C#</span>
                        <span class="chip">Tailwind CSS</span>
                        <span class="chip">Responsive Design</span>
                        <span class="chip">Font Awesome</span>
                        <span class="chip">Vanilla Tilt.js</span>
                        <span class="bg-white/[.02] text-white px-4 py-2 rounded-full text-sm">GitHub Deployment</span>
                        <span class="chip">Claude Code AI</span>
                        <span class="chip">MCP Integration</span>
                        <span class="chip">JSON-RPC</span>
                    </div>
                </ProjectSection>

                <!-- Project Documentation -->
                <ProjectSection Title="Source Code & Documentation" Subtitle="Blazor WebAssembly implementation details" Icon="fas fa-code-branch">
                    <div class="grid md:grid-cols-1 gap-4">
                        <a href="https://github.com/DynoAbd786/Portfolio-website" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fab fa-github mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">GitHub Repository</div>
                                <div class="text-sm opacity-90">Complete .NET 8 Blazor WebAssembly source</div>
                            </div>
                        </a>
                    </div>
                </ProjectSection>
            
</ProjectPage>