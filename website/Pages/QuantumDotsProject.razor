                <!-- Quantum Dot Technology Deep Dive -->
                <ProjectSection Title="Quantum Dot Technology" Icon="fas fa-atom">
                    <p class="text-gray-300 mb-6">Quantum dots are semiconductor nanocrystals with diameters of 2-10 nanometers, containing 10-50 atoms that exhibit quantum mechanical properties crucial for photonic quantum computing:</p>

                    <!-- Core Science -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-cyan-600/25">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-microscope mr-3"></i>Fundamental Physics
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>Band Gap Engineering:</strong> Electrons excited from valence to conduction band</li>
                                <li><strong>Photon Emission:</strong> De-excitation produces photons of specific energy/wavelength</li>
                                <li><strong>Quantum Confinement:</strong> Size-dependent optical properties</li>
                                <li><strong>Photoluminescent Efficiency:</strong> Maximized through proper coating materials</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-industry mr-3"></i>Manufacturing Process
                            </h3>
                            <ul class="space-y-2 text-gray-300 text-sm">
                                <li><strong>Molecular Beam Epitaxy (MBE):</strong> Precision crystal growth under ultra-high vacuum</li>
                                <li><strong>Gallium Arsenide Substrate:</strong> III-V semiconductor material for optimal performance</li>
                                <li><strong>Self-Assembly Process:</strong> Strain-induced island formation</li>
                                <li><strong>Capping Layer:</strong> Protective coating to prevent electron escape</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Key Advantages -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Critical Properties for Quantum Computing</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <h4 class="font-bold text-white mb-2">Identical Photon Generation</h4>
                                <p class="text-gray-400 text-sm">Essential for quantum interference effects and entanglement operations in photonic quantum circuits.</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">Precise Timing Control</h4>
                                <p class="text-gray-400 text-sm">Synchronized photon emission enables deterministic quantum gate operations.</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-2">Scalable Architecture</h4>
                                <p class="text-gray-400 text-sm">Can be integrated into large-scale photonic quantum computing systems.</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Photonic Quantum Computing Innovation -->
                <ProjectSection Title="Revolutionary Application: Photonic Quantum Computing" Icon="fas fa-lightbulb">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy/10 rounded-full w-3 h-3 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">The Innovation</h3>
                        </div>
                        <p class="text-gray-300 leading-relaxed">
                            While major technology companies invested heavily in traditional electron-based quantum computing, this research identified the untapped potential of <strong>photonic quantum computing</strong> - using light instead of electrons for quantum computation. Quantum dots serve as the critical component for generating the identical photons required for this revolutionary approach.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Hong-Ou-Mandel Effect</h3>
                            <p class="text-gray-300 text-sm mb-3">Fundamental quantum phenomenon enabling photonic computation:</p>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• Identical photons from quantum dots enter beam splitter</li>
                                <li>• Quantum interference creates entangled photon pairs</li>
                                <li>• Superposition states enable quantum computation</li>
                                <li>• Measurement-based quantum processing</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Competitive Advantages</h3>
                            <p class="text-gray-300 text-sm mb-3">Superior to electron-based systems:</p>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• <strong>Speed of light processing:</strong> Photon-based computation</li>
                                <li>• <strong>Room temperature operation:</strong> No cryogenic cooling required</li>
                                <li>• <strong>Lower energy consumption:</strong> Reduced operational costs</li>
                                <li>• <strong>Enhanced scalability:</strong> Modular architecture design</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

