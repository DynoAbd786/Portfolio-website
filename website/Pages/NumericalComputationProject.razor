                </ProjectSection>

                <!-- Differential Equation System -->
                <ProjectSection Title="Predator-Prey Mathematical System" Icon="fas fa-function">

                    <!-- Mathematical Equations -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-cyan-600/25 mb-8">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Lotka-Volterra Equations with Forcing</h3>
                        <div class="bg-ink rounded-lg p-6 font-mono text-lg">
                            <div class="text-cy mb-4">// Differential equation system</div>
                            <div class="text-gray-300 space-y-2">
                                <div><span class="text-cy">dx/dt</span> = αx - βxy + <span class="text-cy">f(t)</span>  <span class="text-cy">// Prey dynamics</span></div>
                                <div><span class="text-cy">dy/dt</span> = δxy - γy + <span class="text-cy">g(t)</span>  <span class="text-cy">// Predator dynamics</span></div>
                                <br/>
                                <div class="text-cy">// Where: α,β,γ,δ = population parameters</div>
                                <div class="text-cy">//        f(t),g(t) = external migration functions</div>
                            </div>
                        </div>
                    </div>

                    <!-- Test Cases -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-check-circle mr-3"></i>Test Case A - Validation
                            </h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div>
                                    <strong class="text-white">Parameters:</strong> α = β = γ = δ = 1
                                </div>
                                <div>
                                    <strong class="text-white">Initial:</strong> x(0) = 2, y(0) = 0
                                </div>
                                <div>
                                    <strong class="text-white">Forcing Functions:</strong>
                                    <code class="block bg-ink p-2 mt-1 rounded text-cy text-xs">
                                        f(t) = -sin(t) - cos²(t) - cos(t)<br/>
                                        g(t) = sin(t) + cos²(t) - cos(t)
                                    </code>
                                </div>
                                <div>
                                    <strong class="text-white">True Solution:</strong>
                                    <code class="block bg-ink p-2 mt-1 rounded text-cy text-xs">
                                        x(t) = 1 + cos(t)<br/>
                                        y(t) = 1 - cos(t)
                                    </code>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-cogs mr-3"></i>Test Case B - Realistic
                            </h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div>
                                    <strong class="text-white">Parameters:</strong> α = 2/3, β = 4/3, γ = δ = 1
                                </div>
                                <div>
                                    <strong class="text-white">Initial:</strong> x(0) = 0.9, y(0) = 0.9
                                </div>
                                <div>
                                    <strong class="text-white">Forcing:</strong> f(t) = g(t) = 0
                                </div>
                                <div>
                                    <strong class="text-white">Expected Behavior:</strong>
                                    <ul class="mt-2 space-y-1 text-gray-400">
                                        <li>• Populations oscillate periodically</li>
                                        <li>• Peaks stay the same height over time</li>
                                        <li>• Stable over long runs</li>
                                        <li>• No analytical solution to compare against</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Numerical Methods Implementation -->
                <ProjectSection Title="Numerical Methods Arsenal" Icon="fas fa-code">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
