                <ProjectSection Title="Advanced Linear Regression with Custom Basis Functions" Subtitle="Sophisticated trajectory modeling and comparative analysis" Icon="fas fa-chart-line">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Question 1: Trajectory Analysis</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Data Visualization</h4>
                                    <p class="text-sm text-gray-300">3D trajectory plotting (t-x, t-y, x-y), time series analysis, 2D spatial visualization</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Exponential Basis Functions</h4>
                                    <p class="text-sm text-gray-300">Gaussian-like exponential functions with 50 basis elements, normalized predictions</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Polynomial Basis Functions</h4>
                                    <p class="text-sm text-gray-300">Custom polynomial implementation up to degree n-1, comparative performance analysis</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Basis Function Comparison</h3>
                            <div class="bg-white/[.02] rounded-lg p-4 mb-4">
                                <h4 class="font-bold text-slate-100 mb-2">Performance Analysis</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Testing across 2, 5, 10, and 50 basis functions</li>
                                    <li>• Exponential basis functions show superior performance</li>
                                    <li>• Polynomial overfitting at higher basis numbers</li>
                                    <li>• Qualitative and quantitative evaluation methods</li>
                                </ul>
                            </div>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Advanced Basis Functions</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Sine/Cosine trigonometric basis functions</li>
                                    <li>• Gaussian basis with configurable centers and widths</li>
                                    <li>• Sigmoid basis functions for nonlinear modeling</li>
                                    <li>• Optimal basis selection for periodic data patterns</li>
                                </ul>
                            </div>
                        </div>
                    </div>
