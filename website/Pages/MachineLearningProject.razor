                <ProjectSection Title="Project Documentation" Subtitle="Assignment brief and course requirements" Icon="fas fa-file-pdf">
                    <div class="flex justify-center">
                        <a href="/docs/machine-learning-coursework-brief.pdf" target="_blank"
                           class="px-8 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
