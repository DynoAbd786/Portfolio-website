@page "/projects/xv6-operating-system"
@using website.Data


<ProjectPage Url="/projects/xv6-operating-system" Kicker="Academic Project · Year 2">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    Operating systems coursework where I wrote a Unix-style shell for xv6 and extended its kernel with new system calls.
                </p>
                <!-- Project Overview & Architecture -->
                <ProjectSection Title="Project Architecture" Icon="fas fa-microchip">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">COMP2211 Operating Systems Coursework</h3>
                        </div>
                        <p class="text-gray-300 leading-relaxed">
                            An 11-week lab series built around xv6, MIT's teaching reimplementation of Unix Version 6. It targets RISC-V
                            and runs under QEMU. Over the labs I wrote user programs, added system calls to the kernel, fixed and tuned the
                            memory allocator, and built a shell from scratch.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Technical Foundation</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• xv6 operating system (MIT)</li>
                                <li>• RISC-V architecture & QEMU emulation</li>
                                <li>• Development inside a container</li>
                                <li>• Systems programming in C</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Core Components</h4>
                            <ul class="text-gray-400 text-sm space-y-1">
                                <li>• A shell written from scratch (582 lines)</li>
                                <li>• New system calls</li>
                                <li>• Memory allocator fixes and tuning</li>
                                <li>• Communication between processes</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Custom Shell Implementation -->
                <ProjectSection Title="Advanced Shell Implementation" Icon="fas fa-terminal">

                    <!-- Shell Features -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-cyan-600/25">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-code-branch mr-3"></i>Pipeline Processing
                            </h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div>
                                    <strong class="text-white">Multi-element:</strong> Chains of any length
                                </div>
                                <div>
                                    <strong class="text-white">Recursive:</strong> Built with inverse recursion
                                </div>
                                <div>
                                    <strong class="text-white">Example:</strong>
                                    <code class="block bg-ink p-2 mt-1 rounded text-cy">ls | grep test | cat</code>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-exchange-alt mr-3"></i>I/O Redirection
                            </h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div>
                                    <strong class="text-white">Input:</strong> File to stdin (&lt;)
                                </div>
                                <div>
                                    <strong class="text-white">Output:</strong> Stdout to file (&gt;)
                                </div>
                                <div>
                                    <strong class="text-white">Example:</strong>
                                    <code class="block bg-ink p-2 mt-1 rounded text-cy">echo "hello" > file.txt</code>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-list mr-3"></i>Sequential Commands
                            </h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div>
                                    <strong class="text-white">Operator:</strong> Semicolon (;) separator
                                </div>
                                <div>
                                    <strong class="text-white">Execution:</strong> One after another
                                </div>
                                <div>
                                    <strong class="text-white">Example:</strong>
                                    <code class="block bg-ink p-2 mt-1 rounded text-cy">ls; echo "done"</code>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Code Architecture Example -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Shell Architecture & Parsing</h3>
                        <div class="bg-ink rounded-lg p-4 font-mono text-sm">
                            <div class="text-cy mb-2">// Command execution pipeline architecture</div>
                            <div class="text-gray-300 mb-4">
                                <span class="text-cy">typedef struct</span> {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">char</span> *argv[MAXARG];<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">char</span> *endBuffer;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">int</span> endOfLine;<br/>
                                } <span class="text-cy">execCommand</span>;<br/><br/>

                                <span class="text-cy">// Multi-stage parsing: Tokenize → Parse → Walk → Execute</span><br/>
                                <span class="text-cy">parseCommand</span>() → <span class="text-cy">tokenize</span>() → <span class="text-cy">parseLine</span>() → <span class="text-cy">walkCommand</span>()
                            </div>
                            <div class="text-cy mb-2">// Pipeline processing with recursive fork/exec</div>
                            <div class="text-gray-300">
                                <span class="text-cy">void</span> <span class="text-cy">runPipelines</span>(<span class="text-cy">execCommand</span> *commands[], <span class="text-cy">int</span> numPipes)<br/>
                                {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">// Recursive pipeline handling with proper file descriptor management</span><br/>
                                }
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- System Calls & Kernel Development -->
                <ProjectSection Title="System Calls & Kernel Programming" Icon="fas fa-cogs">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Custom System Calls</h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div><strong>Implementation:</strong> Added new system calls to the xv6 kernel</div>
                                <div><strong>Files Modified:</strong> syscall.h, syscall.c, sysproc.c, usys.pl, user.h</div>
                                <div><strong>Example:</strong> getyear(), which returns the year Unix v6 was released (1975)</div>
                                <div>
                                    <strong>Process:</strong>
                                    <ul class="mt-2 space-y-1 text-gray-400">
                                        <li>• Write the function in kernel space</li>
                                        <li>• Declare the user space interface</li>
                                        <li>• Assign a system call number</li>
                                        <li>• Call it from a user program</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">User Programs Developed</h3>
                            <div class="space-y-3 text-gray-300 text-sm">
                                <div><strong>sleep:</strong> Pauses for a given number of ticks</div>
                                <div><strong>ping-pong:</strong> Two processes talking over pipes</div>
                                <div><strong>find:</strong> Searches a directory tree recursively</div>
                                <div><strong>xargs:</strong> Runs a command with arguments read from a pipe</div>
                                <div>
                                    <strong>Features:</strong>
                                    <ul class="mt-2 space-y-1 text-gray-400">
                                        <li>• Forking processes and waiting on them</li>
                                        <li>• Working with file descriptors</li>
                                        <li>• Dynamic memory allocation</li>
                                        <li>• Error handling and input checks</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Memory Management -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Advanced Memory Management</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <h4 class="font-bold text-white mb-3">malloc/free Implementation</h4>
                                <ul class="text-gray-400 text-sm space-y-1">
                                    <li>• <strong>Debugging:</strong> Found and fixed bugs in xv6's allocator</li>
                                    <li>• <strong>Alignment:</strong> Blocks aligned to 16 bytes</li>
                                    <li>• <strong>Efficiency:</strong> Better use of sbrk() for physical memory</li>
                                    <li>• <strong>Return Policy:</strong> Freed blocks at the end go back to the OS</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-3">Data Structures</h4>
                                <ul class="text-gray-400 text-sm space-y-1">
                                    <li>• <strong>Linked Lists:</strong> Nodes allocated and linked by hand in C</li>
                                    <li>• <strong>Operations:</strong> Insert, delete, traverse, search</li>
                                    <li>• <strong>Memory Safety:</strong> Careful malloc/free use</li>
                                    <li>• <strong>Error Handling:</strong> Input checked before use</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

