                            <div class="text-cy mb-2">// Command execution pipeline architecture</div>
                            <div class="text-gray-300 mb-4">
                                <span class="text-cy">typedef struct</span> {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">char</span> *argv[MAXARG];<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">char</span> *endBuffer;<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">int</span> endOfLine;<br/>
                                } <span class="text-cy">execCommand</span>;<br/><br/>

                                <span class="text-cy">// Multi-stage parsing: Tokenize → Parse → Walk → Execute</span><br/>
                                <span class="text-cy">parseCommand</span>() → <span class="text-cy">tokenize</span>() → <span class="text-cy">parseLine</span>() → <span class="text-cy">walkCommand</span>()
                            </div>
                            <div class="text-cy mb-2">// Pipeline processing with recursive fork/exec</div>
                            <div class="text-gray-300">
                                <span class="text-cy">void</span> <span class="text-cy">runPipelines</span>(<span class="text-cy">execCommand</span> *commands[], <span class="text-cy">int</span> numPipes)<br/>
                                {<br/>
                                &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-cy">// Recursive pipeline handling with proper file descriptor management</span><br/>
                                }
                            </div>
                        </div>
