@page "/projects/parallel-computing"
@using website.Data

<PageTitle>Advanced Parallel Computing: OpenMP, MPI & OpenCL - Muhammad Kashif-Khan</PageTitle>

<div class="bg-gray-900 text-gray-200 min-h-screen">
    <!-- Header Section -->
    <div class="bg-gradient-to-r from-purple-900 via-blue-900 to-indigo-900 py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
