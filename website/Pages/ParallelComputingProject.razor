@page "/projects/parallel-computing"
@using website.Data

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-purple-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-purple-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">Advanced Parallel Computing</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-purple-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Academic Project
            </div>
            <h1 class="text-5xl font-bold text-white mb-4">Advanced Parallel Computing</h1>
            <h2 class="text-2xl text-gray-400 mb-6">OpenMP, MPI & OpenCL Mastery</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                OpenMP, MPI & OpenCL: Mastering the Complete Parallel Programming Ecosystem. A specialization demonstrating mastery across shared memory, distributed message passing, and GPU acceleration paradigms.
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">OpenMP</span>
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">MPI</span>
                <span class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm">OpenCL</span>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">C Programming</span>
                <span class="bg-red-600 text-white px-4 py-2 rounded-full text-sm">GPU Computing</span>
            </div>
        </div>

        <!-- Hero Visual -->
        <div class="bg-gradient-to-r from-purple-900 to-blue-900 rounded-lg p-12 mb-16 text-center border border-gray-700">
            <div class="text-8xl mb-4">⚡</div>
             <p class="text-white/75 text-lg">Parallel Architecture • Distributed Systems • GPU Kernels • High Performance</p>
        </div>

        <div class="max-w-6xl mx-auto">
            <!-- Main Content Sections -->
            <div class="grid grid-cols-1 gap-8">
                
                <!-- Project Overview -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                     <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-microchip text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-purple-400">Project Overview</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This comprehensive parallel computing specialization demonstrates mastery across three fundamental paradigms of high-performance computing through the COMP3221 Parallel Computation module at the University of Leeds.
                    </p>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        Each coursework builds upon previous concepts, creating a complete understanding of parallel programming from shared memory systems to distributed clusters and GPU acceleration.
                    </p>
                    <div class="bg-yellow-900/20 border border-yellow-500/30 rounded-lg p-4">
                        <p class="text-yellow-200 text-sm flex items-start">
                            <i class="fas fa-info-circle mt-1 mr-2"></i>
                            <span>
                                <strong>Academic Context:</strong> Due to a long-term illness during this period, the implementations represent focused effort on core parallel computing concepts rather than extensive feature development.
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Coursework 1: OpenMP -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-memory text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-purple-400">OpenMP: Shared Memory</h2>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-purple-600/25">
                            <h4 class="text-xl font-bold text-purple-400 mb-3">Game of Life</h4>
                            <p class="text-gray-300 text-sm mb-4">
                                Parallelized the classic cellular automaton using OpenMP directives, implementing four key parallel functions with proper handling of data dependencies and race conditions.
                            </p>
                            <ul class="space-y-2 text-sm text-gray-400">
                                <li>• 283 lines of optimized C code</li>
                                <li>• Red-black pattern for modified rules</li>
                                <li>• Thread-safe random generation</li>
                            </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-purple-600/25">
                            <h4 class="text-xl font-bold text-purple-400 mb-3">Key Functions</h4>
                            <div class="text-xs font-mono text-gray-300 space-y-1">
                                <div>numCells() - Reduction</div>
                                <div>initialiseGrid() - Parallel Init</div>
                                <div>iterateOriginal() - Moore</div>
                                <div>iterateModified() - Red-Black</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coursework 2: MPI -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-blue-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-full p-3 mr-4">
                            <i class="fas fa-network-wired text-white text-xl"></i>
                        </div>
                         <h2 class="text-3xl font-bold text-blue-400">MPI: Distributed Systems</h2>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                            <h4 class="text-xl font-bold text-blue-400 mb-3">Distributed Computing</h4>
                            <p class="text-gray-300 text-sm mb-4">
                                Developed MPI applications with comprehensive performance analysis across multiple machines, demonstrating understanding of distributed computing challenges.
                            </p>
                            <ul class="space-y-2 text-sm text-gray-400">
                                <li>• 199 lines of MPI C implementation</li>
                                <li>• Multi-machine cluster deployment</li>
                                <li>• Scalability analysis up to 32 processes</li>
                            </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                             <h4 class="text-xl font-bold text-blue-400 mb-3">Speedup Analysis</h4>
                            <div class="text-xs font-mono text-gray-300 space-y-1">
                                <div class="flex justify-between"><span>1 Proc:</span> <span class="text-green-400">1.00x</span></div>
                                <div class="flex justify-between"><span>2 Procs:</span> <span class="text-green-400">1.42x</span></div>
                                <div class="flex justify-between"><span>4 Procs:</span> <span class="text-green-400">1.74x</span></div>
                                <div class="flex justify-between"><span>8 Procs:</span> <span class="text-green-400">3.09x</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coursework 3: OpenCL -->
                 <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-indigo-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full p-3 mr-4">
                            <i class="fas fa-microchip text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-indigo-400">OpenCL: GPU Acceleration</h2>
                    </div>
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-indigo-600/25">
                            <h4 class="text-xl font-bold text-indigo-400 mb-3">Heat Equation Solver</h4>
                            <p class="text-gray-300 text-sm mb-4">
                                Implemented OpenCL kernels for solving the heat equation on 2D grids, demonstrating mastery of GPU programming concepts including memory management and kernel optimization.
                            </p>
                            <ul class="space-y-2 text-sm text-gray-400">
                                <li>• 184 lines of C + OpenCL kernels</li>
                                <li>• Optimized GPU memory transfers</li>
                                <li>• Massively parallel execution</li>
                            </ul>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-indigo-600/25">
                             <h4 class="text-xl font-bold text-indigo-400 mb-3">Features</h4>
                             <div class="text-xs font-mono text-gray-300 space-y-1">
                                <div>• Host-device memory mgmt</div>
                                <div>• 2D work-group optimization</div>
                                <div>• Boundary condition handling</div>
                                <div>• Cross-platform GPU support</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Technical Insights & Stats -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Technical Insights -->
                    <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-full p-3 mr-4">
                                <i class="fas fa-lightbulb text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-green-400">Technical Insights</h2>
                        </div>
                         <div class="grid grid-cols-1 gap-6">
                            <div>
                                <h4 class="font-semibold text-green-400 mb-2">Parallel Patterns</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Data parallelism</li>
                                    <li>• Task decomposition</li>
                                    <li>• Reduction operations</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-semibold text-yellow-400 mb-2">Synchronization</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Race condition prevention</li>
                                    <li>• Critical sections</li>
                                    <li>• GPU memory coherence</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-red-400 mb-2">Optimization</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Load balancing</li>
                                    <li>• Comm overhead analysis</li>
                                    <li>• Scalability benchmarking</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Stats & Achievements -->
                    <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-pink-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-pink-500 to-pink-600 rounded-full p-3 mr-4">
                                <i class="fas fa-trophy text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-pink-400">Stats & Achievements</h2>
                        </div>
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-pink-400 text-sm mb-2">Code Volume</h4>
                                <div class="space-y-2">
                                    <div class="flex justify-between text-sm">
                                        <span class="text-gray-400">OpenMP</span>
                                        <span class="text-white">283 lines</span>
                                    </div>
                                    <div class="flex justify-between text-sm">
                                        <span class="text-gray-400">MPI</span>
                                        <span class="text-white">199 lines</span>
                                    </div>
                                    <div class="flex justify-between text-sm">
                                        <span class="text-gray-400">OpenCL</span>
                                        <span class="text-white">184 lines</span>
                                    </div>
                                    <div class="flex justify-between text-sm border-t border-gray-700 pt-2">
                                        <span class="text-gray-400">Total</span>
                                        <span class="text-purple-400 font-bold">666 lines</span>
                                    </div>
                                </div>
                            </div>
                             <div>
                                <h4 class="font-semibold text-pink-400 text-sm mb-2">Key Wins</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• Parallel Game of Life (OpenMP)</li>
                                    <li>• 3.09x Speedup with MPI</li>
                                    <li>• GPU Heat Solver (OpenCL)</li>
                                    <li>• Race Condition Handling</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="bg-cyan-500 hover:bg-cyan-400 text-gray-900 font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>