@page "/"
@using website.Data
@inject ProjectService ProjectSvc

<PageTitle>Muhammad Kashif-Khan · Software Engineer</PageTitle>

@* data-permanent: enhanced navigation back to this page leaves the running scene (and the
   overlay it adds) alone instead of merging the server's HTML over it *@
<div id="hero" class="grid-bg" data-permanent>
    @* Desktop: the room fills the hero behind the text, centred in the space right of it (--frame-x,
       set by site.js). Phones: name, room, then the rest of the text (css/app.css). *@
    <section class="hero-section mx-auto max-w-7xl px-4 pb-12 pt-4 sm:px-6 sm:pb-14 sm:pt-10 lg:px-8" aria-label="Introduction">
        <div class="hero-copy">
            <div class="hero-head">
                <p class="hero-kicker mono-label mb-6 text-[13.5px]">// software engineer · ai systems</p>
                <h1 class="mb-6 text-5xl font-extrabold leading-[.93] tracking-[-.045em] text-white sm:text-6xl xl:text-7xl">
                    <span class="block">Muhammad</span>
                    <span class="block bg-gradient-to-r from-slate-100 to-slate-400 bg-clip-text pb-1 text-transparent">Kashif-Khan</span>
                </h1>
            </div>
            <div class="hero-body">
            <p class="mb-8 max-w-xl text-lg leading-relaxed text-slate-400">
                I take on problems I've never seen and ship working software for them: biomedical simulation, scientific tools, computer vision, cloud and AI.
                MEng Computer Science &amp; AI, University of Leeds, <strong class="font-semibold text-slate-100">First-Class Honours</strong>.
            </p>
            <div class="hero-buttons mb-8 flex flex-wrap gap-3">
                <a href="#work" class="btn-ghost">See my work <i class="fas fa-arrow-right text-sm" aria-hidden="true"></i></a>
                <a href="/docs/Muhammad-Kashif-Khan-CV.pdf?v=2026-10" target="_blank" class="btn-ghost">Download CV <i class="fas fa-download text-sm" aria-hidden="true"></i></a>
                <a href="#contact" class="btn-primary btn-shine">Get in touch</a>
            </div>
            @if (HomeContent.OpenToWork)
            {
                <p class="flex items-center gap-3 font-mono text-[13px] text-slate-400">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:animate-none"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                    </span>
                    Open to graduate software &amp; AI roles
                </p>
            }
            </div>
        </div>

        <div id="workshop" class="workshop" data-state="still">
            <div class="workshop-still">
                <img src="/images/workshop/still.webp" srcset="/images/workshop/still.webp 1x, /images/workshop/still@2x.webp 2x"
                     width="1600" height="1000" fetchpriority="high"
                     alt="An illustrated workshop room: a desk with two monitors, a 3D scanner, a server rack, a bookcase and a small robot" />
                @foreach (var hotspot in HomeContent.Workshop)
                {
                    var style = FormattableString.Invariant($"left:{hotspot.PinX}%;top:{hotspot.PinY}%");
                    if (hotspot.Action == "assistant")
                    {
                        <button type="button" class="workshop-pin" style="@style" onclick="mkChat.toggle()">@hotspot.Name</button>
                    }
                    else
                    {
                        <a class="workshop-pin" style="@style" href="@hotspot.Href">@hotspot.Name</a>
                    }
                }
            </div>
            <canvas class="workshop-canvas" aria-hidden="true"></canvas>
            <script type="application/json" id="workshop-data">@((MarkupString)HomeContent.WorkshopJson())</script>
        </div>
        @* Narrow screens: the pins would overlap, so the same links are listed under the room instead *@
        <ul class="workshop-links" aria-label="What's in the workshop">
            @foreach (var hotspot in HomeContent.Workshop)
            {
                <li>
                    @if (hotspot.Action == "assistant")
                    {
                        <button type="button" class="chip" onclick="mkChat.toggle()">@hotspot.Name</button>
                    }
                    else
                    {
                        <a class="chip" href="@hotspot.Href">@hotspot.Name</a>
                    }
                </li>
            }
        </ul>
    </section>
    @* The name build (js/intro) draws here while the scene loads; hidden unless the intro runs *@
    <canvas class="hero-namefx" aria-hidden="true"></canvas>
    <p class="hero-loading font-mono text-xs tracking-wider text-slate-400" aria-hidden="true"><span></span>building the workshop</p>
    <p class="hero-scroll font-mono text-[11px] tracking-[.12em] text-slate-400" aria-hidden="true">scroll<span></span></p>
</div>

@* The rest of the page slides up over the hero on desktop *@
<div class="hero-cover border-t border-line bg-ink">

<section id="stack" class="scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mono-label mb-3">// tech stack</p>
        <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-white sm:mb-12 sm:text-4xl">What I work with</h2>

        <dl class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
            @foreach (var group in HomeContent.Stack)
            {
                <div class="reveal surface p-4 sm:p-6">
                    <dt class="mono-label mb-3">// @group.Label</dt>
                    <dd>
                        <ul class="divide-y divide-line">
                            @foreach (var item in group.Items)
                            {
                                <li class="py-2.5 text-sm font-medium text-slate-200 last:pb-0 sm:text-base">@item</li>
                            }
                        </ul>
                    </dd>
                </div>
            }
        </dl>
    </div>
</section>

<section id="work" class="scroll-mt-20 border-t border-line py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mono-label mb-3">// selected work</p>
        <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Five projects, five different fields</h2>
        <p class="mb-8 max-w-2xl text-lg text-slate-400 sm:mb-12">Each one was new to me when I started.</p>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var (item, project) in selectedWork)
            {
                <article class="reveal surface group relative flex flex-col p-6 transition duration-300 hover:-translate-y-1 hover:border-cy/50">
                    <p class="mono-label mb-3">// @item.FieldLabel</p>
                    <h3 class="mb-3 text-xl font-bold leading-snug text-white">@project.Title</h3>
                    <p class="mb-5 flex-1 text-slate-400">@project.Result</p>
                    <div class="mb-5 flex flex-wrap gap-2">
                        @foreach (var tag in project.Tags.Take(4))
                        {
                            <span class="chip">@tag</span>
                        }
                    </div>
                    <a href="@project.ProjectUrl" class="font-semibold text-cy after:absolute after:inset-0 group-hover:underline">Read the case study →</a>
                </article>
            }
            <a href="/projects" class="reveal surface flex flex-col justify-center border-dashed p-6 text-center transition hover:border-cy/50">
                <span class="mb-2 text-xl font-bold text-white">All projects →</span>
                <span class="text-slate-400">Robotics, graphics, operating systems, parallel computing and more.</span>
            </a>
        </div>
    </div>
</section>

<section id="building" class="scroll-mt-20 border-t border-line py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mono-label mb-3">// what I'm building</p>
        <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Built in my own time</h2>
        <p class="mb-8 max-w-2xl text-lg text-slate-400 sm:mb-12">Two projects I keep coming back to, both about developer tools and AI agents.</p>

        <div class="grid gap-6 md:grid-cols-2">
            @foreach (var product in HomeContent.Products)
            {
                <article class="reveal surface relative flex flex-col p-7">
                    <div class="mb-4 flex items-center justify-between gap-4">
                        <h3 class="text-2xl font-bold text-white">@product.Name</h3>
                        <span class="chip border-lamp/40 text-lamp">in development</span>
                    </div>
                    <p class="mb-6 flex-1 leading-relaxed text-slate-400">@product.Summary</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in product.Tags)
                        {
                            <span class="chip">@tag</span>
                        }
                    </div>
                    @if (product.Href is not null)
                    {
                        <a href="@product.Href" class="mt-6 font-semibold text-cy hover:underline">Where it is now →</a>
                    }
                </article>
            }
        </div>
    </div>
</section>

<section id="experience" class="scroll-mt-20 border-t border-line py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mono-label mb-3">// experience</p>
        <h2 class="mb-12 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Experience &amp; education</h2>

        <ol class="relative ml-2 max-w-3xl border-l border-line">
            @foreach (var entry in HomeContent.Experience)
            {
                <li class="reveal relative mb-10 pl-8 last:mb-0">
                    <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-cy shadow-[0_0_12px_rgba(34,211,238,.8)]" aria-hidden="true"></span>
                    <p class="mb-1 font-mono text-xs text-slate-400">@entry.When</p>
                    <h3 class="text-lg font-bold text-white">@entry.Title</h3>
                    <p class="mb-2 text-sm text-cy">@entry.Org</p>
                    <p class="text-slate-400">@entry.Detail</p>
                </li>
            }
        </ol>
    </div>
</section>

<div class="border-t border-line">
    <ContactForm />
</div>

</div>

@code {
    private List<(SelectedWorkItem Item, Project Project)> selectedWork = new();

    protected override async Task OnInitializedAsync()
    {
        var projects = await ProjectSvc.GetProjectsAsync();
        selectedWork = HomeContent.SelectedWork
            .Select(item => (item, project: projects.FirstOrDefault(p => p.ProjectUrl == item.ProjectUrl)))
            .Where(x => x.project is not null)
            .Select(x => (x.item, x.project!))
            .ToList();
    }
}
