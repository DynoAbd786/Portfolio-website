@using website.Data

@page "/projects"
@inject ProjectService ProjectSvc

<PageTitle>Projects</PageTitle>

<section class="py-20">
    <div class="container mx-auto px-4">
        <h2 class="text-5xl font-bold text-center mb-6 text-white">My Portfolio</h2>
        <p class="text-xl text-center text-gray-400 mb-12">Showcasing innovation through AI-assisted development and research</p>
        
        @if (projectList == null)
        {
            <div class="text-center">
                <div class="loader mx-auto mb-4"></div>
                <p class="text-gray-400"><em>Loading projects...</em></p>
            </div>
        }
        else
        {
            <!-- Professional Experience Projects Section -->
            @if (projectList.Any(p => p.Category == ProjectCategory.Professional))
            {
                <div class="mb-20">
                    <div class="flex items-center justify-center mb-8">
                        <div class="bg-gradient-to-r from-green-400 to-green-600 rounded-full p-3 mr-4">
                            <i class="fas fa-briefcase text-white text-xl"></i>
                        </div>
                        <div class="text-center">
                            <h3 class="text-3xl font-bold text-green-400 mb-1">Professional Experience</h3>
                            <p class="text-gray-400">Projects from internships and professional work</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
                        @foreach (var project in projectList.Where(p => p.Category == ProjectCategory.Professional))
                        {
                            <ProjectCard Project="project" />
                        }
                    </div>
                </div>
            }

            <!-- Academic Projects Section -->
            @if (projectList.Any(p => p.Category == ProjectCategory.Academic))
            {
                <div class="mb-20">
                    <div class="flex items-center justify-center mb-8">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-graduation-cap text-white text-xl"></i>
                        </div>
                        <div class="text-center">
                            <h3 class="text-3xl font-bold text-purple-400 mb-1">Academic Projects</h3>
                            <p class="text-gray-400">University coursework and research projects</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
                        @foreach (var project in projectList.Where(p => p.Category == ProjectCategory.Academic))
                        {
                            <ProjectCard Project="project" />
                        }
                    </div>
                </div>
            }
            @if (!projectList.Any(p => p.Category == ProjectCategory.Academic))
            {
                <div class="mb-20">
                    <div class="flex items-center justify-center mb-8">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-graduation-cap text-white text-xl"></i>
                        </div>
                        <div class="text-center">
                            <h3 class="text-3xl font-bold text-purple-400 mb-1">Academic Projects</h3>
                            <p class="text-gray-400">University coursework and research projects</p>
                        </div>
                    </div>
                    
                    <div class="max-w-2xl mx-auto">
                        <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300 text-center">
                            <div class="text-6xl text-gray-600 mb-4">🎓</div>
                            <h4 class="text-xl font-bold text-gray-300 mb-3">Coming Soon</h4>
                            <p class="text-gray-500">Academic projects from university coursework and research will be featured here</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Personal Projects Section -->
            @if (projectList.Any(p => p.Category == ProjectCategory.Personal))
            {
                <div class="mb-20">
                    <div class="flex items-center justify-center mb-8">
                        <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                            <i class="fas fa-rocket text-white text-xl"></i>
                        </div>
                        <div class="text-center">
                            <h3 class="text-3xl font-bold text-cyan-400 mb-1">Personal Projects</h3>
                            <p class="text-gray-400">Independent research and development initiatives</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
                        @foreach (var project in projectList.Where(p => p.Category == ProjectCategory.Personal))
                        {
                            <ProjectCard Project="project" />
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@code {
    private List<Project>? projectList;

    protected override async Task OnInitializedAsync()
    {
        projectList = await ProjectSvc.GetProjectsAsync();
    }
}