                <ProjectSection Title="CRISP-DM Research Methodology" Subtitle="Systematic data mining framework for healthcare AI development" Icon="fas fa-cogs">
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Business Understanding</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Clinical environment analysis</li>
                                <li>• Stakeholder engagement (doctors, nurses, patients)</li>
                                <li>• Documentation challenge identification</li>
                                <li>• Requirements gathering</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Data Preparation</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Advanced speech-to-text processing</li>
                                <li>• SpaCy-based pseudonymisation</li>
                                <li>• NHS SDE compliance protocols</li>
                                <li>• GDPR data protection measures</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Modelling & Evaluation</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• GPT-4 Turbo API implementation</li>
                                <li>• Action mapping algorithm development</li>
                                <li>• Performance metrics evaluation</li>
                                <li>• User feedback integration</li>
                            </ul>
                        </div>
                    </div>
