@page "/projects/data-mining"
@using website.Data


<ProjectPage Url="/projects/data-mining" Kicker="Academic Project · Year 2">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A research proposal, written in the EPSRC format, for an AI system that drafts medical documentation within NHS workflows. It follows the CRISP-DM methodology from start to finish.
                </p>
                <!-- Course Information & Research Framework -->
                <ProjectSection Title="Course Information" Subtitle="COMP2121 - Data Mining, University of Leeds" Icon="fas fa-university">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Course Details</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Module:</strong> COMP2121 - Data Mining</p>
                                <p><strong>Institution:</strong> University of Leeds</p>
                                <p><strong>Year:</strong> 2023/24 (Year 2)</p>
                                <p><strong>Assessment:</strong> Research Proposal Report (70% weight)</p>
                                <p><strong>Format:</strong> EPSRC Research Proposal</p>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Research Framework</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Methodology:</strong> CRISP-DM Framework</p>
                                <p><strong>Focus:</strong> AI-Powered Healthcare Documentation</p>
                                <p><strong>Length:</strong> 12 pages + Gantt Chart + Appendix</p>
                                <p><strong>Scope:</strong> NHS Workflow Integration</p>
                                <p><strong>Proposal:</strong> A patient-centred EHR system</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Research Hypothesis & Technical Architecture -->
                <ProjectSection Title="Research Hypothesis" Subtitle="What the proposal set out to test, and how the system would work" Icon="fas fa-flask">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Primary Hypothesis</h3>
                            <p class="text-gray-300 mb-4">
                                A patient-centred AI system that feeds directly into electronic health records will cut documentation time significantly and make NHS workflows more efficient.
                            </p>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Highlights</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Proposed as the first healthcare system to use GPT at this scale</li>
                                    <li>• Targets the admin burden on the NHS's 1.8M workers</li>
                                    <li>• A new way to process patient-doctor conversations</li>
                                    <li>• A pseudonymisation pipeline designed to comply with GDPR</li>
                                </ul>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Technical Architecture</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Data Collection & Processing</h4>
                                    <p class="text-sm text-gray-300">Consultations are recorded in high-quality audio, converted to text, then pseudonymised with SpaCy NER</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">AI Integration</h4>
                                    <p class="text-sm text-gray-300">The GPT-4 Turbo API turns each transcript into standardised clinical documentation</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Workflow Automation</h4>
                                    <p class="text-sm text-gray-300">Action mapping algorithms link to the NHS Spine and keep treatment plans up to date</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- CRISP-DM Methodology -->
                <ProjectSection Title="CRISP-DM Research Methodology" Subtitle="The data mining framework the project would follow" Icon="fas fa-cogs">
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Business Understanding</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Study the clinical environment</li>
                                <li>• Talk to doctors, nurses and patients</li>
                                <li>• Pin down where documentation goes wrong</li>
                                <li>• Gather requirements</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Data Preparation</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Speech-to-text conversion</li>
                                <li>• Pseudonymisation with SpaCy</li>
                                <li>• Following NHS SDE compliance protocols</li>
                                <li>• GDPR data protection</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h3 class="font-bold text-slate-100 mb-3">Modelling & Evaluation</h3>
                            <ul class="text-sm text-gray-300 space-y-1">
                                <li>• Build on the GPT-4 Turbo API</li>
                                <li>• Develop the action mapping algorithm</li>
                                <li>• Measure performance</li>
                                <li>• Feed user feedback back in</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Pilot Study Implementation -->
                <ProjectSection Title="Pilot Study Implementation" Subtitle="A prototype tested on a simulated rheumatoid arthritis case" Icon="fas fa-vial">
                    <div class="grid lg:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Rheumatoid Arthritis Case Study</h3>
                            <div class="bg-white/[.02] rounded-lg p-4 mb-4">
                                <h4 class="font-bold text-slate-100 mb-2">Simulated Healthcare Journey</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• GP appointment for initial assessment</li>
                                    <li>• Specialist rheumatologist consultation</li>
                                    <li>• Hospital monitoring appointments</li>
                                    <li>• Diagnostic tests and imaging</li>
                                    <li>• Physiotherapy and mental health support</li>
                                </ul>
                            </div>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Data Generation Process</h4>
                                <p class="text-sm text-gray-300">
                                    I used GPT-3.5 to write realistic patient-doctor conversations from detailed medical scenarios,
                                    so the prototype was tested on clinically relevant material.
                                </p>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Technical Implementation</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Pseudonymisation Pipeline</h4>
                                    <p class="text-sm text-gray-300">SpaCy NER plus regular expressions, with GPT helping to spot sensitive data</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Document Processing</h4>
                                    <p class="text-sm text-gray-300">Prompts for GPT-3.5 that produce standardised clinical summaries</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Performance Results</h4>
                                    <p class="text-sm text-gray-300">Each conversation processed in under a second, with data anonymised and output structured</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Downloads Section -->
                <ProjectSection Title="Project Documentation" Subtitle="The proposal, the assignment brief and the project plan" Icon="fas fa-download">
                    <div class="grid md:grid-cols-3 gap-4">
                        <a href="/docs/medical-ai-research-proposal.pdf" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fas fa-file-pdf mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">Research Proposal</div>
                                <div class="text-sm opacity-90">Full EPSRC-style proposal (12 pages)</div>
                            </div>
                        </a>
                        <a href="/docs/data-mining-assignment-brief.pdf" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fas fa-file-pdf mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">Assignment Brief</div>
                                <div class="text-sm opacity-90">COMP2121 requirements (4 pages)</div>
                            </div>
                        </a>
                        <a href="/docs/research-proposal-gantt-chart.pdf" target="_blank"
                           class="px-6 py-4 rounded-lg flex items-center justify-center transition-colors group border border-line bg-white/[.03] hover:border-cy/60 text-slate-100">
                            <i class="fas fa-chart-gantt mr-3 text-xl"></i>
                            <div>
                                <div class="font-bold">Gantt Chart</div>
                                <div class="text-sm opacity-90">Project timeline (1 page)</div>
                            </div>
                        </a>
                    </div>
                </ProjectSection>

                <!-- Academic Excellence Note -->
                <div class="rounded-lg p-8 text-center border border-line bg-white/[.02]">
                    <h3 class="text-2xl font-bold text-white mb-3">Takeaways</h3>
                    <p class="text-slate-300 mb-4">
                        The proposal applies data mining methods and AI to a real NHS problem, with a working prototype behind it.
                        Writing it in the EPSRC format meant planning the research the way a funded project
                        in healthcare would be planned.
                    </p>
                    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
                        <span class="text-cy">✓ CRISP-DM Framework</span>
                        <span class="text-cy">✓ GPT-4 Integration</span>
                        <span class="text-cy">✓ NHS Compliance</span>
                        <span class="text-cy">✓ Original Research Proposal</span>
                    </div>
                </div>

            
</ProjectPage>