@page "/projects/data-mining"
@using website.Data


<ProjectPage Url="/projects/data-mining" Kicker="Academic Project · Year 2">
                <!-- Course Information & Research Framework -->
                <ProjectSection Title="Course Information" Subtitle="COMP2121 - Data Mining, University of Leeds" Icon="fas fa-university">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Course Details</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Module:</strong> COMP2121 - Data Mining</p>
                                <p><strong>Institution:</strong> University of Leeds</p>
                                <p><strong>Year:</strong> 2023/24 (Year 2)</p>
                                <p><strong>Assessment:</strong> Research Proposal Report (70% weight)</p>
                                <p><strong>Format:</strong> EPSRC Research Proposal</p>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Research Framework</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Methodology:</strong> CRISP-DM Framework</p>
                                <p><strong>Focus:</strong> AI-Powered Healthcare Documentation</p>
                                <p><strong>Length:</strong> 12 pages + Gantt Chart + Appendix</p>
                                <p><strong>Scope:</strong> NHS Workflow Integration</p>
                                <p><strong>Innovation:</strong> Patient-Centric EHR System</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Research Hypothesis & Technical Architecture -->
                <ProjectSection Title="Research Hypothesis & Innovation" Subtitle="Novel AI-powered healthcare documentation system" Icon="fas fa-flask">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Primary Hypothesis</h3>
                            <p class="text-gray-300 mb-4">
                                The development and implementation of a patient-centric AI system for enhanced electronic health record integration will significantly reduce documentation times and improve workflow efficiency within the NHS.
                            </p>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Innovation Highlights</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• First healthcare system to implement GPT technology at this capacity</li>
                                    <li>• Addresses critical NHS administrative burden affecting 1.8M workers</li>
                                    <li>• Novel approach to patient-doctor conversation processing</li>
                                    <li>• Comprehensive GDPR-compliant pseudonymisation pipeline</li>
                                </ul>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Technical Architecture</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Data Collection & Processing</h4>
                                    <p class="text-sm text-gray-300">High-quality audio recording, speech-to-text conversion, SpaCy NER pseudonymisation</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">AI Integration</h4>
                                    <p class="text-sm text-gray-300">GPT-4 Turbo API processing, standardised clinical documentation generation</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Workflow Automation</h4>
                                    <p class="text-sm text-gray-300">Action mapping algorithms, NHS Spine system integration, dynamic treatment plans</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

