@page "/about"

<PageTitle>About · Muhammad Kashif-Khan</PageTitle>

@* Facts from the CV and HomeContent; plain words, no em dashes *@
<div class="grid-bg">
    <section class="mx-auto max-w-5xl px-4 pb-8 pt-16 sm:px-6 lg:px-8">
        <p class="mono-label mb-4">// about me</p>
        <h1 class="mb-6 text-4xl font-extrabold tracking-tight text-white sm:text-6xl">Muhammad Kashif-Khan</h1>
        <p class="mb-4 max-w-3xl text-lg leading-relaxed text-slate-300">
            I'm a software engineer. I graduated from the University of Leeds in 2026 with a First-Class MEng in Computer Science with AI.
            Along the way I spent two summers building research software at the university, led my master's group project, and helped run the Leeds AI Society.
            In my own time I'm building two tools for working with AI coding agents, <a href="/projects/synergy" class="text-cy hover:underline">Synergy</a> and <a href="/projects/hireforge" class="text-cy hover:underline">HireForge</a>.
        </p>
        <p class="mb-8 max-w-3xl leading-relaxed text-slate-400">
            I'm looking for a graduate role in software engineering, AI, cloud infrastructure or technical consultancy.
        </p>
        <div class="flex flex-wrap gap-3">
            <a href="/docs/Muhammad-Kashif-Khan-CV.pdf?v=2026-10" target="_blank" class="btn-primary">
                <i class="fas fa-download" aria-hidden="true"></i> Download CV
            </a>
            <a href="/projects" class="btn-ghost">See my work</a>
            <a href="/#contact" class="btn-ghost">Get in touch</a>
        </div>
    </section>
</div>

<section class="mx-auto grid max-w-5xl gap-6 px-4 py-8 sm:px-6 md:grid-cols-5 lg:px-8">
    <div class="surface p-6 md:col-span-3">
        <h2 class="mb-5 flex items-center gap-3 text-xl font-bold text-white">
            <i class="fas fa-code text-cy" aria-hidden="true"></i> What I work with
        </h2>
        <div class="space-y-5">
            @foreach (var (group, skills) in SkillGroups)
            {
                <div>
                    <h3 class="mono-label mb-2">// @group</h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var skill in skills)
                        {
                            <span class="chip">@skill</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="surface p-6 md:col-span-2">
        <h2 class="mb-5 flex items-center gap-3 text-xl font-bold text-white">
            <i class="fas fa-graduation-cap text-cy" aria-hidden="true"></i> Education
        </h2>
        <p class="font-semibold text-cy">University of Leeds</p>
        <p class="mb-1 font-semibold text-white">MEng/BSc Computer Science with Artificial Intelligence</p>
        <p class="mb-4 font-mono text-xs text-slate-400">2022 – 2026</p>
        <p class="mb-6 inline-flex items-center gap-2 rounded-lg border border-cy/30 bg-cy/10 px-3 py-2 text-sm font-semibold text-cy">
            <i class="fas fa-award" aria-hidden="true"></i> First-Class Honours
        </p>

        <h3 class="mono-label mb-3">// along the way</h3>
        <ul class="space-y-3 text-sm leading-relaxed text-slate-300">
            <li>Led my master's group project: <a href="/projects/3d-reconstruction" class="text-cy hover:underline">3D reconstruction from a single video</a>, with a team of five.</li>
            <li>Summer 2025: a <a href="/projects/medical-simulation" class="text-cy hover:underline">stent deployment simulation</a> tool for flow-diverter stents.</li>
            <li>Summer 2024: led the rebuild of <a href="/projects/pnanolocz" class="text-cy hover:underline">pNanoLocz</a>, a MATLAB microscopy tool, in Python.</li>
            <li>Core executive team of the Leeds Artificial Intelligence Society.</li>
        </ul>
    </div>
</section>

@* /ethos redirects here *@
<section id="how-i-work" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-8 sm:px-6 lg:px-8">
    <p class="mono-label mb-4">// how I work</p>
    <div class="grid gap-6 md:grid-cols-2">
        <div class="surface p-6">
            <p class="leading-relaxed text-slate-300">Writing code has got fast; deciding what to build hasn't. I put most of my time into understanding the problem and the design.</p>
            <p class="mt-3 leading-relaxed text-slate-300">I use AI agents every day, and I treat what they write like a colleague's pull request: I read it, test it, and don't ship what I can't explain.</p>
        </div>
        <a href="/ai-integration" class="surface group block p-6 transition hover:border-cy/50">
            <h2 class="mb-2 flex items-center gap-3 text-lg font-bold text-white">
                <i class="fas fa-robot text-cy" aria-hidden="true"></i> AI on this site
            </h2>
            <p class="text-slate-400">The assistant and the MCP server behind it, and how to connect an agent of your own. <span class="text-cy group-hover:underline">Read it →</span></p>
        </a>
    </div>
</section>

@code {
    // from the CV, plus what the projects on this site use
    private static readonly (string Group, string[] Skills)[] SkillGroups =
    {
        ("languages", new[] { "Python", "C#", "C/C++", "TypeScript", "JavaScript", "Java", "SQL", "Bash", "GLSL" }),
        ("ai & vision", new[] { "PyTorch", "OpenCV", "scikit-learn", "JAX", "LLM agents", "MCP", "llama.cpp" }),
        ("web & cloud", new[] { "ASP.NET Core", "Blazor", "FastAPI", "React", "PostgreSQL", "Redis", "Azure Functions", "Cosmos DB" }),
        ("scientific & hpc", new[] { "CUDA", "OpenMP", "MPI", "NumPy", "SciPy", "ParaView", "XLB" }),
        ("graphics & systems", new[] { "OpenGL", "three.js", "ROS2", "SLAM", "PyQt6", "Docker", "Linux", "Git" }),
    };
}
