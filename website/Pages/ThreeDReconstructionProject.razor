<ProjectPage Url="/projects/3d-reconstruction" Kicker="Academic Project · MEng">
            <!-- Project Overview -->
            <ProjectSection Title="Project Overview" Icon="fas fa-cube">
                <p class="text-gray-300 mb-6 leading-relaxed">
                    This MEng group project addresses fundamental challenges in 3D reconstruction by developing a novel hybrid framework
                    that fuses two complementary approaches: feed-forward neural networks for accurate depth estimation and optimization-based
                    models for globally-consistent pose tracking. The project aims to create production-ready pipelines capable of deployment
                    in industrial settings, moving beyond academic prototypes to real-world applications.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Project Context</h3>
                        <ul class="space-y-2 text-gray-300 text-sm">
                            <li>• <strong>Team Size:</strong> 5-person collaborative engineering team</li>
                            <li>• <strong>Supervisor:</strong> Dr. Sharib Ali</li>
                            <li>• <strong>Duration:</strong> Full academic year (2024/2025)</li>
                            <li>• <strong>Current Phase:</strong> Background research & literature review</li>
                        </ul>
                    </div>

                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Development Timeline</h3>
                        <ul class="space-y-2 text-gray-300 text-sm">
                            <li>• <strong>Semester 1:</strong> Framework R&D and validation</li>
                            <li>• <strong>Semester 2:</strong> Pipeline optimization and deployment</li>
                            <li>• <strong>Focus:</strong> Industrial-grade implementation</li>
                            <li>• <strong>Output:</strong> Production-ready 3D capture system</li>
                        </ul>
                    </div>
                </div>
                </ProjectSection>

            <!-- Core Technical Problem -->
            <ProjectSection Title="The Technical Challenge" Icon="fas fa-lightbulb">

                <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                    <h3 class="text-xl font-bold text-slate-100 mb-4">Fundamental Trade-Off in 3D Reconstruction</h3>
                    <p class="text-gray-300 leading-relaxed">
                        Current 3D reconstruction approaches face a critical limitation: methods that excel at depth estimation
                        struggle with pose tracking consistency, while methods that provide robust pose tracking produce ambiguous
                        depth information. This project aims to solve this fundamental trade-off through intelligent fusion.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4"><i class="fas fa-brain mr-2"></i>Feed-Forward Networks (T1)</h3>
                        <div class="space-y-3">
                            <div class="border-l-4 border-line pl-4">
                                <h4 class="font-semibold text-white">Strength: Depth Estimation</h4>
                                <p class="text-gray-300 text-sm">Produce clean, metrically-accurate depth maps with absolute scale from single images</p>
                            </div>
                            <div class="border-l-4 border-line pl-4">
                                <h4 class="font-semibold text-white">Weakness: Pose Drift</h4>
                                <p class="text-gray-300 text-sm">Small pose errors accumulate over video sequences, causing 3D model drift</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4"><i class="fas fa-chart-line mr-2"></i>Optimization Models (T2)</h3>
                        <div class="space-y-3">
                            <div class="border-l-4 border-line pl-4">
                                <h4 class="font-semibold text-white">Strength: Pose Tracking</h4>
                                <p class="text-gray-300 text-sm">Globally-consistent pose estimation that doesn't drift over time</p>
                            </div>
                            <div class="border-l-4 border-line pl-4">
                                <h4 class="font-semibold text-white">Weakness: Depth Ambiguity</h4>
                                <p class="text-gray-300 text-sm">Produces pseudo-depth with relative ordering only, lacking absolute scale</p>
                            </div>
                        </div>
                    </div>
                </div>
                </ProjectSection>

            <!-- Novel Fusion Approach -->
            <ProjectSection Title="Novel Fusion Strategy" Icon="fas fa-code-branch">

                <div class="bg-cyan-900/20 rounded-lg p-6 border border-line mb-6">
                    <h3 class="text-xl font-bold text-slate-100 mb-4">The "Best of Both Worlds" Approach</h3>
                    <p class="text-gray-300 leading-relaxed mb-4">
                        Our hypothesis: By intelligently fusing feed-forward depth estimation with optimization-based pose tracking,
                        we can create a system that leverages the strengths of both approaches while mitigating their individual weaknesses.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-white/[.02] rounded p-4">
                            <p class="text-cy font-semibold mb-2">✓ FF Network fixes optimization depth ambiguity</p>
                            <p class="text-gray-300 text-sm">Use clean, absolute-scale depth maps to resolve pseudo-depth artifacts</p>
                        </div>
                        <div class="bg-white/[.02] rounded p-4">
                            <p class="text-cy font-semibold mb-2">✓ Optimization fixes FF pose drift</p>
                            <p class="text-gray-300 text-sm">Use globally-consistent pose tracking to prevent cumulative errors</p>
                        </div>
                    </div>
                </div>

