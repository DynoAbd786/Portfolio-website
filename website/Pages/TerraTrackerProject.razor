@page "/projects/terratracker"
@using website.Data


<ProjectPage Url="/projects/terratracker" Kicker="Academic Project · Year 2 · COMP2913 · Team Collaboration">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A full-stack app for recording and sharing GPS routes, built by a team of six working in agile sprints. We documented every sprint and ran the project through Git the way a professional team would.
                </p>
                <!-- Project Overview & Context -->
                <ProjectSection Title="Project Overview & Academic Context" Icon="fas fa-project-diagram">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">COMP2913 Software Engineering Project</h3>
                        </div>
                        <p class="text-slate-300 leading-relaxed">
                            TerraTracker lets people record their outdoor activities with GPS, see them on a map and share them. We built it as a team over several agile sprints. The module took us through the whole development lifecycle, from gathering requirements to deployment, with the focus on working well together as a software team.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Team Structure</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• A team of six developers</li>
                                <li>• Each member had their own role</li>
                                <li>• Work planned and delivered in agile sprints</li>
                                <li>• Weekly stand-ups and retrospectives</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Project Deliverables</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• GitHub repository with complete commit history</li>
                                <li>• A detailed project wiki</li>
                                <li>• Live product demonstration</li>
                                <li>• Team and individual reflections</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Core Features & Functionality -->
                <ProjectSection Title="Core Features & Functionality" Icon="fas fa-map-marked-alt">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-route mr-3"></i>Route Tracking
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>GPS recording:</strong> tracks location in real time</div>
                                <div><strong>Activity log:</strong> distance, speed and elevation</div>
                                <div><strong>Maps:</strong> each route shown on an interactive map</div>
                                <div><strong>Export:</strong> GPX and KML files</div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-share-alt mr-3"></i>Social Sharing
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>Sharing:</strong> routes can be public or private</div>
                                <div><strong>Profiles:</strong> each user's activity history and stats</div>
                                <div><strong>Following:</strong> follow other users and find new routes</div>
                                <div><strong>Comments and ratings:</strong> feedback on each route</div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-chart-line mr-3"></i>Analytics
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>Stats:</strong> performance figures for every activity</div>
                                <div><strong>Progress:</strong> personal records and achievements</div>
                                <div><strong>Charts:</strong> graphs of your activity data</div>
                                <div><strong>Goals:</strong> set distance and activity targets</div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Technical Stack & Architecture -->
                <ProjectSection Title="Technical Stack & Architecture" Icon="fas fa-cogs">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Backend Stack</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Flask:</strong> the Python framework behind the API</li>
                                <li><strong>PostgreSQL:</strong> stores all the data</li>
                                <li><strong>SQLAlchemy:</strong> ORM for the database models</li>
                                <li><strong>REST API:</strong> a clean interface for the frontend to call</li>
                                <li><strong>Authentication:</strong> user sessions and account security</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Frontend Stack</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>HTML/CSS/JavaScript:</strong> the core of the frontend</li>
                                <li><strong>Leaflet.js:</strong> the interactive maps</li>
                                <li><strong>Bootstrap:</strong> responsive layout and UI</li>
                                <li><strong>AJAX:</strong> loads data without reloading the page</li>
                                <li><strong>Chart.js:</strong> the stats charts</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">DevOps & Deployment</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <h4 class="font-bold text-white mb-1">Containerization</h4>
                                <p class="text-slate-400 text-sm">Docker, so everyone developed and deployed in the same environment</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-1">Version Control</h4>
                                <p class="text-slate-400 text-sm">Git, with a branch and pull request for each feature</p>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-1">CI/CD Pipeline</h4>
                                <p class="text-slate-400 text-sm">Tests and deployment ran automatically</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

