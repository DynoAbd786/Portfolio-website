                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Data Integrity</h4>
                                    <p class="text-sm text-gray-300">Safe transactions, duplicate detection and consistent state.</p>
                                </div>
                            </div>
                        </div>
                    </div>
