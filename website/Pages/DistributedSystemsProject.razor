@page "/projects/distributed-systems"
@using website.Data


<ProjectPage Url="/projects/distributed-systems" Kicker="Academic Project · Year 3">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A serverless, ERP-style inventory management workflow I built on Microsoft Azure Functions. It puts cloud computing, Function-as-a-Service architecture and distributed system design into practice.
                </p>
                <!-- Course Information & Project Overview -->
                <ProjectSection Title="Course Information & Project Scope" Subtitle="COMP3211 - Distributed Systems, University of Leeds" Icon="fas fa-university">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Course Details</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>Module:</strong> COMP3211 - Distributed Systems</p>
                                <p><strong>Institution:</strong> University of Leeds</p>
                                <p><strong>Year:</strong> 2024/25 (Year 3)</p>
                                <p><strong>Assessment:</strong> Coursework 2 (25% weight)</p>
                                <p><strong>Focus:</strong> Serverless architecture and performance</p>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-3">Learning Outcomes</h3>
                            <div class="space-y-2 text-gray-300">
                                <p><strong>LO1:</strong> Design high-level distributed system frameworks</p>
                                <p><strong>LO2:</strong> Implement distributed designs with middleware tools</p>
                                <p><strong>Platform:</strong> Microsoft Azure Functions</p>
                                <p><strong>Language:</strong> Python runtime</p>
                                <p><strong>Evaluation:</strong> Performance and scalability analysis</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

            <!-- Project Walkthrough Video -->
            <ProjectSection Title="Project Walkthrough" Icon="fas fa-play-circle">

                <div class="relative w-full rounded-lg overflow-hidden border border-line shadow-xl bg-black">
                    <video controls class="w-full h-auto rounded-lg">
                        <source src="videos/ds_cw2.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <div class="mt-4 p-4 bg-white/[.02] rounded-lg border-l-4 border-line">
                    <p class="text-gray-300 text-sm leading-relaxed">
                        <strong class="text-white">System Demo:</strong> A walkthrough of the Azure serverless inventory management system. It shows the HTTP triggers, the Cosmos DB integration and the performance test results.
                    </p>
                </div>
                </ProjectSection>

                <!-- Serverless Architecture & Implementation -->
                <ProjectSection Title="Serverless Architecture & Azure Functions" Subtitle="An event-driven workflow built on Function-as-a-Service (FaaS)" Icon="fas fa-cloud">
                    <div class="grid lg:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Azure Functions Workflow</h3>
                            <div class="space-y-3">
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">HTTP Trigger Functions</h4>
                                    <p class="text-sm text-gray-300">Handle product input, database resets and user authentication.</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Cosmos DB Triggers</h4>
                                    <p class="text-sm text-gray-300">Fire on database changes, so stock levels are monitored automatically and processing is event-driven.</p>
                                </div>
                                <div class="border-l-4 border-line pl-4">
                                    <h4 class="font-bold text-slate-100">Queue Integration</h4>
                                    <p class="text-sm text-gray-300">Messages are processed asynchronously, which keeps the steps of the workflow decoupled.</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-100 mb-4">ERP Inventory Management</h3>
                            <div class="bg-white/[.02] rounded-lg p-4 mb-4">
                                <h4 class="font-bold text-slate-100 mb-2">Core Features</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Inventory tracked and updated in real time</li>
                                    <li>• Automatic stock threshold monitoring</li>
                                    <li>• Product validation and error handling</li>
                                    <li>• Batch processing of multiple products</li>
                                </ul>
                            </div>
                            <div class="bg-white/[.02] rounded-lg p-4">
                                <h4 class="font-bold text-slate-100 mb-2">Business Logic</h4>
                                <ul class="text-sm text-gray-300 space-y-1">
                                    <li>• Logic to stop stock running out</li>
                                    <li>• Duplicate product detection</li>
                                    <li>• Input validation</li>
                                    <li>• Database operations that scale</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

