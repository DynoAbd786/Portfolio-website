@page "/projects/pnanolocz"
@using website.Data


<ProjectPage Url="/projects/pnanolocz" Kicker="Professional Experience">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    The first phase of porting NanoLocz, a MATLAB application for AFM (Atomic Force Microscopy) analysis, to Python.
                </p>
                <!-- Project Overview & Scope -->
                <ProjectSection Title="Project Overview & Scope" Icon="fas fa-microscope">
                    <p class="text-slate-300 text-lg leading-relaxed mb-6">
                        pNanoLocz is the start of a Python version of NanoLocz, a MATLAB application that AFM researchers around the world use to analyse their data. I worked through the existing MATLAB code, designed the structure of the new Python application and built its core components.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Scientific Applications</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-atom text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Nanoscale Research</h4>
                                <p class="text-slate-400 text-sm">Analysing AFM data to characterise nanomaterials</p>
                            </div>
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-chart-line text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Data Visualization</h4>
                                <p class="text-slate-400 text-sm">Loading, processing and viewing AFM data from many file formats</p>
                            </div>
                            <div class="text-center">
                                <div class="bg-cy/10 rounded-full w-12 h-12 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-university text-cy"></i>
                                </div>
                                <h4 class="font-bold text-white mb-2">Research Platform</h4>
                                <p class="text-slate-400 text-sm">Analysis tools that run on any desktop platform</p>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Technical Architecture & Implementation -->
                <ProjectSection Title="Technical Architecture" Icon="fas fa-code">

                    <!-- Core System Components -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-layer-group mr-3"></i>Modular Architecture
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>PyQt6:</strong> the GUI is built on PyQt6</li>
                                <li><strong>Separate modules:</strong> UI, logic and utilities each live in their own package</li>
                                <li><strong>Extensible:</strong> laid out so plugins can be added later</li>
                                <li><strong>Components:</strong> small, reusable pieces that are easy to maintain</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-file-import mr-3"></i>Multi-Format File Reader
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>8+ AFM formats:</strong> one reader interface covers them all</li>
                                <li><strong>New formats:</strong> adding a file type means adding one reader</li>
                                <li><strong>Metadata:</strong> kept intact alongside the image data</li>
                                <li><strong>Error handling:</strong> files are validated as they are parsed</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-database mr-3"></i>Data Management
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Image storage:</strong> AFM image data held efficiently in memory</li>
                                <li><strong>Metadata:</strong> tracked for every loaded file</li>
                                <li><strong>Memory use:</strong> tuned so large datasets can be processed</li>
                                <li><strong>Data checks:</strong> validation and error checking on load</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-desktop mr-3"></i>GUI Foundation
                            </h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Layout:</strong> a responsive window with left and right panels</li>
                                <li><strong>Interface:</strong> built for day-to-day research use</li>
                                <li><strong>Video playback:</strong> AFM frames can be played back as video</li>
                                <li><strong>Cross-platform:</strong> runs on Windows, Linux and macOS</li>
                            </ul>
                        </div>
                    </div>

