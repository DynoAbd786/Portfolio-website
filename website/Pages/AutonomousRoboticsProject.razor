@page "/projects/autonomous-robotics"
@using website.Data

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-cyan-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">Autonomous Robotics</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Academic Project
            </div>
            <h1 class="text-5xl font-bold text-white mb-4">Autonomous Robotics</h1>
            <h2 class="text-2xl text-gray-400 mb-6">Navigation & Object Detection</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                Advanced ROS2-based autonomous robotics project implementing computer vision, motion planning, and intelligent navigation for TurtleBot3 simulation with sophisticated exploration strategies and precision object interaction.
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-cyan-600 text-white px-4 py-2 rounded-full text-sm">ROS2</span>
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">Python</span>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">Computer Vision</span>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">SLAM</span>
                <span class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm">OpenCV</span>
            </div>
        </div>

        <!-- Hero Visual -->
        <div class="bg-gradient-to-r from-cyan-900 to-blue-900 rounded-lg p-12 mb-16 text-center border border-gray-700">
            <div class="text-8xl mb-4">🤖</div>
            <p class="text-white/75 text-lg">ROS2 Navigation • Computer Vision • SLAM • Autonomous Exploration</p>
        </div>

        <div class="max-w-6xl mx-auto">


            <!-- Main Content Sections -->
            <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">
                
                <!-- Project Overview -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                            <i class="fas fa-robot text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-cyan-400">Project Overview</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This comprehensive autonomous robotics project demonstrates the integration of multiple AI and robotics technologies
                        to create an intelligent system capable of exploration, object detection, and precision navigation. Built using ROS2
                        and deployed in Gazebo simulation, the project showcases advanced concepts including SLAM (Simultaneous Localization
                        and Mapping), computer vision, and autonomous decision-making.
                    </p>
                    <div class="bg-gray-800 rounded-lg p-6 border border-cyan-500/25">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-route text-cyan-400 mr-3"></i>Autonomous Navigation
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>ROS2 Integration:</strong> Modern robotics framework with Nav2 stack</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Motion Planning:</strong> Autonomous exploration with waypoint navigation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>SLAM Integration:</strong> Real-time mapping and localization</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-eye text-cyan-400 mr-3"></i>Computer Vision
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Real-time RGB Detection:</strong> OpenCV-based color classification</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>HSV Color Processing:</strong> Robust detection under varying lighting</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Contour Analysis:</strong> Precise object boundary detection</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- Live Simulation Demo -->
            <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300 mb-8">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                        <i class="fas fa-play-circle text-white text-xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-cyan-400">Live Simulation Demo</h2>
                </div>
                
                <div class="relative w-full rounded-lg overflow-hidden border border-gray-700 shadow-xl bg-black">
                    <video controls muted loop class="w-full h-auto rounded-lg">
                        <source src="videos/robot_2x.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                
                <div class="mt-4 p-4 bg-gray-800 rounded-lg border-l-4 border-cyan-500">
                    <p class="text-gray-300 text-sm leading-relaxed">
                        <strong class="text-white">Demonstration (2x Speed):</strong> Autonomous navigation and object detection in action. The TurtleBot3 successfully identifies targets while mapping the environment and avoiding dynamic obstacles.
                    </p>
                </div>
            </div>

                <!-- System Architecture -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-cogs text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-purple-400">System Architecture</h2>
                    </div>
                    
                     <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-purple-600/25">
                            <h4 class="text-xl font-bold text-purple-400 mb-3">Core Nodes</h4>
                             <div class="space-y-4">
                                <div>
                                    <strong class="text-white block mb-1">robot.py</strong>
                                    <p class="text-gray-400 text-sm">Main control node managing state coordination, sensor integration, and high-level behavior orchestration.</p>
                                </div>
                                <div>
                                    <strong class="text-white block mb-1">color_detector.py</strong>
                                    <p class="text-gray-400 text-sm">Computer vision module implementing HSV color space processing and real-time object tracking.</p>
                                </div>
                            </div>
                        </div>
                         <div class="bg-gray-800 rounded-lg p-6 border border-blue-600/25">
                            <h4 class="text-xl font-bold text-blue-400 mb-3">Control Systems</h4>
                             <div class="space-y-4">
                                <div>
                                    <strong class="text-white block mb-1">motion_controller.py</strong>
                                    <p class="text-gray-400 text-sm">Low-level movement control with precise velocity management and smooth trajectory generation.</p>
                                </div>
                                <div>
                                    <strong class="text-white block mb-1">exploration_strategy.py</strong>
                                    <p class="text-gray-400 text-sm">High-level navigation logic implementing waypoint navigation and intelligent state transitions.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Intelligent Exploration Strategy -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-full p-3 mr-4">
                            <i class="fas fa-brain text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-green-400">Intelligent Exploration Strategy</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-500">
                            <h4 class="font-bold text-white mb-2">1. Navigation Phase</h4>
                             <p class="text-sm text-gray-400">Autonomous travel to strategic scanning positions using Nav2 framework</p>
                        </div>
                         <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-500">
                            <h4 class="font-bold text-white mb-2">2. Exploration Phase</h4>
                             <p class="text-sm text-gray-400">Systematic 360-degree environmental scanning with detection</p>
                        </div>
                         <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-500">
                            <h4 class="font-bold text-white mb-2">3. Target Acquisition</h4>
                             <p class="text-sm text-gray-400">Object identification and localization using CV algorithms</p>
                        </div>
                         <div class="bg-gray-800 rounded-lg p-4 border-l-4 border-green-500">
                            <h4 class="font-bold text-white mb-2">4. Precision Approach</h4>
                             <p class="text-sm text-gray-400">Visual servoing approach with sub-meter accuracy</p>
                        </div>
                    </div>
                </div>

                 <!-- Performance & structure -->
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Performance -->
                    <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-yellow-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full p-3 mr-4">
                                <i class="fas fa-chart-line text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-yellow-400">Performance Metrics</h2>
                        </div>
                         <div class="space-y-6">
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Recognition Accuracy</span>
                                    <span class="text-yellow-400">95%+</span>
                                </div>
                                <div class="w-full bg-gray-700 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-yellow-500 to-orange-500 h-2 rounded-full" style="width: 95%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Detection Range</span>
                                    <span class="text-yellow-400">3-4m</span>
                                </div>
                                <div class="w-full bg-gray-700 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-yellow-500 to-orange-500 h-2 rounded-full" style="width: 85%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Positioning Accuracy</span>
                                    <span class="text-yellow-400">±5cm</span>
                                </div>
                                <div class="w-full bg-gray-700 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-yellow-500 to-orange-500 h-2 rounded-full" style="width: 98%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tech Features Sidebar Content -->
                    <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                             <div class="bg-gradient-to-r from-gray-600 to-gray-700 rounded-full p-3 mr-4">
                                <i class="fas fa-folder-tree text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-300">Project Structure</h2>
                        </div>
                         <pre class="bg-gray-800 rounded-lg p-4 text-xs text-gray-400 overflow-x-auto font-mono">
ros2_project/
├── robot.py
├── color_detector.py
├── motion_controller.py
├── exploration_strategy.py
├── test/
├── package.xml
└── setup.py</pre>
                         <div class="mt-6 flex flex-wrap gap-2">
                            <span class="bg-cyan-900/50 text-cyan-200 px-3 py-1 rounded-full text-xs">Publisher/Subscriber</span>
                            <span class="bg-cyan-900/50 text-cyan-200 px-3 py-1 rounded-full text-xs">Sensor Fusion</span>
                            <span class="bg-cyan-900/50 text-cyan-200 px-3 py-1 rounded-full text-xs">State Machine</span>
                             <span class="bg-cyan-900/50 text-cyan-200 px-3 py-1 rounded-full text-xs">Dynamic Obstacle Avoidance</span>
                        </div>
                    </div>
                 </div>

            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="bg-cyan-500 hover:bg-cyan-400 text-gray-900 font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>