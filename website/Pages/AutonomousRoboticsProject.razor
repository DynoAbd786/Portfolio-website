@page "/projects/autonomous-robotics"
@using website.Data

<ProjectPage Url="/projects/autonomous-robotics" Kicker="Academic Project">
                
                <!-- Project Overview -->
                <ProjectSection Title="Project Overview" Icon="fas fa-robot">
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This comprehensive autonomous robotics project demonstrates the integration of multiple AI and robotics technologies
                        to create an intelligent system capable of exploration, object detection, and precision navigation. Built using ROS2
                        and deployed in Gazebo simulation, the project showcases advanced concepts including SLAM (Simultaneous Localization
                        and Mapping), computer vision, and autonomous decision-making.
                    </p>
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-route text-cy mr-3"></i>Autonomous Navigation
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>ROS2 Integration:</strong> Modern robotics framework with Nav2 stack</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Motion Planning:</strong> Autonomous exploration with waypoint navigation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>SLAM Integration:</strong> Real-time mapping and localization</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-eye text-cy mr-3"></i>Computer Vision
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Real-time RGB Detection:</strong> OpenCV-based color classification</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>HSV Color Processing:</strong> Robust detection under varying lighting</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Contour Analysis:</strong> Precise object boundary detection</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

            <!-- Live Simulation Demo -->
            <ProjectSection Title="Live Simulation Demo" Icon="fas fa-play-circle">
                
                <div class="relative w-full rounded-lg overflow-hidden border border-line shadow-xl bg-black">
                    <video controls muted loop class="w-full h-auto rounded-lg">
                        <source src="videos/robot_2x.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                
                <div class="mt-4 p-4 bg-white/[.02] rounded-lg border-l-4 border-line">
                    <p class="text-gray-300 text-sm leading-relaxed">
                        <strong class="text-white">Demonstration (2x Speed):</strong> Autonomous navigation and object detection in action. The TurtleBot3 successfully identifies targets while mapping the environment and avoiding dynamic obstacles.
                    </p>
                </div>
                </ProjectSection>

                <!-- System Architecture -->
                <ProjectSection Title="System Architecture" Icon="fas fa-cogs">
                    
                     <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-xl font-bold text-slate-100 mb-3">Core Nodes</h4>
                             <div class="space-y-4">
                                <div>
                                    <strong class="text-white block mb-1">robot.py</strong>
                                    <p class="text-gray-400 text-sm">Main control node managing state coordination, sensor integration, and high-level behavior orchestration.</p>
                                </div>
                                <div>
                                    <strong class="text-white block mb-1">color_detector.py</strong>
                                    <p class="text-gray-400 text-sm">Computer vision module implementing HSV color space processing and real-time object tracking.</p>
                                </div>
                            </div>
                        </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-xl font-bold text-slate-100 mb-3">Control Systems</h4>
                             <div class="space-y-4">
                                <div>
                                    <strong class="text-white block mb-1">motion_controller.py</strong>
                                    <p class="text-gray-400 text-sm">Low-level movement control with precise velocity management and smooth trajectory generation.</p>
                                </div>
                                <div>
                                    <strong class="text-white block mb-1">exploration_strategy.py</strong>
                                    <p class="text-gray-400 text-sm">High-level navigation logic implementing waypoint navigation and intelligent state transitions.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Intelligent Exploration Strategy -->
                <ProjectSection Title="Intelligent Exploration Strategy" Icon="fas fa-brain">
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-white/[.02] rounded-lg p-4 border-l-4 border-line">
                            <h4 class="font-bold text-white mb-2">1. Navigation Phase</h4>
                             <p class="text-sm text-gray-400">Autonomous travel to strategic scanning positions using Nav2 framework</p>
                        </div>
                         <div class="bg-white/[.02] rounded-lg p-4 border-l-4 border-line">
                            <h4 class="font-bold text-white mb-2">2. Exploration Phase</h4>
                             <p class="text-sm text-gray-400">Systematic 360-degree environmental scanning with detection</p>
                        </div>
                         <div class="bg-white/[.02] rounded-lg p-4 border-l-4 border-line">
                            <h4 class="font-bold text-white mb-2">3. Target Acquisition</h4>
                             <p class="text-sm text-gray-400">Object identification and localization using CV algorithms</p>
                        </div>
                         <div class="bg-white/[.02] rounded-lg p-4 border-l-4 border-line">
                            <h4 class="font-bold text-white mb-2">4. Precision Approach</h4>
                             <p class="text-sm text-gray-400">Visual servoing approach with sub-meter accuracy</p>
                        </div>
                    </div>
                </ProjectSection>

                 <!-- Performance & structure -->
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Performance -->
                    <ProjectSection Title="Performance Metrics" Icon="fas fa-chart-line">
                         <div class="space-y-6">
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Recognition Accuracy</span>
                                    <span class="text-cy">95%+</span>
                                </div>
                                <div class="w-full bg-white/[.02] rounded-full h-2">
                                    <div class="h-2 rounded-full bg-white/[.02]" style="width: 95%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Detection Range</span>
                                    <span class="text-cy">3-4m</span>
                                </div>
                                <div class="w-full bg-white/[.02] rounded-full h-2">
                                    <div class="h-2 rounded-full bg-white/[.02]" style="width: 85%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-gray-400">Positioning Accuracy</span>
                                    <span class="text-cy">±5cm</span>
                                </div>
                                <div class="w-full bg-white/[.02] rounded-full h-2">
                                    <div class="h-2 rounded-full bg-white/[.02]" style="width: 98%"></div>
                                </div>
                            </div>
                        </div>
                </ProjectSection>

                    <!-- Tech Features Sidebar Content -->
                    <ProjectSection Title="Project Structure" Icon="fas fa-folder-tree">
                         <pre class="bg-white/[.02] rounded-lg p-4 text-xs text-gray-400 overflow-x-auto font-mono">
ros2_project/
├── robot.py
├── color_detector.py
├── motion_controller.py
├── exploration_strategy.py
├── test/
├── package.xml
└── setup.py</pre>
                         <div class="mt-6 flex flex-wrap gap-2">
                            <span class="bg-cyan-900/50 text-slate-300 px-3 py-1 rounded-full text-xs">Publisher/Subscriber</span>
                            <span class="bg-cyan-900/50 text-slate-300 px-3 py-1 rounded-full text-xs">Sensor Fusion</span>
                            <span class="bg-cyan-900/50 text-slate-300 px-3 py-1 rounded-full text-xs">State Machine</span>
                             <span class="bg-cyan-900/50 text-slate-300 px-3 py-1 rounded-full text-xs">Dynamic Obstacle Avoidance</span>
                        </div>
                </ProjectSection>
                 </div>

            
</ProjectPage>