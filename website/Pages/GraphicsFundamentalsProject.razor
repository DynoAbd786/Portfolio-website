                        <p class="text-gray-400">Complete implementation with documentation and examples</p>
                    </div>
                </div>
                <a href="https://github.com/DynoAbd786/graphics-cw1" target="_blank"
                   class="bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-lg flex items-center transition-colors">
                    <i class="fab fa-github mr-2"></i>
