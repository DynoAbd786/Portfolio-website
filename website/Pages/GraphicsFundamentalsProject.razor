        <!-- GitHub Repository -->
        <div class="bg-gradient-to-r from-gray-800 to-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300 mb-8">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="bg-gray-700 rounded-full p-3 mr-4">
                        <i class="fab fa-github text-white text-xl"></i>
                    </div>
                    <div>
