@page "/projects/graphics-fundamentals"
@using website.Data

<section class="py-20">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-8">
            <div class="flex items-center space-x-2 text-gray-400">
                <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
                <span>/</span>
                <a href="/projects" class="hover:text-cyan-400 transition-colors">Projects</a>
                <span>/</span>
                <span class="text-white">2D Graphics Fundamentals</span>
            </div>
        </nav>

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-block bg-gradient-to-r from-purple-500 to-indigo-500 text-white px-4 py-2 rounded-full text-sm font-semibold mb-6">
                Academic Project
            </div>
            <h1 class="text-5xl font-bold text-white mb-4">2D Graphics Fundamentals</h1>
            <h2 class="text-2xl text-gray-400 mb-6">Rasterization & Geometric Algorithms</h2>
            <p class="text-xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
                Computer Graphics Coursework 1 - Implementing fundamental 2D graphics algorithms including line drawing, triangle rasterization, and image processing with comprehensive performance analysis and testing frameworks.
            </p>
            <div class="flex flex-wrap justify-center gap-3 mt-8">
                <span class="bg-blue-600 text-white px-4 py-2 rounded-full text-sm">C++</span>
                <span class="bg-green-600 text-white px-4 py-2 rounded-full text-sm">OpenGL</span>
                <span class="bg-purple-600 text-white px-4 py-2 rounded-full text-sm">Rasterization</span>
                <span class="bg-yellow-600 text-white px-4 py-2 rounded-full text-sm">Google Benchmark</span>
                <span class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm">Catch2</span>
            </div>
        </div>

        <!-- Hero Visual -->
        <div class="bg-gradient-to-r from-purple-900 to-indigo-900 rounded-lg p-12 mb-16 text-center border border-gray-700">
            <div class="text-8xl mb-4">🎨</div>
            <p class="text-white/75 text-lg">Bresenham's Algorithms • Rasterization • 2D Primitives • C++ Optimization</p>
        </div>

        <div class="max-w-6xl mx-auto">
            <!-- Main Content Sections -->
            <div class="grid grid-cols-1 gap-8">
                
                <!-- Project Overview -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full p-3 mr-4">
                            <i class="fas fa-palette text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-cyan-400">Project Overview</h2>
                    </div>
                    <p class="text-gray-300 text-lg leading-relaxed mb-6">
                        This comprehensive computer graphics coursework focused on implementing fundamental 2D graphics operations including
                        pixel manipulation, line drawing algorithms, triangle rasterization, and image blitting. The project required
                        building graphics primitives from scratch in C++, implementing mathematical algorithms for geometric rendering,
                        and developing comprehensive testing and benchmarking frameworks.
                    </p>
                    <div class="bg-gray-800 rounded-lg p-6 border border-cyan-500/25">
                         <div class="grid md:grid-cols-2 gap-8">
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-vector-square text-cyan-400 mr-3"></i>Core Algorithms
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Line Drawing:</strong> Bresenham's algorithm and DDA implementation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Triangle Rasterization:</strong> Barycentric coordinate interpolation</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Pixel Manipulation:</strong> Surface class with RGBA handling</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>2D Transformations:</strong> Rotation matrices and coordinate systems</span>
                                    </li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                                    <i class="fas fa-chart-line text-cyan-400 mr-3"></i>Testing & Perf
                                </h3>
                                <ul class="space-y-3 text-gray-300">
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Benchmarking:</strong> Google Benchmark integration</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Testing Framework:</strong> Catch2 automated testing</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Memory Optimization:</strong> Zero dynamic allocation constraints</span>
                                    </li>
                                    <li class="flex items-start">
                                        <i class="fas fa-check text-cyan-500 mt-1 mr-3"></i>
                                        <span><strong>Edge Case Handling:</strong> Comprehensive clipping tests</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Implementation Highlights -->
                <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-purple-500/50 transition-all duration-300">
                    <div class="flex items-center mb-6">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full p-3 mr-4">
                            <i class="fas fa-code text-white text-xl"></i>
                        </div>
                        <h2 class="text-3xl font-bold text-purple-400">Implementation Highlights</h2>
                    </div>
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="bg-gray-800 rounded-lg p-6 border border-purple-600/25">
                            <h4 class="text-xl font-bold text-purple-400 mb-3">Line Drawing</h4>
                            <p class="text-gray-300 text-sm">
                                Implemented both Bresenham's and DDA algorithms with comprehensive performance
                                comparison. Ensured pixel-perfect rendering with proper clipping and no gaps.
                            </p>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-green-600/25">
                            <h4 class="text-xl font-bold text-green-400 mb-3">Rasterization</h4>
                            <p class="text-gray-300 text-sm">
                                Built triangle rendering with barycentric coordinate interpolation for smooth
                                color gradients. Handled edge cases and optimized for different sizes.
                            </p>
                        </div>
                        <div class="bg-gray-800 rounded-lg p-6 border border-yellow-600/25">
                            <h4 class="text-xl font-bold text-yellow-400 mb-3">Optimization</h4>
                            <p class="text-gray-300 text-sm">
                                Achieved O(N) complexity for all algorithms, avoided dynamic allocations,
                                and implemented comprehensive benchmarking to validate performance.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Key Features & Specs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Key technical features -->
                     <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-indigo-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full p-3 mr-4">
                                <i class="fas fa-star text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-indigo-400">Key Features</h2>
                        </div>
                        <ul class="space-y-3">
                            <li class="flex items-start">
                                <i class="fas fa-check text-indigo-500 mt-1 mr-3 flex-shrink-0"></i>
                                <span class="text-gray-300">Pixel-level RGBx surface manipulation</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check text-indigo-500 mt-1 mr-3 flex-shrink-0"></i>
                                <span class="text-gray-300">Anti-aliased line rendering</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check text-indigo-500 mt-1 mr-3 flex-shrink-0"></i>
                                <span class="text-gray-300">Color interpolation rasterization</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check text-indigo-500 mt-1 mr-3 flex-shrink-0"></i>
                                <span class="text-gray-300">Alpha-masked image blitting</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check text-indigo-500 mt-1 mr-3 flex-shrink-0"></i>
                                <span class="text-gray-300">Viewport clipping & boundaries</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Technical Specs -->
                     <div class="bg-gray-900 rounded-lg p-8 border border-gray-700 hover:border-pink-500/50 transition-all duration-300">
                        <div class="flex items-center mb-6">
                            <div class="bg-gradient-to-r from-pink-500 to-pink-600 rounded-full p-3 mr-4">
                                <i class="fas fa-cogs text-white text-xl"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-pink-400">Technical Specs</h2>
                        </div>
                         <div class="space-y-6">
                            <div>
                                <h4 class="font-semibold text-pink-400 text-sm mb-2">Development Stack</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• C++ (Modern C++17)</li>
                                    <li>• Premake5 build system</li>
                                    <li>• GLFW & OpenGL</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-semibold text-pink-400 text-sm mb-2">Testing</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• Catch2 framework</li>
                                    <li>• Google Benchmark</li>
                                    <li>• Regression testing</li>
                                </ul>
                            </div>
                             <div>
                                <h4 class="font-semibold text-pink-400 text-sm mb-2">Targets</h4>
                                <ul class="space-y-1 text-sm text-gray-300 pl-3 border-l border-gray-700">
                                    <li>• O(N) complexity</li>
                                    <li>• Zero dynamic allocations</li>
                                    <li>• Real-time rendering</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GitHub Repository -->
                <div class="bg-gradient-to-r from-gray-800 to-gray-900 rounded-2xl p-8 border border-gray-700/50 hover:border-cyan-500/30 transition-all text-center md:text-left">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center">
                            <div class="bg-gray-700/50 rounded-full p-4 mr-4 hidden md:block">
                                <i class="fab fa-github text-white text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-1">Source Code Repository</h3>
                                <p class="text-gray-400">Complete implementation with documentation</p>
                            </div>
                        </div>
                        <a href="https://github.com/DynoAbd786/graphics-cw1" target="_blank"
                           class="inline-flex items-center px-6 py-3 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-medium transition-colors shadow-lg shadow-cyan-900/20">
                            <i class="fab fa-github mr-2"></i>View on GitHub
                        </a>
                    </div>
                </div>

            </div>
        </div>

        <!-- Back Button -->
        <div class="text-center mt-16">
            <a href="/projects" class="bg-cyan-500 hover:bg-cyan-400 text-gray-900 font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105">
                <i class="fas fa-arrow-left mr-2"></i>Back to Projects
            </a>
        </div>
    </div>
</section>