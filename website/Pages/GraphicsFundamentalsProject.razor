        <!-- Learning Outcomes -->
        <div class="bg-gradient-to-r from-blue-900 to-purple-900 rounded-lg p-8 text-center border border-gray-700">
            <h3 class="text-2xl font-bold text-white mb-3">Academic Excellence in Computer Graphics</h3>
            <p class="text-blue-200 mb-4">
                This foundational graphics coursework demonstrates comprehensive understanding of 2D rendering algorithms,
                mathematical precision in algorithmic implementation, and professional software engineering practices.
                The combination of low-level optimization, comprehensive testing, and performance analysis showcases
                the theoretical depth and practical expertise essential for computer graphics and game development careers.
            </p>
            <div class="flex justify-center space-x-6 text-sm">
                <span class="text-green-400">✓ Mathematical Algorithms</span>
                <span class="text-blue-400">✓ Performance Optimization</span>
                <span class="text-purple-400">✓ Comprehensive Testing</span>
                <span class="text-yellow-400">✓ Low-Level Programming</span>
            </div>
        </div>
    </div>
</div>