@page "/vascular-blood-flow"
@using website.Data

<ProjectPage Url="/vascular-blood-flow" Kicker="Academic Dissertation">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    For my dissertation I built a Lattice Boltzmann Method (LBM) framework that simulates pulsing blood flow through arteries. The aim was to move research-style simulation closer to something clinicians could use to assess aneurysm risk.
                </p>
                
                <!-- Project Overview -->
                <ProjectSection Title="Project Overview" Icon="fas fa-microscope">
                    
                     <!-- Context Alert -->
                    <div class="bg-white/[.02] border border-line rounded-lg p-6 mb-8">
                        <div class="flex items-start">
                            <i class="fas fa-info-circle text-cy text-xl mr-4 mt-1"></i>
                            <div>
                                <h4 class="text-slate-100 font-bold mb-2">Project Context</h4>
                                <p class="text-yellow-200/90 text-sm leading-relaxed">
                                    I completed this dissertation during a long-term illness. I still met the core technical objectives, and the results suggest GPU-accelerated LBM is a workable approach to clinical blood flow simulation.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-lg font-semibold text-slate-100 mb-3">Clinical Challenge</h4>
                            <p class="text-gray-300 mb-4 text-sm leading-relaxed">
                                Aneurysm risk is currently assessed with finite element methods (FEM), which are too slow to support decisions in real time. Aneurysms rupture at a rate of 1.4% a year, so faster tools matter.
                            </p>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-lg font-semibold text-slate-100 mb-3">Technical Approach</h4>
                            <p class="text-gray-300 mb-4 text-sm leading-relaxed">
                                I extended XLB with custom boundary conditions, non-Newtonian fluid modeling and wall shear stress calculation. The result runs on the GPU at over 2,340 MLUPS.
                            </p>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Technical Architecture -->
                <ProjectSection Title="Technical Architecture" Icon="fas fa-layer-group">
                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="bg-white/[.02] rounded-xl p-6 border border-line">
                            <h3 class="text-lg font-bold text-white mb-4 flex items-center">
                                <i class="fas fa-calculator text-cy mr-2"></i>LBM Core
                            </h3>
                            <ul class="space-y-2 text-sm text-gray-400">
                                <li>• Simulates fluid at the mesoscopic scale</li>
                                <li>• D2Q9 velocity model</li>
                                <li>• Runs in parallel on the GPU</li>
                                <li>• Scales better than traditional CFD</li>
                            </ul>
                        </div>
                         <div class="bg-white/[.02] rounded-xl p-6 border border-line">
                            <h3 class="text-lg font-bold text-white mb-4 flex items-center">
                                <i class="fas fa-tint text-cy mr-2"></i>Physiological Model
                            </h3>
                            <ul class="space-y-2 text-sm text-gray-400">
                                <li>• Non-Newtonian Carreau-Yasuda rheology</li>
                                <li>• Pulsatile flow that changes over time</li>
                                <li>• Inflow follows a realistic cardiac cycle</li>
                                <li>• Calculates wall shear stress</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Implementation Details -->
                <ProjectSection Title="Implementation Highlights" Icon="fas fa-code">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-lg font-semibold text-slate-100 mb-2">Custom Boundary Conditions</h4>
                            <ul class="space-y-2 text-sm text-gray-300">
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Zou-He inlet that varies over time, interpolated from 64 points across the cardiac cycle</li>
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Fullway bounce-back at the walls, for stability</li>
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Extrapolation at the outlet to stop artificial reflections</li>
                            </ul>
                        </div>
                         <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h4 class="text-lg font-semibold text-slate-100 mb-2">Non-Newtonian Physics</h4>
                            <ul class="space-y-2 text-sm text-gray-300">
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Carreau-Yasuda viscosity model</li>
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Relaxation time calculated per cell, so it varies across the domain</li>
                                <li class="flex items-start"><i class="fas fa-check text-cy mt-1 mr-2"></i>Models shear-thinning near the vessel walls</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Results & Future -->
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                     <!-- Key Results -->
                    <ProjectSection Title="Key Results" Icon="fas fa-chart-line">
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-white/[.02] p-4 rounded-xl text-center border border-line">
                                <div class="text-2xl font-bold text-white">2,340+</div>
                                <div class="text-xs text-cy uppercase tracking-wide mt-1">MLUPS</div>
                            </div>
                            <div class="bg-white/[.02] p-4 rounded-xl text-center border border-line">
                                <div class="text-2xl font-bold text-white">~1 Pa</div>
                                <div class="text-xs text-cy uppercase tracking-wide mt-1">WSS</div>
                            </div>
                            <div class="bg-white/[.02] p-4 rounded-xl text-center border border-line">
                                <div class="text-2xl font-bold text-white">92s</div>
                                <div class="text-xs text-cy uppercase tracking-wide mt-1">Runtime</div>
                            </div>
                            <div class="bg-white/[.02] p-4 rounded-xl text-center border border-line">
                                <div class="text-xl font-bold text-white">2D→3D</div>
                                <div class="text-xs text-cy uppercase tracking-wide mt-1">Scalable</div>
                            </div>
                        </div>
                </ProjectSection>

                    <!-- Future Directions -->
                    <ProjectSection Title="Clinical Pathway" Icon="fas fa-rocket">
                        <ul class="space-y-4">
                            <li class="flex items-start text-sm">
                                <i class="fas fa-arrow-right text-cy mt-1 mr-3"></i>
                                <span class="text-gray-300">Move to anatomically accurate 3D models built from STL files</span>
                            </li>
                             <li class="flex items-start text-sm">
                                <i class="fas fa-arrow-right text-cy mt-1 mr-3"></i>
                                <span class="text-gray-300">Feed the results into ML models that predict rupture risk</span>
                            </li>
                             <li class="flex items-start text-sm">
                                <i class="fas fa-arrow-right text-cy mt-1 mr-3"></i>
                                <span class="text-gray-300">Fit the tool into the workflow of NHS radiologists</span>
                            </li>
                        </ul>
                </ProjectSection>
                </div>

                <!-- Links -->
                <div class="rounded-2xl p-8 border border-gray-700/50 hover:border-cy/50 transition-all text-center md:text-left bg-white/[.02]">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="flex items-center">
                            <div class="bg-white/[.02] rounded-full p-4 mr-4 hidden md:block">
                                <i class="fas fa-link text-white text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-1">Project Resources</h3>
                                <p class="text-gray-400">The source code and the full technical report</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                             <a href="https://github.com/DynoAbd786/dissertation-xlb-blood-flow-simulation" target="_blank" class="inline-flex items-center px-6 py-3 rounded-lg bg-white/[.02] hover:bg-gray-600 text-white font-medium transition-colors border border-line">
                                <i class="fab fa-github mr-2"></i>GitHub
                            </a>
                            <a href="/docs/dissertation-report.pdf" target="_blank" class="inline-flex items-center px-6 py-3 rounded-lg bg-cy/10 hover:bg-red-500 text-white font-medium transition-colors shadow-lg shadow-red-900/20">
                                <i class="fas fa-file-pdf mr-2"></i>PDF Report
                            </a>
                        </div>
                    </div>
                </div>

            
</ProjectPage>