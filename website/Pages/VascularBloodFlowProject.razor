            </div>

            <div class="flex flex-wrap justify-center gap-4">
                <span class="bg-gradient-to-r from-blue-500 to-blue-600 text-white px-4 py-2 rounded-full font-semibold">Python</span>
                <span class="bg-gradient-to-r from-orange-500 to-orange-600 text-white px-4 py-2 rounded-full font-semibold">XLB Framework</span>
                <span class="bg-gradient-to-r from-green-500 to-green-600 text-white px-4 py-2 rounded-full font-semibold">NVIDIA Warp</span>
                <span class="bg-gradient-to-r from-red-500 to-red-600 text-white px-4 py-2 rounded-full font-semibold">CUDA</span>
