@page "/vascular-blood-flow"
@using website.Data

<PageTitle>Vascular Blood Flow Simulation - XLB Project</PageTitle>

<div class="min-h-screen bg-gray-900 text-gray-200">
    <div class="container mx-auto px-4 py-12">

        <!-- Header Section -->
        <div class="text-center mb-16">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-red-500 to-pink-600 rounded-full mb-6">
                <i class="fas fa-heart-pulse text-3xl text-white"></i>
            </div>
            <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-red-400 to-pink-500 bg-clip-text text-transparent">
                Vascular Blood Flow Simulation
            </h1>
            <h2 class="text-2xl text-gray-300 mb-6">GPU-Accelerated CFD for Aneurysm Risk Assessment</h2>
            <p class="text-xl text-gray-400 max-w-4xl mx-auto leading-relaxed">
                A comprehensive Lattice Boltzmann Method (LBM) framework for simulating pulsatile blood flow in arterial geometries,
                designed to bridge the gap between research simulations and clinical aneurysm risk assessment.
            </p>
        </div>

        <!-- Project Overview -->
        <section class="mb-16">
            <div class="bg-gray-800 rounded-lg p-8 border border-gray-700">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-full p-3 mr-4">
                        <i class="fas fa-microscope text-white text-xl"></i>
                    </div>
                    <h3 class="text-3xl font-bold text-white">Project Overview</h3>
                </div>

                <!-- Project Context Note -->
                <div class="bg-gradient-to-r from-yellow-900/30 to-orange-900/30 border border-yellow-600/50 rounded-lg p-4 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-yellow-400 text-lg mr-3 mt-1"></i>
                        <div>
                            <p class="text-yellow-200 text-sm leading-relaxed">
                                <strong>Project Note:</strong> This dissertation was completed under challenging personal circumstances including
                                long-term illness, which impacted the project timeline and scope. Despite these challenges, the core technical
                                objectives were successfully achieved, demonstrating the viability of GPU-accelerated LBM for clinical blood flow simulation.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <h4 class="text-xl font-semibold text-cyan-400 mb-3">Clinical Challenge</h4>
                        <p class="text-gray-300 mb-4">
                            Current aneurysm risk assessment relies on computationally expensive finite element methods (FEM)
                            that limit real-time clinical decision-making. With 3.2% of adults having unruptured intracranial
                            aneurysms and a 1.4% annual rupture rate, faster simulation tools are critically needed.
                        </p>
                    </div>

                    <div>
                        <h4 class="text-xl font-semibold text-cyan-400 mb-3">Technical Innovation</h4>
                        <p class="text-gray-300 mb-4">
                            This project extends the XLB framework with custom boundary conditions, non-Newtonian fluid modeling,
                            and wall shear stress computation to create a GPU-accelerated simulation environment achieving
                            2,340+ MLUPS performance.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technical Architecture -->
        <section class="mb-16">
            <div class="text-center mb-8">
                <h3 class="text-3xl font-bold text-white mb-4">Technical Architecture</h3>
                <p class="text-gray-400">Built on cutting-edge computational fluid dynamics principles</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Lattice Boltzmann Method -->
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-cyan-500/50 transition-all duration-300">
                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-full w-16 h-16 flex items-center justify-center mb-4">
                        <i class="fas fa-calculator text-white text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-white mb-3">Lattice Boltzmann Method</h4>
                    <ul class="text-gray-300 space-y-2">
                        <li>• Mesoscopic fluid simulation approach</li>
                        <li>• D2Q9 velocity model implementation</li>
                        <li>• GPU-optimized parallel computation</li>
                        <li>• Superior scalability vs traditional CFD</li>
                    </ul>
                </div>

                <!-- Blood Flow Modeling -->
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-red-500/50 transition-all duration-300">
                    <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-full w-16 h-16 flex items-center justify-center mb-4">
                        <i class="fas fa-tint text-white text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-white mb-3">Physiological Modeling</h4>
                    <ul class="text-gray-300 space-y-2">
                        <li>• Non-Newtonian Carreau-Yasuda rheology</li>
                        <li>• Time-dependent pulsatile flow</li>
                        <li>• Realistic cardiac cycle profiles</li>
                        <li>• Wall shear stress computation</li>
                    </ul>
                </div>

                <!-- Performance & Visualization -->
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-green-500/50 transition-all duration-300">
                    <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-full w-16 h-16 flex items-center justify-center mb-4">
                        <i class="fas fa-chart-line text-white text-xl"></i>
                    </div>
                    <h4 class="text-xl font-bold text-white mb-3">Performance & Analysis</h4>
                    <ul class="text-gray-300 space-y-2">
                        <li>• 2,340+ MLUPS on RTX 3060 Mobile</li>
                        <li>• ParaView integration for visualization</li>
                        <li>• Docker containerization</li>
                        <li>• Jupyter notebook analysis tools</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Key Results -->
        <section class="mb-16">
            <div class="bg-gradient-to-r from-gray-800 to-gray-900 rounded-lg p-8 border border-gray-700">
                <div class="text-center mb-8">
                    <h3 class="text-3xl font-bold text-white mb-4">Key Results & Validation</h3>
                    <p class="text-gray-400">Demonstrating clinical-grade accuracy with research-level performance</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="text-center">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg p-6 mb-4">
                            <div class="text-3xl font-bold text-white">2,340+</div>
                            <div class="text-blue-200">MLUPS</div>
                        </div>
                        <p class="text-gray-400">Peak Performance</p>
                    </div>

                    <div class="text-center">
                        <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-lg p-6 mb-4">
                            <div class="text-3xl font-bold text-white">~1 Pa</div>
                            <div class="text-red-200">WSS</div>
                        </div>
                        <p class="text-gray-400">Physiological Range</p>
                    </div>

                    <div class="text-center">
                        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-lg p-6 mb-4">
                            <div class="text-3xl font-bold text-white">92s</div>
                            <div class="text-green-200">Runtime</div>
                        </div>
                        <p class="text-gray-400">Complete Simulation</p>
                    </div>

                    <div class="text-center">
                        <div class="bg-gradient-to-r from-purple-500 to-purple-600 rounded-lg p-6 mb-4">
                            <div class="text-3xl font-bold text-white">2D→3D</div>
                            <div class="text-purple-200">Scalable</div>
                        </div>
                        <p class="text-gray-400">Architecture</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Implementation Details -->
        <section class="mb-16">
            <div class="text-center mb-8">
                <h3 class="text-3xl font-bold text-white mb-4">Implementation Highlights</h3>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
                    <h4 class="text-xl font-semibold text-cyan-400 mb-4">Custom Boundary Conditions</h4>
                    <ul class="text-gray-300 space-y-3">
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Time-dependent Zou-He inlet BC with 64-point cardiac cycle interpolation</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Fullway bounce-back wall conditions for stability</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Extrapolation outflow BC to prevent artificial reflections</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
                    <h4 class="text-xl font-semibold text-cyan-400 mb-4">Non-Newtonian Physics</h4>
                    <ul class="text-gray-300 space-y-3">
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Carreau-Yasuda viscosity model implementation</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Spatially varying relaxation time computation</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fas fa-check-circle text-green-400 mr-3 mt-1"></i>
                            <span>Shear-thinning behavior near vessel walls</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Future Directions -->
        <section class="mb-16">
            <div class="bg-gray-800 rounded-lg p-8 border border-gray-700">
                <div class="flex items-center mb-6">
                    <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full p-3 mr-4">
                        <i class="fas fa-rocket text-white text-xl"></i>
                    </div>
                    <h3 class="text-3xl font-bold text-white">Clinical Translation Pathway</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-6">
                    <div class="border-l-4 border-blue-500 pl-6">
                        <h4 class="text-lg font-semibold text-blue-400 mb-2">3D Extension</h4>
                        <p class="text-gray-300">
                            Transition to 3D anatomically accurate models using STL mesh domains from medical imaging data.
                        </p>
                    </div>

                    <div class="border-l-4 border-green-500 pl-6">
                        <h4 class="text-lg font-semibold text-green-400 mb-2">ML Integration</h4>
                        <p class="text-gray-300">
                            Incorporate machine learning pipelines for rupture risk prediction using haemodynamic features.
                        </p>
                    </div>

                    <div class="border-l-4 border-purple-500 pl-6">
                        <h4 class="text-lg font-semibold text-purple-400 mb-2">Clinical Deployment</h4>
                        <p class="text-gray-300">
                            NHS integration with radiologist workflows for patient-specific aneurysm assessment.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technical Stack -->
        <section class="mb-16">
            <div class="text-center mb-8">
