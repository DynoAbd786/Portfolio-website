                                <span class="text-blue-400">async def</span> <span class="text-green-400">process_data</span>(data):<br/>
                                    <span class="text-blue-400">return</span> {<span class="text-yellow-400">"processed"</span>: <span class="text-cyan-400">len</span>(data)}
                            </div>
