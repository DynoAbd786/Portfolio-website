                    <!-- Code Examples -->
                    <div class="mt-6">
                        <h3 class="text-xl font-bold text-white mb-4">Usage Patterns</h3>
                        <div class="bg-white/[.02] rounded-lg p-4 font-mono text-sm">
                            <div class="text-cy mb-2"># Task Definition</div>
                            <div class="text-gray-300 mb-4">
                                <span class="text-cy">@@task</span>(name=<span class="text-cy">"data_processor"</span>, queue=<span class="text-cy">"data_processing"</span>, timeout=<span class="text-cy">300</span>)<br/>
                                <span class="text-cy">async def</span> <span class="text-cy">process_data</span>(data):<br/>
                                    <span class="text-cy">return</span> {<span class="text-cy">"processed"</span>: <span class="text-cy">len</span>(data)}
                            </div>
                            <div class="text-cy mb-2"># CLI Administration</div>
                            <div class="text-gray-300">
                                python main.py worker start --queues default,high --concurrency 4<br/>
                                python main.py task submit my_task --args '[1,2,3]' --queue high_priority
                            </div>
                        </div>
                    </div>
                </ProjectSection>

