@page "/projects/business-plan"
@using website.Data


<ProjectPage Url="/projects/business-plan" Kicker="Academic Project · Year 2">
                <p class="max-w-3xl text-lg leading-relaxed text-slate-400">
                    A business plan for an AI tool that writes up NHS clinical documentation, so doctors spend less time on paperwork. The plan targets 1.8 million UK healthcare professionals and builds on £2 billion of government digitalization funding.
                </p>
                <!-- Business Context & Problem Analysis -->
                <ProjectSection Title="NHS Crisis & Market Opportunity" Icon="fas fa-hospital">
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-cy rounded-full w-2 h-2 mr-3"></div>
                            <h3 class="text-xl font-bold text-slate-100">Critical Healthcare Challenge</h3>
                        </div>
                        <p class="text-slate-300 leading-relaxed">
                            COVID-19 put the NHS under heavy strain and showed how much doctor time goes on non-clinical admin.
                            Paperwork and record-keeping take hours that should go to patients. That workload feeds into burnout
                            and strikes, and patient care suffers.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Market Scale</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• <strong>1.8 million</strong> healthcare professionals in the UK</li>
                                <li>• <strong>200+</strong> health service providers across the country</li>
                                <li>• <strong>1.6 billion</strong> patient data transactions a month</li>
                                <li>• <strong>£2 billion</strong> of government investment in digitalization</li>
                            </ul>
                        </div>
                        <div class="bg-white/[.02] rounded-lg p-4">
                            <h4 class="font-bold text-white mb-2">Current Problems</h4>
                            <ul class="text-slate-400 text-sm space-y-1">
                                <li>• Too much time spent on documentation</li>
                                <li>• Records still kept on pen and paper</li>
                                <li>• Junior doctor strikes over workload</li>
                                <li>• Less time with patients, and lower quality care</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Business Solution & Value Proposition -->
                <ProjectSection Title="Project Synapse Solution" Icon="fas fa-lightbulb">

                    <!-- Core Solution -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line mb-8">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">"Advanced AI Interfacing System for Healthcare Documentation"</h3>
                        <div class="bg-ink rounded-lg p-4 font-mono text-sm mb-4">
                            <div class="text-cy mb-2">// What the product does</div>
                            <div class="text-slate-300">
                                <span class="text-cy">Core Function:</span> Listens to patient-doctor consultations<br/>
                                <span class="text-cy">AI Processing:</span> Writes up the documentation automatically<br/>
                                <span class="text-cy">NHS Integration:</span> Saves to electronic patient records<br/>
                                <span class="text-cy">Smart Features:</span> Handles referrals, tests and follow-ups<br/>
                                <span class="text-cy">Value Proposition:</span> More patient care, less paperwork
                            </div>
                        </div>
                        <p class="text-slate-300 text-sm">
                            <strong>Mission:</strong> Use AI to take admin off doctors so they can put patient care first.
                        </p>
                    </div>

                    <!-- Feature Matrix -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-microphone mr-3"></i>Smart Listening
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">Speech-to-Text AI:</strong> Voice recognition
                                </div>
                                <div>
                                    <strong class="text-white">Pattern Recognition:</strong> Understands medical terminology
                                </div>
                                <div>
                                    <strong class="text-white">Real-time Processing:</strong> Captures the consultation as it happens
                                </div>
                                <div>
                                    <strong class="text-white">Privacy Protection:</strong> Secure local processing
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-file-medical mr-3"></i>Auto Documentation
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">NHS Compliance:</strong> Reports generated in an NHS-compliant format
                                </div>
                                <div>
                                    <strong class="text-white">Patient History:</strong> Briefing profiles summarizing each patient
                                </div>
                                <div>
                                    <strong class="text-white">Test Management:</strong> Orders tests automatically
                                </div>
                                <div>
                                    <strong class="text-white">Referral System:</strong> Simpler referrals to specialists
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4 flex items-center">
                                <i class="fas fa-network-wired mr-3"></i>System Integration
                            </h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div>
                                    <strong class="text-white">NHS Systems:</strong> Works with existing infrastructure
                                </div>
                                <div>
                                    <strong class="text-white">EPR Integration:</strong> Electronic patient records
                                </div>
                                <div>
                                    <strong class="text-white">API Connectivity:</strong> Free NHS Digital APIs
                                </div>
                                <div>
                                    <strong class="text-white">Multi-Platform:</strong> Designed to run across all NHS trusts
                                </div>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Market Research & Feasibility Analysis -->
                <ProjectSection Title="Market Research & Business Intelligence" Icon="fas fa-chart-line">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Target Market Analysis</h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>Primary Market:</strong> NHS doctors and other healthcare professionals</div>
                                <div><strong>Market Size:</strong> 1.8 million healthcare workers</div>
                                <div><strong>Geographic Scope:</strong> UK public and private healthcare</div>
                                <div><strong>Revenue Model:</strong> A fee per transaction (1.6B transactions a month)</div>
                                <div>
                                    <strong>Market Segments:</strong>
                                    <ul class="mt-2 space-y-1 text-slate-400">
                                        <li>• Junior doctors, who carry the most documentation</li>
                                        <li>• Senior consultants, who want to save time</li>
                                        <li>• NHS trusts, who want to cut costs</li>
                                        <li>• Private healthcare providers</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Industry Research Sources</h3>
                            <div class="space-y-3 text-slate-300 text-sm">
                                <div><strong>IBISWorld:</strong> Analysis of the electronic patient records industry</div>
                                <div><strong>NHS Digital:</strong> Transaction volumes and system data</div>
                                <div><strong>Government Reports:</strong> Plans for the £2B digitalization investment</div>
                                <div><strong>Healthcare Studies:</strong> Research on time lost to documentation</div>
                                <div>
                                    <strong>Key Findings:</strong>
                                    <ul class="mt-2 space-y-1 text-slate-400">
                                        <li>• Integrated EPR systems hold 56% of the market</li>
                                        <li>• Documentation tools have seen little innovation</li>
                                        <li>• Digitalization is a government priority</li>
                                        <li>• The NHS urgently needs to work more efficiently</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Competitive Landscape -->
                    <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                        <h3 class="text-xl font-bold text-slate-100 mb-4">Competitive Analysis & Market Gap</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <h4 class="font-bold text-white mb-3">Current Solutions (Limited)</h4>
                                <ul class="text-slate-400 text-sm space-y-1">
                                    <li>• <strong>DAX (US):</strong> Drafts patient reports with GPT</li>
                                    <li>• <strong>Abridge (US):</strong> Not available in the UK</li>
                                    <li>• <strong>NHS Systems:</strong> Dated interfaces with little AI</li>
                                    <li>• <strong>Traditional Tools:</strong> Speech-to-text that still takes a lot of time</li>
                                </ul>
                            </div>
                            <div>
                                <h4 class="font-bold text-white mb-3">Market Opportunity</h4>
                                <ul class="text-slate-400 text-sm space-y-1">
                                    <li>• <strong>UK Market Gap:</strong> No full AI documentation tool yet</li>
                                    <li>• <strong>Integration Advantage:</strong> Built to work with NHS systems</li>
                                    <li>• <strong>Government Support:</strong> £2B digitalization fund</li>
                                    <li>• <strong>Urgent Need:</strong> The NHS is still under post-COVID pressure</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </ProjectSection>

                <!-- Blue Ocean Strategy & Competitive Analysis -->
                <ProjectSection Title="Blue Ocean Strategy Analysis" Icon="fas fa-chess">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Create (New Value)</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>NHS System Integration:</strong> Works with the infrastructure already in place</li>
                                <li><strong>Full Documentation Automation:</strong> Covers the whole documentation workflow</li>
                                <li><strong>Intelligent Referral System:</strong> Connects patients to specialists automatically</li>
                                <li><strong>Patient Briefing Packages:</strong> Summaries of each patient's history</li>
                                <li><strong>Assistive Secretarial Functions:</strong> Goes further than transcription</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Raise (Above Industry)</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>System Reliability:</strong> Iterative design and thorough testing</li>
                                <li><strong>Integration Capability:</strong> Deployment across the whole NHS</li>
                                <li><strong>AI Capability:</strong> Better pattern recognition</li>
                                <li><strong>User Simplicity:</strong> An interface that is easy to pick up</li>
                                <li><strong>Data Security:</strong> Stronger privacy protection</li>
                            </ul>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Reduce (Industry Norms)</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Training Requirements:</strong> Onboarding guided by the AI</li>
                                <li><strong>System Complexity:</strong> A simpler user experience</li>
                                <li><strong>Implementation Cost:</strong> Competitive pricing</li>
                                <li><strong>Technical Errors:</strong> Agile development practices</li>
                                <li><strong>Manual Intervention:</strong> Automated workflows</li>
                            </ul>
                        </div>

                        <div class="bg-white/[.02] rounded-lg p-6 border border-line">
                            <h3 class="text-xl font-bold text-slate-100 mb-4">Eliminate (Industry Standards)</h3>
                            <ul class="space-y-2 text-slate-300 text-sm">
                                <li><strong>Paper Documentation:</strong> A fully digital workflow</li>
                                <li><strong>Manual Transcription:</strong> Replaced by AI</li>
                                <li><strong>Outdated Interfaces:</strong> A modern UI/UX</li>
                                <li><strong>System Fragmentation:</strong> One platform instead of several</li>
                                <li><strong>Time-Consuming Processes:</strong> Fewer manual steps</li>
                            </ul>
                        </div>
                    </div>
                </ProjectSection>

