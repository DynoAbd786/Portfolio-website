# Development container: runs the site (pages + API) in watch mode
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

COPY website/*.csproj ./website/
COPY website.api/*.csproj ./website.api/
RUN dotnet restore ./website.api/website.api.csproj

COPY website/ ./website/
COPY website.api/ ./website.api/

EXPOSE 7232

WORKDIR /src/website.api
ENTRYPOINT ["dotnet", "watch", "run", "--no-launch-profile", "--urls", "http://+:7232"]
