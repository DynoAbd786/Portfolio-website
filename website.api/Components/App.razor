@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- SEO Meta Tags -->
    <meta name="description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />
    <meta name="keywords"
        content="Muhammad Kashif Khan, Portfolio, Software Engineer, AI Engineer, Computer Science, University of Leeds, Machine Learning, Computer Vision, Cloud, Blazor, ASP.NET Core" />
    <meta name="author" content="Muhammad Kashif Khan" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Muhammad Kashif Khan - Portfolio" />
    <meta property="og:description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mkkai.dev" />
    <meta property="og:site_name" content="Muhammad Kashif Khan Portfolio" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Muhammad Kashif Khan - Portfolio" />
    <meta name="twitter:description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />

    <!-- Canonical URL -->
    <link rel="canonical" href="@CanonicalUrl" />
    <base href="/" />
    @* Lets .reveal sections start hidden and fade in (site.js); without JS they just show *@
    <script>if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-ready');</script>
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />
    <!-- Font Awesome for social icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- KaTeX for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>

    <!-- highlight.js for syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&family=Roboto+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    @* Last stylesheet, as the old CDN script injected it: utilities win over app.css,
       Font Awesome, KaTeX and highlight.js rules *@
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <ResourcePreloader />
    <HeadOutlet />
</head>

<body>
    <Routes />

    @* Blazor shows this when an interactive component throws *@
    <div id="blazor-error-ui"
        style="background: rgba(0,0,0,0.9); color: white; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10000; padding: 2rem; display: none; font-family: monospace;">
        <div
            style="max-width: 800px; margin: 0 auto; background: #1a1a1a; border: 2px solid #ef4444; border-radius: 8px; padding: 2rem;">
            <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                <span style="color: #ef4444; font-size: 2rem; margin-right: 1rem;">⚠️</span>
                <h2 style="color: #ef4444; margin: 0;">Something went wrong</h2>
            </div>
            <p style="color: #ccc;">An error occurred. Reloading the page usually fixes it.</p>
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <a href="" class="reload"
                    style="background: #ef4444; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; font-weight: bold;">🔄
                    Reload</a>
                <a class="dismiss"
                    style="background: #333; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; cursor: pointer;">🗙
                    Dismiss</a>
            </div>
        </div>
    </div>

    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Each page is its own canonical URL; the query string never is
    private string CanonicalUrl => "https://mkkai.dev" + new Uri(Navigation.Uri).AbsolutePath;
}
