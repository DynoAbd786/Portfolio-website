@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- SEO Meta Tags -->
    <meta name="description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />
    <meta name="keywords"
        content="Muhammad Kashif Khan, Portfolio, Software Engineer, AI Engineer, Computer Science, University of Leeds, Machine Learning, Computer Vision, Cloud, Blazor, ASP.NET Core" />
    <meta name="author" content="Muhammad Kashif Khan" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Muhammad Kashif Khan - Portfolio" />
    <meta property="og:description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mkkai.dev" />
    <meta property="og:site_name" content="Muhammad Kashif Khan Portfolio" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Muhammad Kashif Khan - Portfolio" />
    <meta name="twitter:description"
        content="Software engineer and First-Class MEng CS &amp; AI graduate (University of Leeds) building developer tools, AI systems and scientific software." />

    <!-- Canonical URL -->
    <link rel="canonical" href="@CanonicalUrl" />
    <base href="/" />
    @* Lets .reveal sections start hidden and fade in (site.js); without JS they just show *@
    <script>if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-ready');</script>
    @* The homepage's intro (js/intro): .intro-pending hides the hero until the name build lands. It plays
       on a full load of / that is the tab's first or a reload, with no #hash and no reduced motion; a
       reload of / starts at the top (even with a #hash) so the intro plays from there. Other pages keep
       the browser's usual reload behaviour. Tests skip it with ?debug= or sessionStorage mk-intro-off. *@
    <script>
        (function () {
            var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            var reload = !!nav && nav.type === 'reload' && location.pathname === '/';
            if (reload) {
                history.scrollRestoration = 'manual';
                if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
                document.addEventListener('DOMContentLoaded', function () { scrollTo(0, 0); });
                addEventListener('load', function () { scrollTo(0, 0); });
                // the browser restores a reload's scroll after load, so stay manual until the visitor does something
                var auto = function () { history.scrollRestoration = 'auto'; ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (t) { removeEventListener(t, auto, true); }); };
                ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (t) { addEventListener(t, auto, true); });
            }
            try {
                if (location.pathname === '/' && !location.hash && !new URLSearchParams(location.search).get('debug')
                    && !matchMedia('(prefers-reduced-motion: reduce)').matches && sessionStorage.getItem('mk-intro-off') !== '1'
                    && (reload || sessionStorage.getItem('mk-intro-seen') !== '1')) {
                    sessionStorage.setItem('mk-intro-seen', '1');
                    var html = document.documentElement;
                    html.classList.add('intro-pending');
                    // the last resort, if the intro's scripts never arrive: 14.5 s after the page is
                    // first visible (js/intro gives up at 10 s, plus a build already playing), show it
                    var watch = function () {
                        setTimeout(function () {
                            if (!html.classList.contains('intro-pending')) return;
                            if (window.mkIntro) mkIntro.finish();
                            html.classList.remove('intro-pending', 'intro-flying', 'intro-settling');
                        }, 14500);
                    };
                    if (!document.hidden) watch();
                    else document.addEventListener('visibilitychange', function show() { if (!document.hidden) { document.removeEventListener('visibilitychange', show); watch(); } });
                }
            } catch (e) { }
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap ImportMapDefinition="ImportMapWithThree" />
    <!-- Font Awesome for social icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- KaTeX for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>

    <!-- highlight.js for syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&family=Roboto+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    @* Last stylesheet, as the old CDN script injected it: utilities win over app.css,
       Font Awesome, KaTeX and highlight.js rules *@
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    @* Umami, cookieless analytics: on the live site only (never local runs or tests), and not in the
       chat panel's frame, which would count as a second page view. It follows enhanced navigation
       itself (it wraps pushState); in-page glides (#work) aren't page views. Events: mkTrack in site.js *@
    @if (UmamiWebsiteId is { } umami)
    {
        <script defer src="https://cloud.umami.is/script.js" data-website-id="@umami" data-domains="mkkai.dev,www.mkkai.dev" data-exclude-hash="true"></script>
    }
    <ResourcePreloader />
    <HeadOutlet />
</head>

<body>
    <Routes />

    @* Blazor shows this when an interactive component throws *@
    <div id="blazor-error-ui"
        style="background: rgba(0,0,0,0.9); color: white; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10000; padding: 2rem; display: none; font-family: monospace;">
        <div
            style="max-width: 800px; margin: 0 auto; background: #1a1a1a; border: 2px solid #ef4444; border-radius: 8px; padding: 2rem;">
            <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                <span style="color: #ef4444; font-size: 2rem; margin-right: 1rem;">⚠️</span>
                <h2 style="color: #ef4444; margin: 0;">Something went wrong</h2>
            </div>
            <p style="color: #ccc;">An error occurred. Reloading the page usually fixes it.</p>
            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <a href="" class="reload"
                    style="background: #ef4444; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; font-weight: bold;">🔄
                    Reload</a>
                <a class="dismiss"
                    style="background: #333; color: white; padding: 0.5rem 1rem; border-radius: 4px; text-decoration: none; cursor: pointer;">🗙
                    Dismiss</a>
            </div>
        </div>
    </div>

    <script src="@Assets["js/site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? UmamiWebsiteId =>
        Environment.EnvironmentName == "Production" && new Uri(Navigation.Uri).AbsolutePath != "/chat-panel"
        && Configuration["Umami:WebsiteId"] is { Length: > 0 } id ? id : null;

    // Each page is its own canonical URL; the query string never is
    private string CanonicalUrl => "https://mkkai.dev" + new Uri(Navigation.Uri).AbsolutePath;

    // Blazor's import map (fingerprinted JS, including js/workshop) plus bare specifiers for three.js,
    // which only the homepage's workshop scene imports
    private ImportMapDefinition ImportMapWithThree
    {
        get
        {
            var three = new ImportMapDefinition(
                new Dictionary<string, string>
                {
                    ["three"] = "/" + Assets["lib/three/0.160.0/three.module.min.js"],
                    ["three/addons/"] = "/lib/three/0.160.0/addons/",
                },
                null, null);
            var endpointMap = HttpContext.GetEndpoint()?.Metadata.GetMetadata<ImportMapDefinition>();
            return endpointMap is null ? three : ImportMapDefinition.Combine(endpointMap, three);
        }
    }
}
